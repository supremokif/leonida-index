---
// Rockstar Games Official 4 Pillars & Store Components
import { resolvePath } from '../utils/paths';
---

<!-- 1. The Official Story Quote -->
<section class="my-20 px-4 sm:px-6 max-w-5xl mx-auto text-center" aria-label="Sinossi Ufficiale">
  <div data-i18n="pillars.story_tag" class="text-[11px] font-mono font-bold tracking-[0.3em] text-[#fdb813] uppercase mb-4">
    VICE CITY, USA
  </div>
  <blockquote data-i18n="pillars.story_quote" class="text-xl sm:text-3xl md:text-4xl font-black text-white uppercase leading-snug tracking-tight font-sans">
    "Jason e Lucia sanno bene che il banco vince sempre. Ma quando un colpo da poco va a rotoli, si ritrovano invischiati nel lato più buio del posto più soleggiato d'America, al centro di una cospirazione criminale che abbraccia l'intero Stato di Leonida — costretti a fidarsi l'uno dell'altra più che mai se vogliono uscirne vivi."
  </blockquote>
  <div data-i18n="pillars.story_author" class="mt-6 text-xs font-mono text-gray-500 uppercase tracking-widest">
    — Panoramica Ufficiale della Trama di Rockstar Games
  </div>
</section>

<!-- 2. Official Editions & Pre-Order Bonuses -->
<section id="pre-order" class="my-20 px-4 sm:px-6 max-w-7xl mx-auto scroll-mt-24" aria-label="Edizioni e Pre-Order">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-white/10">
    <div>
      <div data-i18n="pillars.editions_tag" class="text-[11px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-1.5">
        EDIZIONI UFFICIALI
      </div>
      <h2 data-i18n="pillars.editions_title" class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight">
        PRE-ORDINA ORA
      </h2>
    </div>
    <div data-i18n="pillars.available_platforms" class="text-xs font-mono text-gray-400">
      DISPONIBILE SU PLAYSTATION® 5 E XBOX SERIES X|S
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Ultimate Edition Card -->
    <div class="taste-card group flex flex-col justify-between overflow-hidden">
      <div class="taste-frame relative w-full aspect-[16/9] bg-black rounded-t-3xl">
        <img
          src={resolvePath('/images/gtavi-ultimate-edition.jpg')}
          alt="Grand Theft Auto VI Ultimate Edition"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent pointer-events-none"></div>
        <div class="absolute top-4 left-4 px-3 py-1 rounded bg-[#fdb813] text-black font-black text-[10px] font-mono uppercase tracking-widest">
          ULTIMATE EDITION
        </div>
      </div>

      <div class="p-8 flex-1 flex flex-col justify-between">
        <div>
          <span data-i18n="pillars.ultimate_tag" class="text-[10px] font-mono text-gray-400 tracking-widest uppercase block mb-1">
            COLLEZIONE DIGITALE ESCLUSIVA
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-white uppercase mb-3">
            ULTIMATE EDITION
          </h3>
          <p data-i18n="pillars.ultimate_desc" class="text-sm text-gray-300 leading-relaxed font-normal mb-6">
            Una collezione esclusiva di oggetti ed elementi intrecciati in ogni aspetto della storia di Jason e Lucia. Include la Grotti Cheetah, la Electric Fang, i revolver Hawk &amp; Little Morgan e One-Eyed Willie.
          </p>
        </div>

        <div class="pt-6 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs font-mono text-white">PlayStation 5 • Xbox Series X|S</span>
          <a
            href="https://www.rockstargames.com/VI"
            target="_blank"
            rel="noopener noreferrer"
            data-i18n="pillars.learn_more"
            class="taste-btn px-6 py-3 rounded-xl bg-white hover:bg-[#fdb813] text-black text-xs font-mono font-black uppercase tracking-wider"
          >
            SCOPRI DI PIÙ ➔
          </a>
        </div>
      </div>
    </div>

    <!-- Standard Edition & Vintage Vice City Pack -->
    <div class="flex flex-col gap-8">
      <!-- Standard Edition Card -->
      <div class="taste-card group flex flex-col sm:flex-row overflow-hidden">
        <div class="taste-frame sm:w-2/5 relative aspect-square sm:aspect-auto bg-black rounded-t-3xl sm:rounded-tr-none sm:rounded-l-3xl">
          <img
            src={resolvePath('/images/gtavi-standard-edition.jpg')}
            alt="Grand Theft Auto VI Standard Edition"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="sm:w-3/5 p-6 flex flex-col justify-between">
          <div>
            <span data-i18n="pillars.standard_tag" class="text-[10px] font-mono text-gray-400 tracking-widest uppercase block mb-1">
              GIOCO BASE
            </span>
            <h3 class="text-xl font-black text-white uppercase mb-2">STANDARD EDITION</h3>
            <p data-i18n="pillars.standard_desc" class="text-xs text-gray-300 leading-relaxed font-normal mb-4">
              L'esperienza completa di Grand Theft Auto VI attraverso le strade di Vice City e le terre selvagge dello Stato di Leonida.
            </p>
          </div>
          <div class="pt-4 border-t border-white/10 flex items-center justify-between">
            <span class="text-xs font-mono text-gray-400">PlayStation 5 • Xbox Series X|S</span>
            <a
              href="https://www.rockstargames.com/VI"
              target="_blank"
              rel="noopener noreferrer"
              data-i18n="pillars.preorder_btn"
              class="taste-btn px-4 py-2 rounded-xl bg-white/10 hover:bg-white text-white hover:text-black text-xs font-mono font-bold uppercase"
            >
              PRE-ORDINA ➔
            </a>
          </div>
        </div>
      </div>

      <!-- Vintage Vice City Pack Card -->
      <div class="taste-card p-6 sm:p-8 bg-gradient-to-r from-[#18102e] to-[#0a0714] border border-vice-pink/40 shadow-neon-pink flex flex-col justify-between">
        <div>
          <div data-i18n="pillars.vintage_tag" class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-vice-pink/20 border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
            BONUS PRE-ORDINE
          </div>
          <h3 data-i18n="pillars.vintage_title" class="text-xl sm:text-2xl font-black text-white uppercase mb-2">
            PACCHETTO VINTAGE VICE CITY
          </h3>
          <p data-i18n="pillars.vintage_desc" class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal mb-4">
            Pre-ordina subito per ricevere vantaggi unici che riportano ai tempi in cui le luci al neon ardevano più luminose in tutta la città.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
          <span data-i18n="pillars.vintage_sub" class="text-gray-400">Incluso in tutti i pre-ordini digitali</span>
          <span data-i18n="pillars.bonus_unlocked" class="text-vice-pink font-bold">BONUS SBLOCCATO</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 3. The 4 Core Pillars -->
<section class="my-20 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Pilastri Fondamentali">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Pillar 1: SCREENSHOTS -->
    <a
      href="#gallery"
      class="taste-card group p-8 flex flex-col justify-between"
    >
      <div>
        <div data-i18n="pillars.screenshots_tag" class="text-[10px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-3">
          SCREENSHOT UFFICIALI
        </div>
        <h3 data-i18n="pillars.screenshots_title" class="text-xl font-black text-white group-hover:text-[#fdb813] transition-colors uppercase mb-3">
          GALLERIA DI LANCIO 4K
        </h3>
        <p data-i18n="pillars.screenshots_desc" class="text-xs text-gray-300 leading-relaxed font-normal">
          Ammira Leonida in ogni dettaglio con la raccolta esclusiva di nuove catture in risoluzione Ultra HD 4K.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span data-i18n="pillars.view_all">VEDI TUTTI</span>
        <span class="group-hover:translate-x-1 transition-transform text-white font-bold">➔</span>
      </div>
    </a>

    <!-- Pillar 2: PEOPLE & PLACES -->
    <a
      href="#leonida"
      class="taste-card group p-8 flex flex-col justify-between"
    >
      <div>
        <div data-i18n="pillars.people_tag" class="text-[10px] font-mono font-bold tracking-[0.25em] text-vice-cyan uppercase mb-3">
          PERSONAGGI E LUOGHI
        </div>
        <h3 data-i18n="pillars.people_title" class="text-xl font-black text-white group-hover:text-vice-cyan transition-colors uppercase mb-3">
          SOLO A LEONIDA
        </h3>
        <p data-i18n="pillars.people_desc" class="text-xs text-gray-300 leading-relaxed font-normal">
          Vice City, USA. Il lato più oscuro e corrotto del luogo più assolato d'America.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span data-i18n="pillars.explore_more">ESPLORA DI PIÙ</span>
        <span class="group-hover:translate-x-1 transition-transform text-white font-bold">➔</span>
      </div>
    </a>

    <!-- Pillar 3: MUSIC -->
    <div
      class="taste-card group p-8 flex flex-col justify-between"
    >
      <div>
        <div data-i18n="pillars.music_tag" class="text-[10px] font-mono font-bold tracking-[0.25em] text-vice-pink uppercase mb-3">
          COLONNA SONORA E RADIO
        </div>
        <h3 data-i18n="pillars.music_title" class="text-xl font-black text-white group-hover:text-vice-pink transition-colors uppercase mb-3">
          RADIO DI GIOCO, COLONNA SONORA E BRANI ORIGINALI
        </h3>
        <p data-i18n="pillars.music_desc" class="text-xs text-gray-300 leading-relaxed font-normal">
          Ascolta la colonna sonora e i brani ufficiali, oltre a una selezione di stazioni radio in-game.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span data-i18n="pillars.explore_more">ESPLORA DI PIÙ</span>
        <span class="text-white font-bold">🎵</span>
      </div>
    </div>

    <!-- Pillar 4: DOWNLOADS -->
    <a
      href="#downloads"
      class="taste-card group p-8 flex flex-col justify-between"
    >
      <div>
        <div data-i18n="pillars.downloads_tag" class="text-[10px] font-mono font-bold tracking-[0.25em] text-emerald-400 uppercase mb-3">
          DOWNLOAD E MEDIA
        </div>
        <h3 data-i18n="pillars.downloads_title" class="text-xl font-black text-white group-hover:text-emerald-400 transition-colors uppercase mb-3">
          MEDIA &amp; ARTWORK IN ALTA DEFINIZIONE
        </h3>
        <p data-i18n="pillars.downloads_desc" class="text-xs text-gray-300 leading-relaxed font-normal">
          Scarica e condividi video ufficiali, wallpaper e screenshot in altissima definizione.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span data-i18n="pillars.see_all">VEDI TUTTO</span>
        <span class="group-hover:translate-x-1 transition-transform text-white font-bold">➔</span>
      </div>
    </a>

  </div>
</section>

<!-- 4. Merchandise & Collector's Box -->
<section class="my-20 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Negozio e Merchandise">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-white/10">
    <div>
      <div data-i18n="store.tag" class="text-[11px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-1.5">
        MAGAZZINO ROCKSTAR
      </div>
      <h2 data-i18n="store.title" class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        SHOP &amp; MERCHANDISE
      </h2>
    </div>
    <a
      href="https://store.rockstargames.com"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n="store.view_all"
      class="text-xs font-mono text-gray-400 hover:text-white transition-colors"
    >
      SCOPRI TUTTI I PRODOTTI ➔
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Merchandise Card -->
    <div class="taste-card group flex flex-col overflow-hidden">
      <div class="taste-frame relative w-full aspect-[16/9] bg-black rounded-t-3xl">
        <img
          src={resolvePath('/images/gtavi-merch.jpg')}
          alt="Merchandise Ufficiale Rockstar Games"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent pointer-events-none"></div>
      </div>
      <div class="p-6 flex-1 flex flex-col justify-between">
        <div>
          <span data-i18n="store.merch_tag" class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block mb-1">ABBIGLIAMENTO E ACCESSORI</span>
          <h3 data-i18n="store.merch_title" class="text-xl font-black text-white uppercase mb-2">MERCHANDISE UFFICIALE</h3>
          <p data-i18n="store.merch_desc" class="text-xs text-gray-300 leading-relaxed font-normal">
            Capi di abbigliamento premium, oggetti da collezione, spille e accessori ispirati allo stile senza tempo di Vice City.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
          <span data-i18n="store.rockstar_official" class="text-gray-400">Store Ufficiale Rockstar</span>
          <span data-i18n="store.shop_now" class="text-[#fdb813] font-bold group-hover:translate-x-1 transition-transform">ACQUISTA ORA ➔</span>
        </div>
      </div>
    </div>

    <!-- Collector's Box Card -->
    <div class="taste-card group flex flex-col overflow-hidden">
      <div class="taste-frame relative w-full aspect-[16/9] bg-black rounded-t-3xl">
        <img
          src={resolvePath('/images/grotti-cheetah.jpg')}
          alt="Cofanetto da Collezione Vice City"
          class="w-full h-full object-cover"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent pointer-events-none"></div>
      </div>
      <div class="p-6 flex-1 flex flex-col justify-between">
        <div>
          <span data-i18n="store.box_tag" class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block mb-1">EDIZIONE LIMITATA</span>
          <h3 data-i18n="store.box_title" class="text-xl font-black text-white uppercase mb-2">COFANETTO DA COLLEZIONE</h3>
          <p data-i18n="store.box_desc" class="text-xs text-gray-300 leading-relaxed font-normal">
            The Vice City Collection — Un cofanetto esclusivo di cimeli e oggetti fisici curati per il lancio mondiale.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
          <span data-i18n="store.exclusive_run" class="text-gray-400">Tiratura Esclusiva</span>
          <span data-i18n="store.explore_now" class="text-[#fdb813] font-bold group-hover:translate-x-1 transition-transform">ESPLORA ORA ➔</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 5. Featured News / Rockstar Newswire -->
<section class="my-20 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Comunicati Newswire">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-white/10">
    <div>
      <div data-i18n="news.tag" class="text-[11px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-1.5">
        ULTIMI AGGIORNAMENTI
      </div>
      <h2 data-i18n="news.title" class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        ROCKSTAR NEWSWIRE
      </h2>
    </div>
    <a
      href="https://www.rockstargames.com/newswire"
      target="_blank"
      rel="noopener noreferrer"
      data-i18n="news.view_all"
      class="text-xs font-mono text-gray-400 hover:text-white transition-colors"
    >
      TUTTI GLI ARTICOLI NEWSWIRE ➔
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- News 1 -->
    <div class="taste-card p-6 flex flex-col justify-between">
      <div>
        <span class="text-[10px] font-mono text-[#fdb813] uppercase tracking-wider block mb-2">
          10 NOVEMBRE 2026
        </span>
        <h3 data-i18n="news.item1_title" class="text-lg font-black text-white uppercase mb-2">
          Il Pre-Load di Grand Theft Auto VI è Disponibile
        </h3>
        <p data-i18n="news.item1_desc" class="text-xs text-gray-400 leading-relaxed font-normal">
          Il pre-download digitale è ora attivo su PlayStation 5 e Xbox Series X|S in vista del lancio mondiale del 19 Novembre.
        </p>
      </div>
      <div data-i18n="news.category" class="mt-6 pt-4 border-t border-white/10 text-xs font-mono text-gray-500">
        Comunicato Newswire
      </div>
    </div>

    <!-- News 2 -->
    <div class="taste-card p-6 flex flex-col justify-between">
      <div>
        <span class="text-[10px] font-mono text-[#fdb813] uppercase tracking-wider block mb-2">
          5 NOVEMBRE 2026
        </span>
        <h3 data-i18n="news.item2_title" class="text-lg font-black text-white uppercase mb-2">
          Esplora la Galleria Fotografica di Lancio
        </h3>
        <p data-i18n="news.item2_desc" class="text-xs text-gray-400 leading-relaxed font-normal">
          Scopri i nuovi scatti 4K che mostrano la vibrante vita notturna di Vice City, le paludi di Grassrivers e le autostrade costiere.
        </p>
      </div>
      <div data-i18n="news.category" class="mt-6 pt-4 border-t border-white/10 text-xs font-mono text-gray-500">
        Comunicato Newswire
      </div>
    </div>

    <!-- News 3 -->
    <div class="taste-card p-6 flex flex-col justify-between">
      <div>
        <span class="text-[10px] font-mono text-[#fdb813] uppercase tracking-wider block mb-2">
          3 NOVEMBRE 2026
        </span>
        <h3 data-i18n="news.item3_title" class="text-lg font-black text-white uppercase mb-2">
          Orari di Sblocco a Mezzanotte nel Mondo
        </h3>
        <p data-i18n="news.item3_desc" class="text-xs text-gray-400 leading-relaxed font-normal">
          Dettagli ufficiali sugli orari di sblocco a scaglioni a mezzanotte locale per tutti i territori del pianeta.
        </p>
      </div>
      <div data-i18n="news.category" class="mt-6 pt-4 border-t border-white/10 text-xs font-mono text-gray-500">
        Comunicato Newswire
      </div>
    </div>
  </div>
</section>

<!-- 6. Propaganda Newsletter Signup -->
<section class="my-20 px-4 sm:px-6 max-w-4xl mx-auto" aria-label="Iscrizione Newsletter">
  <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-[#140f26] to-[#07050d] border border-white/15 text-center">
    <div class="w-10 h-10 rounded-xl bg-[#fdb813] flex items-center justify-center text-black font-black text-sm font-mono mx-auto mb-4 shadow-[0_0_15px_rgba(253,184,19,0.5)]">
      R★
    </div>
    <h3 data-i18n="propaganda.title" class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight mb-2">
      RICEVI LA PROPAGANDA ROCKSTAR
    </h3>
    <p data-i18n="propaganda.desc" class="text-xs sm:text-sm text-gray-300 max-w-md mx-auto mb-6 leading-relaxed font-normal">
      Ricevi gli annunci di gioco più recenti, aggiornamenti su eventi speciali, promozioni e molto altro da Rockstar Games.
    </p>

    <form id="propaganda-form" class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
      <input
        type="email"
        placeholder="Inserisci il tuo indirizzo email"
        data-i18n-placeholder="propaganda.placeholder"
        required
        class="w-full px-5 py-3.5 rounded-xl bg-black/80 border border-white/20 text-white text-xs font-mono focus:outline-none focus:border-[#fdb813] transition-colors"
      />
      <button
        type="submit"
        data-i18n="propaganda.signup"
        class="w-full sm:w-auto px-8 py-3.5 rounded-xl bg-[#fdb813] hover:bg-white text-black font-black text-xs font-mono tracking-widest uppercase transition-all duration-300 shadow-lg cursor-pointer whitespace-nowrap"
      >
        ISCRIVITI ORA
      </button>
    </form>
    <p data-i18n="propaganda.privacy_notice" class="text-[10px] text-gray-500 font-mono mt-3">
      Iscrivendoti, accetti di ricevere comunicazioni promozionali da Rockstar Games.
    </p>
  </div>
</section>

<!-- 7. Mature Content Warning -->
<div class="max-w-4xl mx-auto my-12 p-6 rounded-2xl bg-black/50 border border-white/10 flex flex-col sm:flex-row items-center gap-4 text-center sm:text-left">
  <div class="w-12 h-14 rounded-lg bg-red-600 border border-white text-white flex flex-col items-center justify-center p-1 shadow-lg shrink-0 select-none">
    <span class="text-xl font-black leading-none font-mono">18</span>
    <span class="text-[8px] font-bold tracking-tighter uppercase mt-0.5">PEGI</span>
  </div>
  <div>
    <div data-i18n="pegi.tag" class="text-xs font-mono font-bold text-white uppercase tracking-wider mb-1">
      RATING IN ATTESA DI CONFERMA (18+)
    </div>
    <p data-i18n="pegi.desc" class="text-xs text-gray-400">
      Violenza estrema, linguaggio forte, contenuti per soli adulti.
    </p>
  </div>
</div>
