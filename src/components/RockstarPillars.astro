---
// Rockstar Games Official 4 Pillars & Store Components
---

<!-- 1. The Official Story Quote -->
<section class="my-20 px-4 sm:px-6 max-w-5xl mx-auto text-center" aria-label="Official Synopsis">
  <div class="text-[11px] font-mono font-bold tracking-[0.3em] text-[#fdb813] uppercase mb-4">
    VICE CITY, USA
  </div>
  <blockquote class="text-xl sm:text-3xl md:text-4xl font-black text-white uppercase leading-snug tracking-tight font-sans">
    "Jason and Lucia have always known the deck is stacked against them. But when an easy score goes wrong, they find themselves on the darkest side of the sunniest place in America, in the middle of a criminal conspiracy stretching across the state of Leonida — forced to rely on each other more than ever if they want to make it out alive."
  </blockquote>
  <div class="mt-6 text-xs font-mono text-gray-500 uppercase tracking-widest">
    — Rockstar Games Official Story Overview
  </div>
</section>

<!-- 2. Official Editions & Pre-Order Bonuses (Direct from rockstargames.com/VI) -->
<section id="pre-order" class="my-20 px-4 sm:px-6 max-w-7xl mx-auto scroll-mt-24" aria-label="Edizioni e Pre-Order">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10 pb-4 border-b border-white/10">
    <div>
      <div class="text-[11px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-1.5">
        OFFICIAL EDITIONS
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white uppercase tracking-tight">
        PRE-ORDER NOW
      </h2>
    </div>
    <div class="text-xs font-mono text-gray-400">
      AVAILABLE ON PLAYSTATION® 5 AND XBOX SERIES X|S
    </div>
  </div>

  <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 mb-8">
    <!-- Ultimate Edition Card -->
    <div class="group rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/15 hover:border-[#fdb813] shadow-2xl transition-all duration-300 flex flex-col justify-between">
      <div class="relative w-full aspect-[16/9] overflow-hidden bg-black">
        <img
          src="/images/gtavi-ultimate-edition.jpg"
          alt="Grand Theft Auto VI Ultimate Edition"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent"></div>
        <div class="absolute top-4 left-4 px-3 py-1 rounded bg-[#fdb813] text-black font-black text-[10px] font-mono uppercase tracking-widest">
          ULTIMATE EDITION
        </div>
      </div>

      <div class="p-8 flex-1 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-mono text-gray-400 tracking-widest uppercase block mb-1">
            EXCLUSIVE DIGITAL COLLECTION
          </span>
          <h3 class="text-2xl sm:text-3xl font-black text-white uppercase mb-3">
            ULTIMATE EDITION
          </h3>
          <p class="text-sm text-gray-300 leading-relaxed font-normal mb-6">
            An exclusive collection of items threaded across all aspects of Jason and Lucia’s story. Includes the Grotti Cheetah, Electric Fang, Hawk &amp; Little Morgan Revolvers, and One-Eyed Willie.
          </p>
        </div>

        <div class="pt-6 border-t border-white/10 flex items-center justify-between">
          <span class="text-xs font-mono text-white">PlayStation 5 • Xbox Series X|S</span>
          <a
            href="https://www.rockstargames.com/VI"
            target="_blank"
            rel="noopener noreferrer"
            class="px-6 py-3 rounded-xl bg-white hover:bg-[#fdb813] text-black text-xs font-mono font-black uppercase tracking-wider transition-all"
          >
            LEARN MORE ➔
          </a>
        </div>
      </div>
    </div>

    <!-- Standard Edition & Vintage Vice City Pack -->
    <div class="flex flex-col gap-8">
      <!-- Standard Edition Card -->
      <div class="group rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/15 hover:border-white/40 shadow-2xl transition-all duration-300 flex flex-col sm:flex-row">
        <div class="sm:w-2/5 relative aspect-square sm:aspect-auto overflow-hidden bg-black">
          <img
            src="/images/gtavi-standard-edition.jpg"
            alt="Grand Theft Auto VI Standard Edition"
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
          />
        </div>
        <div class="sm:w-3/5 p-6 flex flex-col justify-between">
          <div>
            <span class="text-[10px] font-mono text-gray-400 tracking-widest uppercase block mb-1">
              BASE GAME
            </span>
            <h3 class="text-xl font-black text-white uppercase mb-2">STANDARD EDITION</h3>
            <p class="text-xs text-gray-300 leading-relaxed font-normal mb-4">
              The complete Grand Theft Auto VI experience across Vice City and the state of Leonida.
            </p>
          </div>
          <div class="pt-4 border-t border-white/10 flex items-center justify-between">
            <span class="text-xs font-mono text-gray-400">Current-Gen Consoles</span>
            <a
              href="https://www.rockstargames.com/VI"
              target="_blank"
              rel="noopener noreferrer"
              class="px-4 py-2 rounded-xl bg-white/10 hover:bg-white text-white hover:text-black text-xs font-mono font-bold uppercase transition-all"
            >
              PRE-ORDER ➔
            </a>
          </div>
        </div>
      </div>

      <!-- Vintage Vice City Pack Card -->
      <div class="rounded-3xl p-6 sm:p-8 bg-gradient-to-r from-[#18102e] to-[#0a0714] border border-vice-pink/40 shadow-neon-pink flex flex-col justify-between">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-vice-pink/20 border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
            PRE-ORDER BONUSES
          </div>
          <h3 class="text-xl sm:text-2xl font-black text-white uppercase mb-2">
            VINTAGE VICE CITY PACK
          </h3>
          <p class="text-xs sm:text-sm text-gray-300 leading-relaxed font-normal mb-4">
            Pre-order to get unique benefits that flash back to when the neon burned brightest across the city.
          </p>
        </div>
        <div class="pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
          <span class="text-gray-400">Included with all digital pre-orders</span>
          <span class="text-vice-pink font-bold">BONUS UNLOCKED</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 3. The 4 Official Rockstar Core Pillars (Pillars directly from rockstargames.com/VI) -->
<section class="my-20 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Official Pillars">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    
    <!-- Pillar 1: SCREENSHOTS -->
    <a
      href="#gallery"
      class="group p-8 rounded-3xl bg-[#0d0a1a] border border-white/15 hover:border-[#fdb813] transition-all duration-300 flex flex-col justify-between shadow-xl"
    >
      <div>
        <div class="text-[10px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-3">
          SCREENSHOTS
        </div>
        <h3 class="text-xl font-black text-white group-hover:text-[#fdb813] transition-colors uppercase mb-3">
          THE LAUNCH GALLERY
        </h3>
        <p class="text-xs text-gray-300 leading-relaxed font-normal">
          Get a stunning look inside Leonida with a collection of new 4K screenshots.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span>VIEW ALL</span>
        <span class="group-hover:translate-x-1 transition-transform text-white font-bold">➔</span>
      </div>
    </a>

    <!-- Pillar 2: PEOPLE & PLACES -->
    <a
      href="#leonida"
      class="group p-8 rounded-3xl bg-[#0d0a1a] border border-white/15 hover:border-vice-cyan transition-all duration-300 flex flex-col justify-between shadow-xl"
    >
      <div>
        <div class="text-[10px] font-mono font-bold tracking-[0.25em] text-vice-cyan uppercase mb-3">
          PEOPLE &amp; PLACES
        </div>
        <h3 class="text-xl font-black text-white group-hover:text-vice-cyan transition-colors uppercase mb-3">
          ONLY IN LEONIDA
        </h3>
        <p class="text-xs text-gray-300 leading-relaxed font-normal">
          Vice City, USA. The darkest side of the sunniest place in America.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span>EXPLORE MORE</span>
        <span class="group-hover:translate-x-1 transition-transform text-white font-bold">➔</span>
      </div>
    </a>

    <!-- Pillar 3: MUSIC -->
    <div
      class="group p-8 rounded-3xl bg-[#0d0a1a] border border-white/15 hover:border-vice-pink transition-all duration-300 flex flex-col justify-between shadow-xl"
    >
      <div>
        <div class="text-[10px] font-mono font-bold tracking-[0.25em] text-vice-pink uppercase mb-3">
          MUSIC
        </div>
        <h3 class="text-xl font-black text-white group-hover:text-vice-pink transition-colors uppercase mb-3">
          IN-GAME RADIO, SOUNDTRACK &amp; SCORE
        </h3>
        <p class="text-xs text-gray-300 leading-relaxed font-normal">
          Listen to the Official Score and Soundtrack, plus select in-game radio stations.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span>EXPLORE MORE</span>
        <span class="text-white font-bold">🎵</span>
      </div>
    </div>

    <!-- Pillar 4: DOWNLOADS -->
    <a
      href="#downloads"
      class="group p-8 rounded-3xl bg-[#0d0a1a] border border-white/15 hover:border-emerald-400 transition-all duration-300 flex flex-col justify-between shadow-xl"
    >
      <div>
        <div class="text-[10px] font-mono font-bold tracking-[0.25em] text-emerald-400 uppercase mb-3">
          DOWNLOADS
        </div>
        <h3 class="text-xl font-black text-white group-hover:text-emerald-400 transition-colors uppercase mb-3">
          MEDIA &amp; ARTWORK
        </h3>
        <p class="text-xs text-gray-300 leading-relaxed font-normal">
          Download and share official videos, screenshots, and wallpapers in ultra high-definition.
        </p>
      </div>
      <div class="mt-8 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono text-gray-400">
        <span>SEE ALL</span>
        <span class="group-hover:translate-x-1 transition-transform text-white font-bold">➔</span>
      </div>
    </a>

  </div>
</section>

<!-- 4. Official Rockstar Merchandise & Collector's Box -->
<section class="my-20 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Official Store">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-white/10">
    <div>
      <div class="text-[11px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-1.5">
        ROCKSTAR WAREHOUSE
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        SHOP &amp; MERCHANDISE
      </h2>
    </div>
    <a
      href="https://store.rockstargames.com"
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-mono text-gray-400 hover:text-white transition-colors"
    >
      VIEW ALL STORE ITEMS ➔
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    <!-- Merchandise Card -->
    <div class="group rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/15 hover:border-white transition-all duration-300 flex flex-col">
      <div class="relative w-full aspect-[16/9] overflow-hidden bg-black">
        <img
          src="/images/gtavi-merch.jpg"
          alt="Rockstar Games Official Merchandise"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent"></div>
      </div>
      <div class="p-6 flex-1 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block mb-1">APPAREL &amp; GEAR</span>
          <h3 class="text-xl font-black text-white uppercase mb-2">MERCHANDISE</h3>
          <p class="text-xs text-gray-300 leading-relaxed font-normal">
            Premium apparel, collectibles, pins, and accessories inspired by Vice City.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
          <span class="text-gray-400">Rockstar Official</span>
          <span class="text-[#fdb813] font-bold group-hover:translate-x-1 transition-transform">SHOP NOW ➔</span>
        </div>
      </div>
    </div>

    <!-- Collector's Box Card -->
    <div class="group rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/15 hover:border-[#fdb813] transition-all duration-300 flex flex-col">
      <div class="relative w-full aspect-[16/9] overflow-hidden bg-black">
        <img
          src="/images/grotti-cheetah.jpg"
          alt="The Vice City Collection Collector's Box"
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent"></div>
      </div>
      <div class="p-6 flex-1 flex flex-col justify-between">
        <div>
          <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest block mb-1">LIMITED EDITION</span>
          <h3 class="text-xl font-black text-white uppercase mb-2">COLLECTOR’S BOX</h3>
          <p class="text-xs text-gray-300 leading-relaxed font-normal">
            The Vice City Collection — An exclusive curated set of physical memorabilia for the official launch.
          </p>
        </div>
        <div class="mt-6 pt-4 border-t border-white/10 flex items-center justify-between text-xs font-mono">
          <span class="text-gray-400">Exclusive Run</span>
          <span class="text-[#fdb813] font-bold group-hover:translate-x-1 transition-transform">EXPLORE NOW ➔</span>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 5. Featured News / Rockstar Newswire (Authentic Posts from rockstargames.com/VI) -->
<section class="my-20 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Rockstar Newswire">
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-white/10">
    <div>
      <div class="text-[11px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-1.5">
        FEATURED NEWS
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight">
        ROCKSTAR NEWSWIRE
      </h2>
    </div>
    <a
      href="https://www.rockstargames.com/newswire"
      target="_blank"
      rel="noopener noreferrer"
      class="text-xs font-mono text-gray-400 hover:text-white transition-colors"
    >
      VIEW ALL NEWSWIRE POSTS ➔
    </a>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
    <!-- News 1 -->
    <div class="p-6 rounded-3xl bg-[#0d0a1a] border border-white/10 hover:border-white/30 transition-all flex flex-col justify-between">
      <div>
        <span class="text-[10px] font-mono text-[#fdb813] uppercase tracking-wider block mb-2">
          NOVEMBER 10, 2026
        </span>
        <h3 class="text-lg font-black text-white uppercase mb-2">
          Pre-Load Grand Theft Auto VI Now
        </h3>
        <p class="text-xs text-gray-400 leading-relaxed font-normal">
          Digital pre-load is now live on PlayStation 5 and Xbox Series X|S ahead of the worldwide launch on November 19.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-white/10 text-xs font-mono text-gray-500">
        Newswire Article
      </div>
    </div>

    <!-- News 2 -->
    <div class="p-6 rounded-3xl bg-[#0d0a1a] border border-white/10 hover:border-white/30 transition-all flex flex-col justify-between">
      <div>
        <span class="text-[10px] font-mono text-[#fdb813] uppercase tracking-wider block mb-2">
          NOVEMBER 5, 2026
        </span>
        <h3 class="text-lg font-black text-white uppercase mb-2">
          Explore the Grand Theft Auto VI Launch Gallery
        </h3>
        <p class="text-xs text-gray-400 leading-relaxed font-normal">
          Take a look at new 4K captures showcasing Vice City's vibrant nightlife, the Grassrivers swamps, and coastal highways.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-white/10 text-xs font-mono text-gray-500">
        Newswire Article
      </div>
    </div>

    <!-- News 3 -->
    <div class="p-6 rounded-3xl bg-[#0d0a1a] border border-white/10 hover:border-white/30 transition-all flex flex-col justify-between">
      <div>
        <span class="text-[10px] font-mono text-[#fdb813] uppercase tracking-wider block mb-2">
          NOVEMBER 3, 2026
        </span>
        <h3 class="text-lg font-black text-white uppercase mb-2">
          Grand Theft Auto VI Pre-Load Begins on November 10
        </h3>
        <p class="text-xs text-gray-400 leading-relaxed font-normal">
          Official timing details for digital pre-orders and rolling midnight unlock schedules worldwide.
        </p>
      </div>
      <div class="mt-6 pt-4 border-t border-white/10 text-xs font-mono text-gray-500">
        Newswire Article
      </div>
    </div>
  </div>
</section>

<!-- 6. Get Rockstar Propaganda (Newsletter Signup from rockstargames.com/VI) -->
<section class="my-20 px-4 sm:px-6 max-w-4xl mx-auto" aria-label="Rockstar Propaganda">
  <div class="p-8 sm:p-12 rounded-3xl bg-gradient-to-b from-[#140f26] to-[#07050d] border border-white/15 text-center">
    <div class="w-10 h-10 rounded-xl bg-[#fdb813] flex items-center justify-center text-black font-black text-sm font-mono mx-auto mb-4 shadow-[0_0_15px_rgba(253,184,19,0.5)]">
      R★
    </div>
    <h3 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight mb-2">
      GET ROCKSTAR PROPAGANDA
    </h3>
    <p class="text-xs sm:text-sm text-gray-300 max-w-md mx-auto mb-6 leading-relaxed font-normal">
      Get the latest game announcements, updates on special events and offers, and much more from Rockstar Games.
    </p>

    <form id="propaganda-form" class="flex flex-col sm:flex-row items-center justify-center gap-3 max-w-md mx-auto">
      <input
        type="email"
        placeholder="Enter your email address"
        required
        class="w-full px-5 py-3.5 rounded-xl bg-black/80 border border-white/20 text-white text-xs font-mono focus:outline-none focus:border-[#fdb813] transition-colors"
      />
      <button
        type="submit"
        class="w-full sm:w-auto px-6 py-3.5 rounded-xl bg-white hover:bg-[#fdb813] text-black text-xs font-mono font-black uppercase tracking-wider transition-colors cursor-pointer shrink-0"
      >
        SUBSCRIBE
      </button>
    </form>

    <script is:inline>
      document.getElementById('propaganda-form')?.addEventListener('submit', (e) => {
        e.preventDefault();
        alert('Iscritto con successo agli aggiornamenti Rockstar Games!');
      });
    </script>
  </div>
</section>

<!-- 7. ESRB / PEGI Official Mature Content Rating Warning -->
<div class="my-12 px-4 sm:px-6 max-w-5xl mx-auto border-t border-b border-white/10 py-6">
  <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-center sm:text-left">
    <div class="px-3 py-1.5 rounded bg-zinc-900 border border-white/30 text-white font-mono font-black text-sm tracking-wider shrink-0">
      RATING 18+
    </div>
    <p class="text-[11px] font-mono text-gray-400 uppercase tracking-wider leading-relaxed">
      Blood and Gore, Intense Violence, Mature Humor, Nudity, Strong Language, Strong Sexual Content, Use of Drugs and Alcohol. In-Game Purchases.
    </p>
  </div>
</div>
