---
// Language Switcher Component (IT / EN)
---

<div class="inline-flex items-center p-1 rounded-xl bg-white/[0.06] border border-white/15 backdrop-blur-md shadow-inner text-xs font-mono select-none lang-switcher-container" role="group" aria-label="Selettore Lingua / Language Selector">
  <button
    type="button"
    data-lang-target="it"
    class="lang-btn-it px-2.5 py-1 rounded-lg font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer bg-vice-pink text-white shadow-sm"
    title="Imposta lingua: Italiano"
    aria-label="Lingua Italiana"
  >
    <span class="text-xs">🇮🇹</span>
    <span class="text-[11px] tracking-wider">IT</span>
  </button>

  <button
    type="button"
    data-lang-target="en"
    class="lang-btn-en px-2.5 py-1 rounded-lg font-bold transition-all duration-200 flex items-center gap-1.5 cursor-pointer text-gray-400 hover:text-white"
    title="Switch language: English"
    aria-label="English Language"
  >
    <span class="text-xs">🇬🇧</span>
    <span class="text-[11px] tracking-wider">EN</span>
  </button>
</div>
