---
interface Props {
  title?: string;
}

const { title = "CONDIVIDI IL CONTO ALLA ROVESCIA" } = Astro.props;
---

<div class="w-full max-w-xl mx-auto my-6 p-4 rounded-2xl bg-black/60 border border-white/10 backdrop-blur-xl shadow-xl">
  <div class="flex items-center justify-between mb-3 text-[10px] font-mono">
    <span class="text-gray-400 font-bold uppercase tracking-widest flex items-center gap-1.5">
      <svg class="w-3.5 h-3.5 text-[#fdb813]" fill="currentColor" viewBox="0 0 24 24"><path d="M18 16.08c-.76 0-1.44.3-1.96.77L8.91 12.7c.05-.23.09-.46.09-.7s-.04-.47-.09-.7l7.05-4.11c.54.5 1.25.81 2.04.81 1.66 0 3-1.34 3-3s-1.34-3-3-3-3 1.34-3 3c0 .24.04.47.09.7L8.04 9.81C7.5 9.31 6.79 9 6 9c-1.66 0-3 1.34-3 3s1.34 3 3 3c.79 0 1.5-.31 2.04-.81l7.12 4.16c-.05.21-.08.43-.08.65 0 1.61 1.31 2.92 2.92 2.92s2.92-1.31 2.92-2.92c0-1.61-1.31-2.92-2.92-2.92z"/></svg>
      <span data-i18n="share.title">{title}</span>
    </span>
    <span data-i18n="share.subtitle" class="text-vice-cyan font-semibold">PASSAPAROLA GAMER</span>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-4 gap-2">
    <!-- WhatsApp Share -->
    <a
      id="share-whatsapp"
      href="https://api.whatsapp.com/send?text=Mancano%20pochi%20giorni%20al%20lancio%20mondiale%20di%20GTA%206!%20Guarda%20il%20countdown%20live,%20la%20mappa%20di%20Vice%20City%20e%20i%20trailer%20su:%20https://gta6leonida.it"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-[#25D366]/20 hover:bg-[#25D366] text-[#25D366] hover:text-black font-mono font-bold text-xs uppercase tracking-wider border border-[#25D366]/30 transition-all duration-200"
      aria-label="Condividi su WhatsApp"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.312.045-.694.077-1.111-.061-.252-.084-.576-.198-.991-.381-1.745-.77-2.879-2.544-2.966-2.66-.088-.116-.711-.947-.711-1.807 0-.86.452-1.282.613-1.456.162-.174.354-.218.472-.218.118 0 .237.001.341.006.111.005.259-.042.404.307.15.36.512 1.25.556 1.341.045.091.074.198.015.316-.06.118-.089.192-.178.296-.089.104-.187.232-.267.312-.089.089-.182.186-.078.365.104.179.462.763.992 1.236.684.609 1.261.799 1.44.888.179.089.284.074.39-.045.105-.118.448-.522.568-.701.119-.179.239-.149.4-.089.162.06 1.026.484 1.202.573.177.089.296.133.34.208.045.074.045.433-.099.838z"/></svg>
      <span>WhatsApp</span>
    </a>

    <!-- Telegram Share -->
    <a
      id="share-telegram"
      href="https://t.me/share/url?url=https://gta6leonida.it&text=Conto%20alla%20rovescia%20GTA%206,%20mappa%20di%20Leonida%20e%20dati%20ufficiali"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-[#0088cc]/20 hover:bg-[#0088cc] text-[#0088cc] hover:text-white font-mono font-bold text-xs uppercase tracking-wider border border-[#0088cc]/30 transition-all duration-200"
      aria-label="Condividi su Telegram"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm4.64 6.8c-.15 1.58-.8 5.42-1.13 7.19-.14.75-.42 1-.68 1.03-.58.05-1.02-.38-1.58-.75-.88-.58-1.38-.94-2.23-1.5-.99-.65-.35-1.01.22-1.59.15-.15 2.71-2.48 2.76-2.69a.2.2 0 00-.05-.18c-.06-.05-.14-.03-.21-.02-.09.02-1.49.95-4.22 2.79-.4.27-.76.41-1.08.4-.36-.01-1.04-.2-1.55-.37-.63-.2-1.12-.31-1.08-.66.02-.18.27-.36.74-.55 2.92-1.27 4.86-2.11 5.83-2.51 2.78-1.16 3.35-1.36 3.73-1.36.08 0 .27.02.39.12.1.08.13.19.14.27-.01.06.01.24 0 .38z"/></svg>
      <span>Telegram</span>
    </a>

    <!-- X / Twitter Share -->
    <a
      id="share-twitter"
      href="https://twitter.com/intent/tweet?text=Conto%20alla%20rovescia%20ufficiale%20al%2019%20Novembre%202026%20per%20Grand%20Theft%20Auto%20VI!%20Esplora%20la%20mappa%20di%20Leonida%20e%20i%20trailer%20su%20https://gta6leonida.it%20%23GTA6%20%23GTAVI"
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-white/10 hover:bg-white text-white hover:text-black font-mono font-bold text-xs uppercase tracking-wider border border-white/20 transition-all duration-200"
      aria-label="Condividi su X"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
      <span>X (Twitter)</span>
    </a>

    <!-- Copy Link Button -->
    <button
      id="btn-copy-link"
      type="button"
      class="flex items-center justify-center gap-1.5 px-3 py-2.5 rounded-xl bg-[#fdb813]/20 hover:bg-[#fdb813] text-[#fdb813] hover:text-black font-mono font-bold text-xs uppercase tracking-wider border border-[#fdb813]/30 transition-all duration-200"
      aria-label="Copia link sito"
    >
      <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24"><path d="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"/></svg>
      <span id="copy-text">Copia Link</span>
    </button>
  </div>
</div>

<script>
  function setupShare() {
    const copyBtn = document.getElementById('btn-copy-link');
    const copyText = document.getElementById('copy-text');
    if (!copyBtn || !copyText) return;

    copyBtn.addEventListener('click', async () => {
      try {
        const url = window.location.origin;
        if (navigator.clipboard && navigator.clipboard.writeText) {
          await navigator.clipboard.writeText(url);
        }
        const original = copyText.textContent;
        copyText.textContent = 'COPIATO! ✓';
        copyBtn.classList.add('bg-[#fdb813]', 'text-black');
        setTimeout(() => {
          copyText.textContent = original;
          copyBtn.classList.remove('bg-[#fdb813]', 'text-black');
        }, 2500);
      } catch (err) {
        console.error('Copy failed:', err);
      }
    });
  }

  setupShare();
  document.addEventListener('astro:page-load', setupShare);
</script>
