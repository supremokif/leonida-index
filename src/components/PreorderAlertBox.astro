---
// Interactive Verified Launch & Pre-Order Notification Center
// Functional client-side state with localStorage persistence and Native Web Notifications support.
---

<section id="launch-alerts" class="my-20 scroll-mt-24 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Alert Pre-ordini Ufficiali">
  <div class="taste-card p-8 sm:p-12 relative overflow-hidden bg-gradient-to-b from-[#18112d] via-[#0f0b1f] to-[#07050d] border border-white/15">
    
    <!-- Ambient Flare -->
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-vice-pink/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-3xl mb-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-amber-400/40 text-[10px] font-mono font-bold text-amber-400 uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>SISTEMA DI NOTIFICA ROCKSTAR // PRE-ORDER WATCH</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        ALERT APERTURA <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">PRE-ORDINI &amp; TRAILER 2</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-2 font-normal leading-relaxed">
        Rockstar Games non annuncia in anticipo il giorno esatto di apertura dei pre-ordini digitali e fisici. Attiva l'alert per ricevere una notifica istantanea non appena si apriranno i canali ufficiali su PlayStation Store, Microsoft Store e rivenditori autorizzati.
      </p>
    </div>

    <!-- Interactive Form Island -->
    <div class="max-w-xl relative z-10" id="preorder-alert-root">
      
      <!-- Subscribed State (Hidden by default, shown if in localStorage) -->
      <div id="alert-success-state" class="hidden p-6 rounded-2xl bg-[#141b18] border border-emerald-400/40 text-emerald-300">
        <div class="flex items-center gap-3 mb-2 font-mono font-bold text-sm text-white">
          <span class="w-3 h-3 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>ALERT PRE-ORDINI ATTIVO SUL TUO DISPOSITIVO</span>
        </div>
        <p class="text-xs text-gray-300 leading-relaxed font-normal mb-4">
          Riceverai un avviso prioritario non appena Take-Two Interactive e Rockstar Games avvieranno la campagna di pre-ordine ufficiale di Grand Theft Auto VI.
        </p>
        <button
          type="button"
          id="alert-reset-btn"
          class="text-[11px] font-mono text-gray-400 hover:text-white underline transition-colors cursor-pointer"
        >
          Modifica preferenze di notifica
        </button>
      </div>

      <!-- Active Form -->
      <form id="preorder-alert-form" class="flex flex-col gap-4">
        <div class="flex flex-col sm:flex-row gap-3">
          <div class="relative flex-1">
            <input
              type="email"
              id="alert-email-input"
              name="email"
              required
              placeholder="Inserisci la tua email..."
              class="w-full px-5 py-3.5 rounded-xl bg-black/80 border border-white/20 text-white placeholder-gray-500 text-xs sm:text-sm font-mono focus:outline-none focus:border-vice-cyan transition-colors"
            />
          </div>
          <button
            type="submit"
            id="alert-submit-btn"
            class="taste-btn px-7 py-3.5 rounded-xl bg-white hover:bg-amber-400 text-black font-black text-xs font-mono uppercase tracking-wider transition-all duration-200 shrink-0 cursor-pointer shadow-lg"
          >
            ATTIVA ALERT ➔
          </button>
        </div>

        <!-- Optional Browser Push Notification Toggle -->
        <div class="flex items-center justify-between gap-4 pt-2 border-t border-white/10 text-xs font-mono text-gray-400">
          <div class="flex items-center gap-2">
            <input
              type="checkbox"
              id="alert-browser-push"
              class="w-4 h-4 rounded bg-zinc-900 border-white/20 text-vice-pink focus:ring-0 cursor-pointer"
            />
            <label for="alert-browser-push" class="cursor-pointer text-gray-300 hover:text-white transition-colors">
              Abilita anche notifica desktop / smartphone
            </label>
          </div>
          <span class="text-[10px] text-gray-500 uppercase tracking-widest hidden sm:inline">ZERO SPAM // PRIVACY TUTELATA</span>
        </div>
      </form>

      <!-- Status Toast Message -->
      <div id="alert-toast-msg" class="hidden mt-4 p-3 rounded-xl text-xs font-mono"></div>
    </div>
  </div>
</section>

<script>
  function initPreorderAlert() {
    const root = document.getElementById('preorder-alert-root');
    if (!root) return;

    const form = document.getElementById('preorder-alert-form') as HTMLFormElement | null;
    const emailInput = document.getElementById('alert-email-input') as HTMLInputElement | null;
    const browserPushCheckbox = document.getElementById('alert-browser-push') as HTMLInputElement | null;
    const successState = document.getElementById('alert-success-state');
    const resetBtn = document.getElementById('alert-reset-btn');
    const toastMsg = document.getElementById('alert-toast-msg');

    const STORAGE_KEY = 'leonida_preorder_alert_v1';

    // Check if user is already registered in localStorage
    const saved = localStorage.getItem(STORAGE_KEY);
    if (saved) {
      form?.classList.add('hidden');
      successState?.classList.remove('hidden');
    }

    resetBtn?.addEventListener('click', () => {
      localStorage.removeItem(STORAGE_KEY);
      successState?.classList.add('hidden');
      form?.classList.remove('hidden');
      if (emailInput) emailInput.value = '';
    });

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = emailInput?.value?.trim();

      if (!email || !email.includes('@')) {
        showToast('Inserisci un indirizzo email valido.', 'error');
        return;
      }

      // Check browser push notification if requested
      if (browserPushCheckbox?.checked && 'Notification' in window) {
        try {
          const permission = await Notification.requestPermission();
          if (permission === 'granted') {
            new Notification('Leonida Index // GTA VI Watch', {
              body: 'Alert Pre-Order attivato. Riceverai una notifica non appena apriranno i canali ufficiali.',
              icon: '/images/rockstar-vi-logo.png',
            });
          }
        } catch (err) {
          console.warn('Notification permission error:', err);
        }
      }

      // Save subscription locally
      const subData = {
        email,
        timestamp: new Date().toISOString(),
        pushEnabled: browserPushCheckbox?.checked || false,
      };
      localStorage.setItem(STORAGE_KEY, JSON.stringify(subData));

      showToast('Alert attivato con successo!', 'success');
      setTimeout(() => {
        form?.classList.add('hidden');
        successState?.classList.remove('hidden');
      }, 800);
    });

    function showToast(msg: string, type: 'success' | 'error') {
      if (!toastMsg) return;
      toastMsg.textContent = msg;
      toastMsg.className = `mt-4 p-3 rounded-xl text-xs font-mono ${
        type === 'success'
          ? 'bg-emerald-950/80 border border-emerald-400/40 text-emerald-300'
          : 'bg-rose-950/80 border border-rose-400/40 text-rose-300'
      }`;
      toastMsg.classList.remove('hidden');
    }
  }

  initPreorderAlert();
  document.addEventListener('astro:page-load', initPreorderAlert);
</script>
