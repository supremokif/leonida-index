---
import LiteYouTube from './LiteYouTube.astro';

const videoTabs = [
  {
    id: 'trailer-1',
    title: 'Trailer 1',
    actionText: 'Watch Trailer 1',
    youtubeId: 'QdBZY2fkU-0',
    duration: '1:31',
    image: '/images/rockstar-trailer-1.jpg',
    soundtrack: 'Love Is a Long Road — Tom Petty',
    status: 'AVAILABLE NOW',
    active: true,
  },
  {
    id: 'trailer-2',
    title: 'Trailer 2',
    actionText: 'Watch Trailer 2',
    youtubeId: 'OFFICIAL_ROCKSTAR_NEWSWIRE',
    duration: 'TBA',
    image: '/images/rockstar-trailer-2.jpg',
    soundtrack: 'Official Rockstar Soundtrack',
    status: 'OFFICIAL SELECTION',
    active: false,
  },
  {
    id: 'launch-trailer',
    title: 'Launch Trailer',
    actionText: 'Watch Launch Trailer',
    youtubeId: 'OFFICIAL_ROCKSTAR_NEWSWIRE',
    duration: 'TBA',
    image: '/images/gtavi-standard-edition.jpg',
    soundtrack: 'Official Score',
    status: 'OFFICIAL SELECTION',
    active: false,
  },
  {
    id: 'extended-look',
    title: 'An Extended Look',
    actionText: 'Watch An Extended Look',
    youtubeId: 'OFFICIAL_ROCKSTAR_NEWSWIRE',
    duration: 'TBA',
    image: '/images/gtavi-ultimate-edition.jpg',
    soundtrack: 'Gameplay Deep Dive',
    status: 'OFFICIAL SELECTION',
    active: false,
  },
  {
    id: 'preload-showcase',
    title: 'Pre-Load Now',
    actionText: 'Watch Pre-Load Now',
    youtubeId: 'OFFICIAL_ROCKSTAR_NEWSWIRE',
    duration: 'TBA',
    image: '/images/vice-ocean-drive.jpg',
    soundtrack: 'PS5 & Xbox Features',
    status: 'OFFICIAL SELECTION',
    active: false,
  },
];
---

<section id="trailer" class="my-16 scroll-mt-24 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Official Videos">
  <!-- Section Title Rockstar Style -->
  <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-4 border-b border-white/10">
    <div>
      <div class="text-[11px] font-mono font-bold tracking-[0.25em] text-[#fdb813] uppercase mb-1.5 flex items-center gap-2">
        <span>ROCKSTAR GAMES MEDIA</span>
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white uppercase tracking-tight font-sans">
        OFFICIAL VIDEOS
      </h2>
    </div>
    <div class="text-xs font-mono text-gray-400">
      ROCKSTAR NEWSWIRE ARCHIVE
    </div>
  </div>

  <!-- Main Active Video Player -->
  <div class="w-full mb-8 rounded-3xl overflow-hidden border border-white/15 shadow-2xl bg-black">
    <LiteYouTube
      videoId="QdBZY2fkU-0"
      title="Grand Theft Auto VI Trailer 1"
      duration="1:31"
      soundtrack="Love Is a Long Road — Tom Petty"
    />
  </div>

  <!-- Video Selector Carousel Tabs (Identical to rockstargames.com/VI) -->
  <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
    {videoTabs.map((tab) => (
      <div
        class={`group relative rounded-2xl overflow-hidden border transition-all duration-300 cursor-pointer flex flex-col ${
          tab.active
            ? 'border-white bg-[#151026] shadow-xl'
            : 'border-white/10 bg-[#0a0a0a] hover:border-white/40'
        }`}
      >
        <div class="relative w-full aspect-video overflow-hidden bg-zinc-900">
          <img
            src={tab.image}
            alt={tab.title}
            class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
          />
          <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors"></div>
          
          <div class="absolute bottom-2 right-2 px-1.5 py-0.5 rounded bg-black/80 text-[9px] font-mono text-white">
            {tab.duration}
          </div>
        </div>

        <div class="p-3.5 flex flex-col justify-between flex-1">
          <div>
            <div class="text-[9px] font-mono font-bold uppercase tracking-wider text-[#fdb813] mb-0.5">
              {tab.actionText}
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-[#fdb813] transition-colors line-clamp-1">
              {tab.title}
            </h3>
          </div>
          <div class="mt-2 text-[10px] font-mono text-gray-500 truncate">
            {tab.status}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
