---
interface Props {
  id: string;
  format?: 'rectangle' | 'leaderboard' | 'responsive';
  clientAdUnit?: string;
}

const { id, format = 'rectangle', clientAdUnit } = Astro.props;

let minHeightClass = 'min-h-[250px]';
let containerClass = 'max-w-[336px]';

if (format === 'leaderboard') {
  minHeightClass = 'min-h-[90px]';
  containerClass = 'max-w-[728px]';
} else if (format === 'responsive') {
  minHeightClass = 'min-h-[280px]';
  containerClass = 'max-w-4xl w-full';
}
---

<div class={`w-full mx-auto my-6 flex flex-col items-center justify-center ${containerClass}`}>
  <div class="text-[9px] font-mono tracking-widest uppercase text-gray-500 mb-1 flex items-center gap-1.5">
    <span>CIRCUITO EDITORIALE SPONSOR</span>
    <span class="text-[8px] px-1 py-0.2 rounded bg-[#1b1433] text-vice-cyan border border-white/[0.08]">CLS-LOCKED</span>
  </div>

  <div 
    id={`ad-slot-${id}`} 
    class={`w-full ${minHeightClass} rounded-2xl bg-[#0a0714] border border-white/[0.08] flex flex-col items-center justify-center p-4 text-center overflow-hidden transition-all relative`}
    aria-label="Spazio editoriale sponsor"
  >
    <div class="absolute inset-0 opacity-10 pointer-events-none bg-[radial-gradient(#ff007a_1px,transparent_1px)] [background-size:20px_20px]"></div>

    <div class="flex flex-col items-center gap-2 z-10 text-gray-400">
      <div class="w-8 h-8 rounded-xl bg-white/[0.04] border border-white/[0.08] flex items-center justify-center text-gray-400">
        <svg class="w-4 h-4 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
        </svg>
      </div>
      <span class="text-xs font-mono text-gray-400">LEONIDA INDEX // SPONSOR NETWORK</span>
      <span class="text-[10px] font-mono text-gray-400">Consenso attivo solo previa autorizzazione GDPR</span>
    </div>

    {clientAdUnit && (
      <ins 
        class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-0000000000000000"
        data-ad-slot={clientAdUnit}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    )}
  </div>
</div>
