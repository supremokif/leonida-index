---
// Editorial Partner & Ad Slot Component
// Displays real editorial sponsorship and pre-load notices when ad units are pending, and renders Google AdSense when clientAdUnit is configured.
import { resolvePath } from '../utils/paths';

interface Props {
  id: string;
  format?: 'rectangle' | 'leaderboard' | 'responsive';
  clientAdUnit?: string;
}

const { id, format = 'rectangle', clientAdUnit } = Astro.props;

let containerClass = 'max-w-[336px]';
if (format === 'leaderboard') {
  containerClass = 'max-w-4xl w-full';
} else if (format === 'responsive') {
  containerClass = 'max-w-5xl w-full';
}
---

<!-- High-Taste Editorial Partner & Launch Announcement Banner -->
<div class={`w-full mx-auto my-8 flex flex-col items-center justify-center ${containerClass}`}>
  {clientAdUnit ? (
    <div id={`ad-slot-${id}`} class="w-full rounded-2xl bg-[#0a0714] border border-white/10 p-4 text-center overflow-hidden">
      <ins 
        class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-0000000000000000"
        data-ad-slot={clientAdUnit}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    </div>
  ) : (
    <div 
      id={`editorial-slot-${id}`} 
      class="taste-card w-full p-4 sm:p-5 rounded-2xl bg-gradient-to-r from-[#140e26] via-[#0d091a] to-[#07050d] border border-white/15 flex flex-col sm:flex-row items-center justify-between gap-4 relative overflow-hidden"
    >
      <div class="flex items-center gap-3.5 z-10">
        <div class="w-9 h-9 rounded-xl bg-amber-400/10 border border-amber-400/30 flex items-center justify-center text-amber-400 shrink-0 font-mono font-black text-xs">
          R&#9733;
        </div>
        <div>
          <div class="flex items-center gap-2 mb-0.5">
            <span class="text-[10px] font-mono font-bold text-emerald-400 uppercase tracking-widest flex items-center gap-1">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
              DAY-ONE IN ARRIVO // 19 NOV 2026
            </span>
          </div>
          <p class="text-xs text-gray-300 font-normal leading-snug">
            Pre-load attivo da martedì 17 Novembre (~150 GB). Verifica i requisiti del tuo disco prima dello sblocco.
          </p>
        </div>
      </div>

      <div class="flex items-center gap-2.5 shrink-0 z-10 w-full sm:w-auto justify-end">
        <a
          href={resolvePath('/storage-calculator')}
          class="taste-btn px-4 py-2 rounded-xl bg-white hover:bg-vice-cyan text-black text-xs font-mono font-black uppercase tracking-wider transition-all"
        >
          TEST SSD CONSOLE &rarr;
        </a>
      </div>
    </div>
  )}
</div>
