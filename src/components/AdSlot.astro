---
interface Props {
  id: string;
  format?: 'rectangle' | 'leaderboard' | 'responsive';
  clientAdUnit?: string;
}

const { id, format = 'rectangle', clientAdUnit } = Astro.props;

let minHeightClass = 'min-h-[250px]';
let containerClass = 'max-w-[336px]';

if (format === 'leaderboard') {
  minHeightClass = 'min-h-[90px]';
  containerClass = 'max-w-[728px]';
} else if (format === 'responsive') {
  minHeightClass = 'min-h-[280px]';
  containerClass = 'max-w-4xl w-full';
}
---

<div class={`w-full mx-auto my-6 flex flex-col items-center justify-center ${containerClass}`}>
  <div class="text-[10px] tracking-wider uppercase text-gray-400 font-semibold mb-1 flex items-center gap-1">
    <span>Spazio Pubblicitario Riservato</span>
    <span class="text-[9px] px-1 py-0.2 rounded bg-surface-200 text-gray-400 border border-surface-300">CLS-Safe</span>
  </div>

  <div 
    id={`ad-slot-${id}`} 
    class={`w-full ${minHeightClass} rounded-xl bg-surface-100/60 border border-surface-200 flex flex-col items-center justify-center p-4 text-center overflow-hidden transition-all relative`}
    aria-label="Annuncio pubblicitario non invasivo"
  >
    <div class="absolute inset-0 opacity-5 pointer-events-none bg-[radial-gradient(#ff2a85_1px,transparent_1px)] [background-size:16px_16px]"></div>

    <div class="flex flex-col items-center gap-2 z-10 text-gray-400">
      <svg class="w-6 h-6 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"></path>
      </svg>
      <span class="text-xs font-medium text-gray-400">Annuncio Verificato • Supporta il portale indipendente GTA 6</span>
      <span class="text-[11px] text-gray-400">Nessun cookie invasivo attivo</span>
    </div>

    {clientAdUnit && (
      <ins 
        class="adsbygoogle"
        style="display:block"
        data-ad-client="ca-pub-0000000000000000"
        data-ad-slot={clientAdUnit}
        data-ad-format="auto"
        data-full-width-responsive="true"
      ></ins>
    )}
  </div>
</div>
