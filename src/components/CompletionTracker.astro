---
import db from '../data/gta6_db.json';
import { resolvePath } from '../utils/paths';

const regions = db.locations;
const totalCollectibles = regions.reduce((acc, r) => acc + r.collectibles.length, 0);
---

<div class="w-full max-w-5xl mx-auto my-10 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026]/90 via-[#0d0a1a] to-[#07050d] border border-white/[0.12] shadow-2xl backdrop-blur-2xl relative overflow-hidden" id="completion-tracker-root">
  
  <!-- Ambient Dusk Flare -->
  <div class="absolute -right-24 -top-24 w-80 h-80 bg-vice-pink/15 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute -left-24 -bottom-24 w-80 h-80 bg-vice-cyan/15 rounded-full blur-[100px] pointer-events-none"></div>

  <!-- Header with Global Progress -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-white/[0.1] relative z-10">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-xs font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-vice-pink animate-pulse"></span>
        <span>DOSSIER PUNTI DI INTERESSE // PRIVACY-FIRST LOCAL STORAGE</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        LEONIDA <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">EXPLORATION TRACKER</span>
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2 max-w-xl font-normal leading-relaxed">
        Spunta tutti i punti di interesse, gli scorci di Vice City e le ambientazioni documentate nel Trailer 1 ufficiale. I tuoi progressi sono salvati privatamente nel tuo browser.
      </p>
    </div>

    <!-- Progress Card -->
    <div class="bg-[#140f26] p-6 rounded-2xl border border-white/[0.12] min-w-[280px] shadow-2xl">
      <div class="flex items-center justify-between text-xs font-mono font-bold uppercase mb-2.5">
        <span class="text-gray-300">AVANZAMENTO ESPLORAZIONE</span>
        <span id="tracker-pct" class="text-vice-pink font-mono text-xl font-black drop-shadow-[0_0_10px_rgba(255,0,122,0.8)]">0%</span>
      </div>
      <div class="w-full h-3.5 rounded-full bg-[#07050d] overflow-hidden border border-white/[0.08] mb-3">
        <div id="tracker-progress-bar" class="h-full bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan w-0 transition-all duration-300 shadow-[0_0_10px_rgba(255,0,122,0.8)]"></div>
      </div>
      <div class="flex items-center justify-between text-[11px] font-mono text-gray-400">
        <span id="tracker-count" class="font-bold text-white">0 di {totalCollectibles} documentati</span>
        <button id="tracker-reset-btn" type="button" class="text-gray-400 hover:text-red-400 transition-colors cursor-pointer underline">
          Azzera
        </button>
      </div>
    </div>
  </div>

  <!-- Region Filter Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto py-5 mb-8 border-b border-white/[0.08] no-scrollbar relative z-10">
    <button
      type="button"
      class="tracker-filter-btn px-4 py-2.5 rounded-xl text-xs font-mono font-bold tracking-wider uppercase bg-gradient-to-r from-vice-pink to-vice-orange text-white shadow-neon-pink cursor-pointer transition-all shrink-0"
      data-region="all"
    >
      TUTTE LE REGIONI ({totalCollectibles})
    </button>
    {regions.map((reg) => (
      <button
        type="button"
        class="tracker-filter-btn px-4 py-2.5 rounded-xl text-xs font-mono font-bold tracking-wider uppercase bg-[#140f26] hover:bg-[#1b1433] text-gray-300 hover:text-white border border-white/[0.08] hover:border-vice-cyan/40 cursor-pointer transition-all shrink-0"
        data-region={reg.id}
      >
        {reg.name.split('&')[0].trim()} ({reg.collectibles.length})
      </button>
    ))}
  </div>

  <!-- Checklist Grid -->
  <div class="space-y-6 relative z-10" id="tracker-items-container">
    {regions.map((region) => (
      <div class="tracker-region-section rounded-3xl bg-[#0e0a1a]/80 border border-white/[0.1] p-6 shadow-xl" data-region-id={region.id}>
        <div class="flex items-center justify-between mb-5 pb-3 border-b border-white/[0.08]">
          <div class="flex items-center gap-3">
            <span class="w-2.5 h-2.5 rounded-full bg-vice-cyan shadow-[0_0_8px_#00f0ff]"></span>
            <h3 class="text-lg font-black text-white uppercase tracking-tight">{region.name}</h3>
            <span class="text-xs font-mono text-gray-400 hidden sm:inline">({region.category})</span>
          </div>
          <a href={resolvePath(`/leonida/${region.slug}`)} class="text-xs font-mono font-bold text-vice-cyan hover:underline">
            VEDI MAPPA REGIONALE ➔
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3.5">
          {region.collectibles.map((item) => (
            <label
              class="tracker-item-label flex items-start gap-3.5 p-4 rounded-2xl bg-[#140f26]/90 border border-white/[0.08] hover:border-vice-pink/50 cursor-pointer transition-all duration-200 select-none group shadow-md"
              data-item-id={item.id}
            >
              <input
                type="checkbox"
                class="tracker-checkbox w-5 h-5 rounded-lg bg-[#07050d] border-white/20 text-vice-pink focus:ring-0 focus:ring-offset-0 cursor-pointer shrink-0 mt-0.5"
                data-id={item.id}
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="tracker-item-title text-sm font-bold text-white group-hover:text-vice-pink transition-colors">
                    {item.name}
                  </span>
                  <span class="text-[9px] px-2 py-0.5 rounded-md bg-[#1b1433] text-vice-cyan font-mono border border-white/10 shrink-0 uppercase">
                    {item.type}
                  </span>
                </div>
                <div class="text-xs font-mono text-emerald-400 mt-1.5 flex items-center gap-1.5">
                  <span class="text-gray-400">Stato:</span>
                  <strong class="text-emerald-400">{item.reward}</strong>
                </div>
              </div>
            </label>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Backup & Restore Actions -->
  <div class="mt-10 pt-6 border-t border-white/[0.1] flex flex-col sm:flex-row items-center justify-between gap-4 text-xs font-mono text-gray-400 relative z-10">
    <div class="flex items-center gap-2">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>BACKUP LOCALE: Esporta o ripristina la tua partita su altri browser.</span>
    </div>
    <div class="flex items-center gap-3">
      <button
        id="tracker-export-btn"
        type="button"
        class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#140f26] hover:bg-[#1b1433] text-white font-mono font-bold text-xs border border-white/[0.12] hover:border-vice-cyan/50 transition-all cursor-pointer"
      >
        <svg class="w-3.5 h-3.5 text-vice-cyan" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"/></svg>
        <span>ESPORTA JSON</span>
      </button>
      <label class="inline-flex items-center gap-2 px-4 py-2.5 rounded-xl bg-[#140f26] hover:bg-[#1b1433] text-white font-mono font-bold text-xs border border-white/[0.12] hover:border-vice-pink/50 transition-all cursor-pointer">
        <svg class="w-3.5 h-3.5 text-vice-pink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"/></svg>
        <span>IMPORTA JSON</span>
        <input type="file" id="tracker-import-file" accept=".json" class="hidden" />
      </label>
    </div>
  </div>
</div>

<script>
  function setupCompletionTracker() {
    const STORAGE_KEY = 'leonida_100_tracker';
    const checkboxes = document.querySelectorAll<HTMLInputElement>('.tracker-checkbox');
    const pctEl = document.getElementById('tracker-pct');
    const progressBar = document.getElementById('tracker-progress-bar');
    const countEl = document.getElementById('tracker-count');
    const resetBtn = document.getElementById('tracker-reset-btn');
    const exportBtn = document.getElementById('tracker-export-btn');
    const importInput = document.getElementById('tracker-import-file') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tracker-filter-btn');
    const regionSections = document.querySelectorAll<HTMLElement>('.tracker-region-section');

    const total = checkboxes.length;
    if (total === 0) return;

    const whitelist = new Set<string>();
    checkboxes.forEach((cb) => {
      const id = cb.getAttribute('data-id');
      if (id) whitelist.add(id);
    });

    function loadState(): Record<string, boolean> {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return {};
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {};

        const clean: Record<string, boolean> = {};
        for (const [key, val] of Object.entries(parsed)) {
          if (key === '__proto__' || key === 'constructor' || key === 'prototype') continue;
          if (whitelist.has(key) && typeof val === 'boolean') {
            clean[key] = val;
          }
        }
        return clean;
      } catch {
        return {};
      }
    }

    function saveState(state: Record<string, boolean>) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    let state = loadState();

    function updateUI() {
      let checkedCount = 0;

      checkboxes.forEach((cb) => {
        const id = cb.getAttribute('data-id');
        if (!id) return;
        const isChecked = !!state[id];
        cb.checked = isChecked;

        const label = cb.closest('.tracker-item-label');
        if (label) {
          if (isChecked) {
            label.classList.add('bg-emerald-950/40', 'border-emerald-500/60');
            label.classList.remove('bg-[#140f26]/90', 'border-white/[0.08]');
          } else {
            label.classList.remove('bg-emerald-950/40', 'border-emerald-500/60');
            label.classList.add('bg-[#140f26]/90', 'border-white/[0.08]');
          }
        }

        if (isChecked) checkedCount++;
      });

      const percentage = Math.round((checkedCount / total) * 100);
      if (pctEl) pctEl.textContent = `${percentage}%`;
      if (progressBar) progressBar.style.width = `${percentage}%`;
      if (countEl) countEl.textContent = `${checkedCount} di ${total} completati`;
    }

    checkboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-id');
        if (!id || !whitelist.has(id)) return;
        state[id] = cb.checked;
        saveState(state);
        updateUI();
      });
    });

    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (confirm('Sei sicuro di voler azzerare tutti i progressi del tracker di Leonida?')) {
          state = {};
          saveState(state);
          updateUI();
        }
      });
    }

    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const payload = {
          app: 'Leonida Index 100% Tracker',
          exportedAt: new Date().toISOString(),
          progress: state,
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `leonida-tracker-backup-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    if (importInput) {
      importInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const file = target.files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const rawContent = evt.target?.result as string;
            const parsed = JSON.parse(rawContent);

            const importedProgress = parsed.progress || parsed;
            if (!importedProgress || typeof importedProgress !== 'object') {
              alert('File di backup non valido.');
              return;
            }

            const cleanState: Record<string, boolean> = {};
            for (const [k, v] of Object.entries(importedProgress)) {
              if (k === '__proto__' || k === 'constructor' || k === 'prototype') continue;
              if (whitelist.has(k) && typeof v === 'boolean') {
                cleanState[k] = v;
              }
            }

            state = cleanState;
            saveState(state);
            updateUI();
            alert('Progressi del Tracker ripristinati con successo!');
          } catch {
            alert('Errore durante la lettura del file JSON.');
          }
        };
        reader.readAsText(file);
      });
    }

    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const region = btn.getAttribute('data-region');
        if (!region) return;

        filterButtons.forEach((b) => {
          b.classList.remove('bg-gradient-to-r', 'from-vice-pink', 'to-vice-orange', 'text-white', 'shadow-neon-pink');
          b.classList.add('bg-[#140f26]', 'text-gray-300', 'border-white/[0.08]');
        });
        btn.classList.add('bg-gradient-to-r', 'from-vice-pink', 'to-vice-orange', 'text-white', 'shadow-neon-pink');
        btn.classList.remove('bg-[#140f26]', 'text-gray-300', 'border-white/[0.08]');

        regionSections.forEach((sec) => {
          const secRegion = sec.getAttribute('data-region-id');
          if (region === 'all' || secRegion === region) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });
      });
    });

    updateUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCompletionTracker);
  } else {
    setupCompletionTracker();
  }
  document.addEventListener('astro:page-load', setupCompletionTracker);
</script>
