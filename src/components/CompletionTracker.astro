---
import db from '../data/gta6_db.json';

const regions = db.locations;
const totalCollectibles = regions.reduce((acc, r) => acc + r.collectibles.length, 0);
---

<div class="w-full max-w-5xl mx-auto my-10 p-6 sm:p-10 rounded-3xl bg-surface-100/90 border border-surface-300 shadow-2xl backdrop-blur-xl" id="completion-tracker-root">
  <!-- Header with Global Progress -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 pb-8 border-b border-surface-300">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-200 border border-miami-pink/40 text-xs font-bold text-miami-pink uppercase mb-3">
        <span class="w-2 h-2 rounded-full bg-miami-pink"></span>
        <span>Salvataggio Locale Sicuro (Privacy-First)</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight uppercase">
        LEONIDA 100% <span class="bg-gradient-to-r from-miami-pink via-miami-orange to-miami-cyan bg-clip-text text-transparent">TRACKER</span>
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2 max-w-xl">
        Spunta tutti i collezionabili, armi segrete, casseforti e misteri confermati nelle 6 regioni dello Stato di Leonida. I progressi rimangono salvati esclusivamente nel tuo browser.
      </p>
    </div>

    <!-- Progress Card -->
    <div class="bg-surface-50 p-5 rounded-2xl border border-surface-300 min-w-[260px] shadow-lg">
      <div class="flex items-center justify-between text-xs font-bold uppercase mb-2">
        <span class="text-gray-300">Completamento</span>
        <span id="tracker-pct" class="text-miami-pink font-mono text-base font-black">0%</span>
      </div>
      <div class="w-full h-3 rounded-full bg-surface-200 overflow-hidden border border-surface-300 mb-2">
        <div id="tracker-progress-bar" class="h-full bg-gradient-to-r from-miami-pink to-miami-cyan w-0 transition-all duration-300"></div>
      </div>
      <div class="flex items-center justify-between text-[11px] text-gray-400">
        <span id="tracker-count">0 di {totalCollectibles} completati</span>
        <button id="tracker-reset-btn" type="button" class="text-gray-400 hover:text-red-400 transition-colors cursor-pointer underline">
          Azzera
        </button>
      </div>
    </div>
  </div>

  <!-- Region Filter Tabs -->
  <div class="flex items-center gap-2 overflow-x-auto py-4 mb-6 border-b border-surface-200/60 no-scrollbar">
    <button
      type="button"
      class="tracker-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-miami-pink text-white border border-miami-pink shadow-neon-pink cursor-pointer transition-all shrink-0"
      data-region="all"
    >
      Tutte le Regioni ({totalCollectibles})
    </button>
    {regions.map((reg) => (
      <button
        type="button"
        class="tracker-filter-btn px-4 py-2 rounded-xl text-xs font-bold bg-surface-200 hover:bg-surface-300 text-gray-300 hover:text-white border border-surface-300 cursor-pointer transition-all shrink-0"
        data-region={reg.id}
      >
        {reg.name.split('&')[0].trim()} ({reg.collectibles.length})
      </button>
    ))}
  </div>

  <!-- Checklist Grid of Items -->
  <div class="space-y-6" id="tracker-items-container">
    {regions.map((region) => (
      <div class="tracker-region-section rounded-2xl bg-surface-50/70 border border-surface-200 p-5" data-region-id={region.id}>
        <div class="flex items-center justify-between mb-4 pb-2 border-b border-surface-200/50">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-miami-cyan"></span>
            <h3 class="text-base font-bold text-white">{region.name}</h3>
            <span class="text-xs text-gray-400 font-normal">({region.category})</span>
          </div>
          <a href={`/leonida/${region.slug}`} class="text-xs text-miami-cyan hover:underline font-semibold">
            Esplora Mappa →
          </a>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          {region.collectibles.map((item) => (
            <label
              class="tracker-item-label flex items-start gap-3 p-3.5 rounded-xl bg-surface-100/90 border border-surface-300 hover:border-miami-pink/40 cursor-pointer transition-all duration-200 select-none group"
              data-item-id={item.id}
            >
              <input
                type="checkbox"
                class="tracker-checkbox w-5 h-5 rounded-md bg-surface-200 border-surface-400 text-miami-pink focus:ring-0 focus:ring-offset-0 cursor-pointer shrink-0 mt-0.5"
                data-id={item.id}
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between gap-2">
                  <span class="tracker-item-title text-sm font-semibold text-white group-hover:text-miami-pink transition-colors">
                    {item.name}
                  </span>
                  <span class="text-[10px] px-2 py-0.5 rounded bg-surface-200 text-miami-cyan font-mono shrink-0">
                    {item.type}
                  </span>
                </div>
                <div class="text-xs text-emerald-400 font-medium mt-1">
                  Ricompensa: <span class="text-gray-300">{item.reward}</span>
                </div>
              </div>
            </label>
          ))}
        </div>
      </div>
    ))}
  </div>

  <!-- Backup & Restore Actions (Safe Anti-Prototype Pollution) -->
  <div class="mt-8 pt-6 border-t border-surface-300 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-gray-400">
    <div>
      <span class="font-bold text-gray-300">Backup Sicuro Dati:</span> Esporta i tuoi progressi o ripristinali su un altro dispositivo.
    </div>
    <div class="flex items-center gap-3">
      <button
        id="tracker-export-btn"
        type="button"
        class="px-4 py-2 rounded-xl bg-surface-200 hover:bg-surface-300 text-white font-bold border border-surface-300 transition-colors cursor-pointer"
      >
        📥 Esporta JSON
      </button>
      <label class="px-4 py-2 rounded-xl bg-surface-200 hover:bg-surface-300 text-white font-bold border border-surface-300 transition-colors cursor-pointer">
        📤 Importa JSON
        <input type="file" id="tracker-import-file" accept=".json" class="hidden" />
      </label>
    </div>
  </div>
</div>

<script>
  function setupCompletionTracker() {
    const STORAGE_KEY = 'leonida_100_tracker';
    const checkboxes = document.querySelectorAll<HTMLInputElement>('.tracker-checkbox');
    const pctEl = document.getElementById('tracker-pct');
    const progressBar = document.getElementById('tracker-progress-bar');
    const countEl = document.getElementById('tracker-count');
    const resetBtn = document.getElementById('tracker-reset-btn');
    const exportBtn = document.getElementById('tracker-export-btn');
    const importInput = document.getElementById('tracker-import-file') as HTMLInputElement | null;
    const filterButtons = document.querySelectorAll<HTMLButtonElement>('.tracker-filter-btn');
    const regionSections = document.querySelectorAll<HTMLElement>('.tracker-region-section');

    const total = checkboxes.length;
    if (total === 0) return;

    // Known whitelist of IDs from DOM
    const whitelist = new Set<string>();
    checkboxes.forEach((cb) => {
      const id = cb.getAttribute('data-id');
      if (id) whitelist.add(id);
    });

    // Safe load function with Anti-Prototype Pollution
    function loadState(): Record<string, boolean> {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return {};
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return {};

        const clean: Record<string, boolean> = {};
        for (const [key, val] of Object.entries(parsed)) {
          // Reject forbidden prototype pollution keys
          if (key === '__proto__' || key === 'constructor' || key === 'prototype') continue;
          // Validate strictly against known items and boolean value
          if (whitelist.has(key) && typeof val === 'boolean') {
            clean[key] = val;
          }
        }
        return clean;
      } catch {
        return {};
      }
    }

    function saveState(state: Record<string, boolean>) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    }

    let state = loadState();

    function updateUI() {
      let checkedCount = 0;

      checkboxes.forEach((cb) => {
        const id = cb.getAttribute('data-id');
        if (!id) return;
        const isChecked = !!state[id];
        cb.checked = isChecked;

        const label = cb.closest('.tracker-item-label');
        if (label) {
          if (isChecked) {
            label.classList.add('bg-emerald-950/40', 'border-emerald-500/50');
            label.classList.remove('bg-surface-100/90', 'border-surface-300');
          } else {
            label.classList.remove('bg-emerald-950/40', 'border-emerald-500/50');
            label.classList.add('bg-surface-100/90', 'border-surface-300');
          }
        }

        if (isChecked) checkedCount++;
      });

      const percentage = Math.round((checkedCount / total) * 100);
      if (pctEl) pctEl.textContent = `${percentage}%`;
      if (progressBar) progressBar.style.width = `${percentage}%`;
      if (countEl) countEl.textContent = `${checkedCount} di ${total} completati`;
    }

    // Attach checkbox changes
    checkboxes.forEach((cb) => {
      cb.addEventListener('change', () => {
        const id = cb.getAttribute('data-id');
        if (!id || !whitelist.has(id)) return;
        state[id] = cb.checked;
        saveState(state);
        updateUI();
      });
    });

    // Reset button
    if (resetBtn) {
      resetBtn.addEventListener('click', () => {
        if (confirm('Sei sicuro di voler azzerare tutti i progressi del tracker di Leonida?')) {
          state = {};
          saveState(state);
          updateUI();
        }
      });
    }

    // Export JSON Backup (Safe Blob)
    if (exportBtn) {
      exportBtn.addEventListener('click', () => {
        const payload = {
          app: 'Leonida Index 100% Tracker',
          exportedAt: new Date().toISOString(),
          progress: state,
        };
        const blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `leonida-tracker-backup-${new Date().toISOString().slice(0, 10)}.json`;
        document.body.appendChild(a);
        a.click();
        document.body.removeChild(a);
        URL.revokeObjectURL(url);
      });
    }

    // Safe Import JSON with strict schema & prototype check
    if (importInput) {
      importInput.addEventListener('change', (e) => {
        const target = e.target as HTMLInputElement;
        const file = target.files?.[0];
        if (!file) return;

        const reader = new FileReader();
        reader.onload = (evt) => {
          try {
            const rawContent = evt.target?.result as string;
            const parsed = JSON.parse(rawContent);

            const importedProgress = parsed.progress || parsed;
            if (!importedProgress || typeof importedProgress !== 'object') {
              alert('File di backup non valido.');
              return;
            }

            const cleanState: Record<string, boolean> = {};
            for (const [k, v] of Object.entries(importedProgress)) {
              if (k === '__proto__' || k === 'constructor' || k === 'prototype') continue;
              if (whitelist.has(k) && typeof v === 'boolean') {
                cleanState[k] = v;
              }
            }

            state = cleanState;
            saveState(state);
            updateUI();
            alert('Progressi del Tracker ripristinati con successo!');
          } catch {
            alert('Errore durante la lettura del file JSON.');
          }
        };
        reader.readAsText(file);
      });
    }

    // Filter by Region logic
    filterButtons.forEach((btn) => {
      btn.addEventListener('click', () => {
        const region = btn.getAttribute('data-region');
        if (!region) return;

        filterButtons.forEach((b) => {
          b.classList.remove('bg-miami-pink', 'text-white', 'border-miami-pink', 'shadow-neon-pink');
          b.classList.add('bg-surface-200', 'text-gray-300', 'border-surface-300');
        });
        btn.classList.add('bg-miami-pink', 'text-white', 'border-miami-pink', 'shadow-neon-pink');
        btn.classList.remove('bg-surface-200', 'text-gray-300', 'border-surface-300');

        regionSections.forEach((sec) => {
          const secRegion = sec.getAttribute('data-region-id');
          if (region === 'all' || secRegion === region) {
            sec.classList.remove('hidden');
          } else {
            sec.classList.add('hidden');
          }
        });
      });
    });

    updateUI();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupCompletionTracker);
  } else {
    setupCompletionTracker();
  }
</script>

