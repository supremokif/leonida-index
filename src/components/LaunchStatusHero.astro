---
// Rockstar Games Official Hero Section
---

<section class="relative w-full min-h-[85vh] sm:min-h-[92vh] flex flex-col items-center justify-between overflow-hidden bg-black text-white select-none">
  <!-- Full-Bleed Key Art Background (Jason & Lucia in Vice City Sunset) -->
  <div class="absolute inset-0 z-0">
    <img
      src="/images/gtavi-standard-edition.jpg"
      alt="Grand Theft Auto VI Key Art Ufficiale"
      class="w-full h-full object-cover object-center opacity-65 scale-100 transform hover:scale-105 transition-transform duration-1000 ease-out"
    />
    <!-- Cinematic Vignette & Gradients identical to rockstargames.com/VI -->
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-black/60"></div>
    <div class="absolute inset-0 bg-radial-vignette pointer-events-none"></div>
  </div>

  <!-- Top Spacing -->
  <div class="pt-8 relative z-10"></div>

  <!-- Center Content: Logo, Tagline, CTAs -->
  <div class="relative z-10 px-4 py-8 flex flex-col items-center text-center max-w-4xl mx-auto">
    <!-- Official VI Logo from rockstargames.com -->
    <div class="w-full max-w-xs sm:max-w-md mb-6 transform hover:scale-105 transition-transform duration-500">
      <img
        src="/images/rockstar-vi-logo.png"
        alt="Grand Theft Auto VI"
        class="w-full h-auto max-h-56 object-contain drop-shadow-[0_10px_35px_rgba(0,0,0,0.9)] mx-auto"
      />
    </div>

    <!-- Official Date Tagline -->
    <div class="text-xs sm:text-base font-mono font-bold tracking-[0.3em] uppercase text-white/90 mb-3 drop-shadow">
      COMING NOVEMBER 19, 2026
    </div>

    <!-- Official Rockstar Synopsis Quote -->
    <p class="text-gray-300 text-xs sm:text-sm max-w-xl mb-8 leading-relaxed font-normal drop-shadow hidden sm:block">
      Vice City, USA. Jason and Lucia have always known the deck is stacked against them. But when an easy score goes wrong, they find themselves on the darkest side of the sunniest place in America.
    </p>

    <!-- CTAs: Pre-Order Now & Watch Trailer -->
    <div class="flex flex-wrap items-center justify-center gap-4 mb-8">
      <a
        href="#pre-order"
        class="px-8 py-4 rounded-xl bg-white hover:bg-[#fdb813] text-black font-black text-xs sm:text-sm font-mono tracking-widest uppercase transition-all duration-300 shadow-2xl hover:scale-105"
      >
        PRE-ORDER NOW
      </a>
      <a
        href="#trailer"
        class="inline-flex items-center gap-2.5 px-7 py-4 rounded-xl bg-black/80 hover:bg-white/10 text-white font-bold text-xs sm:text-sm font-mono tracking-widest uppercase border border-white/20 hover:border-white transition-all duration-300 backdrop-blur-md"
      >
        <svg class="w-4 h-4 fill-current text-white" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
        <span>WATCH TRAILER 1</span>
      </a>
    </div>

    <!-- Official Platforms & "Plays Best On PS5" Badge -->
    <div class="flex flex-wrap items-center justify-center gap-6 text-xs font-mono text-gray-300">
      <div class="flex items-center gap-4">
        <span class="tracking-widest uppercase font-bold text-white">PlayStation® 5</span>
        <span class="text-gray-600">•</span>
        <span class="tracking-widest uppercase font-bold text-white">Xbox Series X|S</span>
      </div>
      
      <!-- Plays Best On PS5 Badge -->
      <div class="flex items-center gap-2 px-3 py-1 rounded bg-black/70 border border-white/15 backdrop-blur-md">
        <span class="text-[10px] font-mono tracking-wider text-gray-400">PLAYS BEST ON</span>
        <span class="text-[11px] font-bold text-white">PLAYSTATION 5</span>
      </div>
    </div>
  </div>

  <!-- Bottom Scroll Bar -->
  <a
    href="#trailer"
    class="relative z-10 pb-6 flex flex-col items-center text-gray-500 hover:text-white transition-colors cursor-pointer group select-none"
    aria-label="Scorri ai contenuti successivi"
  >
    <span class="text-[10px] font-mono tracking-[0.25em] uppercase mb-1.5 group-hover:text-[#fdb813] transition-colors">
      SCROLL FOR MORE CONTENT
    </span>
    <svg class="w-4 h-4 animate-bounce text-gray-400 group-hover:text-[#fdb813] transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </a>
</section>
