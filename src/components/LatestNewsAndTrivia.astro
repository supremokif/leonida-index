---

<section id="news-trivia" class="my-20 scroll-mt-24 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Notizie e Curiosità Ufficiali">
  <!-- Section Title -->
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-white/10">
    <div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-amber-400/40 text-[11px] font-mono font-bold text-amber-400 uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>ARCHIVIO VERIFICATO // ZERO RUMOR, SOLO FATTI REALI</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        ULTIME NOTIZIE &amp; <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">CURIOSITÀ</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-2 max-w-2xl font-normal leading-relaxed">
        Tutte le notizie ufficiali confermate, i record mondiali e le curiosità autentiche su Grand Theft Auto VI verificate alla fonte.
      </p>
    </div>

    <!-- Filter Buttons Bar -->
    <div class="flex items-center gap-2 overflow-x-auto pb-2 no-scrollbar" role="tablist">
      <button
        type="button"
        class="news-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-bold tracking-wider uppercase bg-white text-black cursor-pointer transition-all shrink-0 shadow-lg"
        data-category="all"
      >
        TUTTO ({feedItems.length})
      </button>
      <button
        type="button"
        class="news-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-bold tracking-wider uppercase bg-[#140f26] text-gray-300 hover:text-white border border-white/10 hover:border-amber-400/40 cursor-pointer transition-all shrink-0"
        data-category="news"
      >
        NOTIZIE UFFICIALI
      </button>
      <button
        type="button"
        class="news-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-bold tracking-wider uppercase bg-[#140f26] text-gray-300 hover:text-white border border-white/10 hover:border-amber-400/40 cursor-pointer transition-all shrink-0"
        data-category="trivia"
      >
        CURIOSITÀ REALI
      </button>
      <button
        type="button"
        class="news-filter-btn px-4 py-2 rounded-xl text-xs font-mono font-bold tracking-wider uppercase bg-[#140f26] text-gray-300 hover:text-white border border-white/10 hover:border-amber-400/40 cursor-pointer transition-all shrink-0"
        data-category="tech"
      >
        TECNOLOGIA RAGE
      </button>
    </div>
  </div>

  <!-- Cards Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6" id="news-grid">
    {feedItems.map((item) => (
      <article
        class="taste-card news-card group flex flex-col justify-between overflow-hidden"
        data-category={item.category}
      >
        <!-- Card Image & Badge -->
        <div class="taste-frame relative w-full aspect-[16/10] bg-[#151026] rounded-t-3xl">
          <img
            src={resolvePath(item.image)}
            alt={item.title}
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent pointer-events-none"></div>
          
          <div class="absolute top-3 left-3 px-2.5 py-1 rounded-lg bg-black/80 backdrop-blur-md border text-[9px] font-mono font-bold uppercase tracking-wider shadow-lg flex items-center gap-1.5 border-white/15 text-white">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>{item.badge}</span>
          </div>
        </div>

        <!-- Content Body -->
        <div class="p-5 flex-1 flex flex-col justify-between">
          <div>
            <div class="flex items-center justify-between text-[10px] font-mono text-gray-400 mb-2">
              <span class={`px-2 py-0.5 rounded border text-[9px] font-bold uppercase ${item.categoryColor}`}>
                {item.categoryLabel}
              </span>
              <span>{item.date}</span>
            </div>

            <h3 class="text-base font-black text-white group-hover:text-amber-400 transition-colors mb-2.5 leading-snug line-clamp-2">
              {item.title}
            </h3>

            <p class="text-xs text-gray-300 line-clamp-3 leading-relaxed font-normal mb-4">
              {item.summary}
            </p>
          </div>

          <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono">
            <span class="text-gray-400 text-[10px] truncate max-w-[140px]">FONTE: {item.source}</span>
            <span class="text-amber-400 font-bold group-hover:translate-x-1 transition-transform">
              DETTAGLI ➔
            </span>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<script>
  function setupNewsFilter() {
    const filterBtns = document.querySelectorAll<HTMLButtonElement>('.news-filter-btn');
    const cards = document.querySelectorAll<HTMLElement>('.news-card');

    filterBtns.forEach((btn) => {
      btn.addEventListener('click', () => {
        const cat = btn.getAttribute('data-category') || 'all';

        filterBtns.forEach((b) => {
          b.classList.remove('bg-white', 'text-black', 'shadow-lg');
          b.classList.add('bg-[#140f26]', 'text-gray-300');
        });
        btn.classList.add('bg-white', 'text-black', 'shadow-lg');
        btn.classList.remove('bg-[#140f26]', 'text-gray-300');

        cards.forEach((card) => {
          const cardCat = card.getAttribute('data-category');
          if (cat === 'all' || cardCat === cat) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupNewsFilter();
  document.addEventListener('astro:page-load', setupNewsFilter);
</script>
