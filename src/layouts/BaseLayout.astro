---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import db from '../data/gta6_db.json';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  canonicalPath = '',
  ogImage = '/og-card.svg',
  breadcrumbs = [],
} = Astro.props;

const siteUrl = 'https://leonidaindex.com';
const canonicalUrl = `${siteUrl}${canonicalPath}`;
const formattedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

function safeJsonLd(obj: unknown): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');
}

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: siteUrl,
  },
  ...breadcrumbs.map((b, idx) => ({
    '@type': 'ListItem',
    position: idx + 2,
    name: b.name,
    item: b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}`,
  })),
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Leonida Index - GTA VI Official Launch & Intelligence Hub',
      description: 'Portale e web-app indipendente su Grand Theft Auto VI: orari di sblocco, conto alla rovescia, archivio trailer, tracker 100% e mappa di Leonida.',
      inLanguage: 'it-IT',
    },
    {
      '@type': 'VideoGame',
      '@id': `${siteUrl}/#game`,
      name: db.releaseInfo.gameTitle,
      alternateName: ['GTA 6', 'GTA VI', 'Grand Theft Auto 6'],
      description: 'Grand Theft Auto VI è il nuovo videogioco open world di Rockstar Games ambientato nello Stato di Leonida, in uscita il 19 Novembre 2026.',
      datePublished: db.releaseInfo.releaseDate,
      gamePlatform: db.releaseInfo.platforms,
      publisher: {
        '@type': 'Organization',
        name: db.releaseInfo.developer,
        url: 'https://www.rockstargames.com',
      },
      genre: ['Action-adventure', 'Open World', 'Crime Simulation'],
      inLanguage: 'it-IT',
      image: `${siteUrl}/og-card.svg`,
      operatingSystem: 'PlayStation 5 OS, Xbox OS',
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      name: 'Leonida Index - GTA VI 100% Completion Tracker & Storage Calculator',
      url: siteUrl,
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'All Modern Browsers',
      browserRequirements: 'Requires JavaScript. Requires HTML5.',
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/#trailers`,
      name: 'Archivio Trailer Ufficiali Grand Theft Auto VI',
      itemListElement: db.trailers.map((t, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'VideoObject',
          name: t.title,
          description: t.summary,
          uploadDate: `${t.publishDate}T12:00:00Z`,
          duration: `PT${Math.floor(t.durationSeconds / 60)}M${t.durationSeconds % 60}S`,
          thumbnailUrl: t.youtubeId.startsWith('launch-') || t.youtubeId === 'OFFICIAL_ROCKSTAR_NEWSWIRE'
            ? `${siteUrl}/og-card.svg`
            : `https://i.ytimg.com/vi/${t.youtubeId}/maxresdefault.jpg`,
          embedUrl: t.youtubeId.startsWith('launch-') || t.youtubeId === 'OFFICIAL_ROCKSTAR_NEWSWIRE'
            ? 'https://www.rockstargames.com/VI'
            : `https://www.youtube-nocookie.com/embed/${t.youtubeId}`,
        },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: db.releaseInfo.faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}/#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
  ],
};

const currentPath = Astro.url.pathname;
const navItems = [
  { href: '/', label: 'HUB' },
  { href: '/tracker', label: '100% TRACKER' },
  { href: '/storage-calculator', label: 'CALCOLO SSD' },
  { href: '/trailers/trailer-1', label: 'TRAILER (7)' },
  { href: '/leonida/vice-city', label: 'MAPPA LEONIDA' },
  { href: '/legal', label: 'DISCLAIMER' },
];
---

<!doctype html>
<html lang="it" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07050d" />
    <meta name="color-scheme" content="dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Technical SEO -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Leonida Index Intelligence Group" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={formattedOgImage} />
    <meta property="og:site_name" content="Leonida Index" />
    <meta property="og:locale" content="it_IT" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={formattedOgImage} />

    <!-- Direct Endpoints Discovery -->
    <link rel="help" type="text/plain" href="/llms.txt" title="Canonical LLM Brief" />
    <link rel="alternate" type="text/plain" href="/llms-full.txt" title="Full LLM Knowledge Base" />
    <link rel="alternate" type="application/json" href="/api/gta6-facts.json" title="Verified Facts API" />

    <!-- Resource Preconnects -->
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />

    <!-- Google Consent Mode v2 Default Script -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied'
      });
    </script>

    <!-- Schema.org JSON-LD Sanitized Graph -->
    <script type="application/ld+json" set:html={safeJsonLd(schemaGraph)} />
  </head>
  <body class="bg-background text-gray-100 min-h-screen flex flex-col font-sans antialiased selection:bg-vice-pink selection:text-white relative">
    
    <!-- Top Ambient Sunset Flare -->
    <div class="fixed top-0 inset-x-0 h-40 pointer-events-none bg-gradient-to-b from-vice-pink/15 via-vice-orange/5 to-transparent blur-2xl z-0"></div>

    <!-- Main Navigation Header -->
    <header class="sticky top-0 z-40 w-full bg-[#07050d]/80 backdrop-blur-2xl border-b border-white/[0.08] shadow-2xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        
        <!-- Authentic Vice City Brandmark -->
        <a href="/" class="flex items-center gap-3.5 group select-none">
          <!-- Neon Badge Emblem -->
          <div class="relative w-11 h-11 rounded-2xl bg-gradient-to-br from-vice-pink via-vice-orange to-vice-cyan p-[1.5px] shadow-neon-pink group-hover:scale-105 transition-transform duration-300">
            <div class="w-full h-full bg-[#0d0a1a] rounded-[14px] flex items-center justify-center font-black text-xl tracking-tighter">
              <span class="bg-gradient-to-r from-vice-pink to-vice-cyan bg-clip-text text-transparent group-hover:drop-shadow-[0_0_8px_rgba(255,0,122,0.8)] transition-all">
                VI
              </span>
            </div>
            <!-- Neon ping dot -->
            <div class="absolute -top-1 -right-1 w-3 h-3 bg-vice-cyan rounded-full shadow-[0_0_8px_#00f0ff] animate-pulse"></div>
          </div>

          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span class="text-xl sm:text-2xl font-black tracking-tight text-white group-hover:text-vice-pink transition-colors">
                LEONIDA<span class="text-vice-cyan">INDEX</span>
              </span>
              <span class="text-[9px] font-mono font-bold px-1.5 py-0.5 rounded bg-vice-pink/20 border border-vice-pink/40 text-vice-pink uppercase tracking-widest hidden sm:inline-block">
                VICE CITY
              </span>
            </div>
            <span class="text-[10px] uppercase font-mono tracking-widest text-gray-400 font-medium">
              Grand Theft Auto VI Intelligence
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Items -->
        <nav class="hidden lg:flex items-center gap-1 bg-[#140f26]/60 p-1.5 rounded-2xl border border-white/[0.08] backdrop-blur-md" aria-label="Navigazione principale">
          {navItems.map((item) => {
            const isActive = currentPath === item.href || (item.href !== '/' && currentPath.startsWith(item.href));
            return (
              <a
                href={item.href}
                class={`px-3.5 py-1.5 rounded-xl text-xs font-mono font-bold tracking-wider transition-all duration-200 ${
                  isActive
                    ? 'bg-gradient-to-r from-vice-pink to-vice-orange text-white shadow-neon-pink'
                    : 'text-gray-300 hover:text-white hover:bg-white/[0.06]'
                }`}
              >
                {item.label}
              </a>
            );
          })}
        </nav>

        <!-- Right Quick Action / Pre-load status -->
        <div class="hidden sm:flex items-center gap-3">
          <div class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-surface-100 border border-white/[0.08] text-xs font-mono">
            <span class="w-2 h-2 rounded-full bg-emerald-400 shadow-[0_0_8px_#34d399] animate-pulse"></span>
            <span class="text-gray-300">PRE-LOAD: <strong class="text-emerald-400">228.5 GB</strong></span>
          </div>

          <a
            href="/storage-calculator"
            class="flex items-center gap-1.5 px-4 py-2 rounded-xl bg-gradient-to-r from-vice-pink via-vice-orange to-vice-pink bg-[length:200%_auto] hover:bg-right text-white text-xs font-bold font-mono tracking-wider shadow-neon-pink hover:scale-105 transition-all duration-300"
          >
            <svg class="w-3.5 h-3.5 text-vice-gold" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/></svg>
            <span>TEST SSD</span>
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-nav-toggle"
          type="button"
          class="lg:hidden p-2.5 rounded-xl bg-surface-100 text-gray-300 hover:text-white border border-white/[0.08] focus:outline-none cursor-pointer"
          aria-label="Apri menu di navigazione"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div id="mobile-nav-menu" class="hidden lg:hidden px-4 pt-2 pb-6 bg-[#0d0a1a]/95 border-b border-white/[0.08] backdrop-blur-2xl">
        <div class="flex flex-col gap-2">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="px-4 py-3 rounded-xl text-xs font-mono font-bold tracking-wider text-gray-300 hover:text-white hover:bg-surface-200 transition-colors"
            >
              {item.label}
            </a>
          ))}
          <div class="pt-3 border-t border-white/[0.08] flex flex-col gap-2">
            <a
              href="/storage-calculator"
              class="w-full text-center px-4 py-3 rounded-xl bg-gradient-to-r from-vice-pink to-vice-orange text-white text-xs font-bold font-mono tracking-wider shadow-neon-pink"
            >
              CALCOLA SPAZIO SSD (228.5 GB)
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Container with Subtle Side Palm Glows -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 relative z-10">
      <slot />
    </main>

    <!-- Ultra-Sleek Editorial Footer -->
    <footer class="mt-auto border-t border-white/[0.08] bg-[#07050d] text-gray-400 relative overflow-hidden">
      <!-- Ambient Sunset Mesh at Footer bottom -->
      <div class="absolute bottom-0 inset-x-0 h-48 pointer-events-none bg-gradient-to-t from-vice-pink/10 via-vice-cyan/5 to-transparent blur-3xl z-0"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          
          <!-- Col 1: Brand & Identity -->
          <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-vice-pink to-vice-cyan p-[1px] shadow-neon-pink">
                <div class="w-full h-full bg-[#0d0a1a] rounded-[11px] flex items-center justify-center font-black text-sm text-transparent bg-clip-text bg-gradient-to-r from-vice-pink to-vice-cyan">
                  VI
                </div>
              </div>
              <span class="text-xl font-black text-white tracking-tight">
                LEONIDA<span class="text-vice-cyan">INDEX</span>
              </span>
            </div>

            <p class="text-xs sm:text-sm text-gray-400 max-w-md leading-relaxed mb-6 font-normal">
              Archivio indipendente e hub di lancio dedicato a <strong>Grand Theft Auto VI</strong> nello Stato di Leonida. Cronologia trailer ufficiali, checklist 100%, telemetria hardware e orari di sblocco mondiali per il <strong>19 Novembre 2026</strong>.
            </p>

            <div class="flex flex-wrap items-center gap-3 text-[11px] font-mono text-gray-400">
              <span class="px-2.5 py-1 rounded-lg bg-surface-100 border border-white/[0.08] text-emerald-400 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                ZERO SERVER RUNTIME
              </span>
              <span class="px-2.5 py-1 rounded-lg bg-surface-100 border border-white/[0.08] text-vice-cyan">
                STRICT CSP &amp; HSTS
              </span>
              <span class="px-2.5 py-1 rounded-lg bg-surface-100 border border-white/[0.08] text-vice-pink">
                GDPR CONSENT MODE V2
              </span>
            </div>
          </div>

          <!-- Col 2: Hub Navigation -->
          <div>
            <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-white mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-pink"></span>
              SEZIONI PORTALE
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm">
              <li><a href="/" class="hover:text-vice-pink transition-colors">Home &amp; Countdown Ufficiale</a></li>
              <li><a href="/tracker" class="hover:text-vice-pink transition-colors">Leonida 100% Completion Tracker</a></li>
              <li><a href="/storage-calculator" class="hover:text-vice-pink transition-colors">Calcolatore Spazio SSD Console</a></li>
              <li><a href="/trailers/trailer-1" class="hover:text-vice-pink transition-colors">Archivio 7 Trailer e Showcase</a></li>
              <li><a href="/leonida/vice-city" class="hover:text-vice-pink transition-colors">Mappa e Luoghi di Vice City</a></li>
              <li><a href="/legal" class="hover:text-vice-pink transition-colors">Note Legali &amp; Disclaimer</a></li>
            </ul>
          </div>

          <!-- Col 3: AI Search & Manifests -->
          <div>
            <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-white mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-cyan"></span>
              INGEGNERIA GEO &amp; AI
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm font-mono">
              <li>
                <a href="/llms.txt" target="_blank" class="flex items-center gap-2 text-vice-cyan hover:underline">
                  <span>/llms.txt</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-surface-200 text-gray-300">GEO AI</span>
                </a>
              </li>
              <li>
                <a href="/llms-full.txt" target="_blank" class="flex items-center gap-2 text-vice-cyan hover:underline">
                  <span>/llms-full.txt</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-surface-200 text-gray-300">FULL KB</span>
                </a>
              </li>
              <li>
                <a href="/api/gta6-facts.json" target="_blank" class="flex items-center gap-2 text-vice-pink hover:underline">
                  <span>/api/gta6-facts.json</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-surface-200 text-gray-300">API</span>
                </a>
              </li>
              <li>
                <a href="/robots.txt" target="_blank" class="text-gray-300 hover:text-white transition-colors">
                  Robots.txt (AI Crawlers)
                </a>
              </li>
              <li>
                <a href="/.well-known/security.txt" target="_blank" class="text-gray-300 hover:text-white transition-colors">
                  Security.txt (RFC 9116)
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Take-Two Interactive & Rockstar Legal Shield -->
        <div class="pt-8 border-t border-white/[0.08] text-[11px] text-gray-400 space-y-2.5 leading-relaxed">
          <p>
            <strong>DISCLAIMER COMMERCIALE E COPYRIGHT:</strong> Leonida Index (leonidaindex.com) è un progetto editoriale indipendente non ufficiale. Non è affiliato, sponsorizzato, approvato né associato a Rockstar Games, Take-Two Interactive Software, Inc., Sony Interactive Entertainment o Microsoft Corporation.
          </p>
          <p>
            Grand Theft Auto, GTA VI, GTA 6, Vice City, Leonida e i rispettivi loghi e marchi figurativi appartengono a Take-Two Interactive Software, Inc. e Rockstar Games, Inc. L'uso dei contenuti è svolto a puro scopo informativo e di cronaca nel quadro del Fair Use.
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-between pt-3 text-gray-400">
            <span>© 2026 Leonida Index. Progettato con passione per la community di Vice City.</span>
            <div class="flex items-center gap-4 mt-2 sm:mt-0 font-mono text-[10px]">
              <a href="/legal" class="hover:text-vice-pink transition-colors">PRIVACY POLICY</a>
              <span>•</span>
              <a href="/legal#affiliate" class="hover:text-vice-cyan transition-colors">AFFILIATE DISCLOSURE</a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- GDPR Privacy Banner -->
    <ConsentBanner />

    <!-- Mobile Nav Script -->
    <script>
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const menu = document.getElementById('mobile-nav-menu');

      if (toggleBtn && menu) {
        toggleBtn.addEventListener('click', () => {
          const isHidden = menu.classList.contains('hidden');
          if (isHidden) {
            menu.classList.remove('hidden');
            toggleBtn.setAttribute('aria-expanded', 'true');
          } else {
            menu.classList.add('hidden');
            toggleBtn.setAttribute('aria-expanded', 'false');
          }
        });
      }
    </script>
  </body>
</html>
