---
import '../styles/global.css';
import ConsentBanner from '../components/ConsentBanner.astro';
import LanguageSwitcher from '../components/LanguageSwitcher.astro';
import db from '../data/gta6_db.json';
import { resolvePath } from '../utils/paths';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  ogImage?: string;
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  canonicalPath = '',
  ogImage = '/og-card.svg',
  breadcrumbs = [],
} = Astro.props;

const siteOrigin = Astro.site ? Astro.site.origin : 'https://gta6leonida.it';
const base = (import.meta.env.BASE_URL || '/').replace(/\/+$/, '');
const siteUrl = `${siteOrigin}${base}`;
const canonicalUrl = `${siteUrl}${canonicalPath.startsWith('/') ? canonicalPath : `/${canonicalPath}`}`;
const formattedOgImage = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage.startsWith('/') ? ogImage : `/${ogImage}`}`;

function safeJsonLd(obj: unknown): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/&/g, '\\u0026');
}

const breadcrumbItems = [
  {
    '@type': 'ListItem',
    position: 1,
    name: 'Home',
    item: siteUrl,
  },
  ...breadcrumbs.map((b, idx) => ({
    '@type': 'ListItem',
    position: idx + 2,
    name: b.name,
    item: b.url.startsWith('http') ? b.url : `${siteUrl}${b.url}`,
  })),
];

const schemaGraph = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}/#website`,
      url: siteUrl,
      name: 'Leonida Index - GTA VI Fan Database & Community Portal',
      description: 'Portale e web-app indipendente su Grand Theft Auto VI: orari di sblocco, conto alla rovescia, archivio trailer, tracker 100% e mappa di Leonida.',
      inLanguage: 'it-IT',
    },
    {
      '@type': 'VideoGame',
      '@id': `${siteUrl}/#game`,
      name: db.releaseInfo.gameTitle,
      alternateName: ['GTA 6', 'GTA VI', 'Grand Theft Auto 6'],
      description: 'Grand Theft Auto VI è il nuovo videogioco open world di Rockstar Games ambientato nello Stato di Leonida, in uscita il 19 Novembre 2026.',
      datePublished: db.releaseInfo.releaseDate,
      gamePlatform: db.releaseInfo.platforms,
      publisher: {
        '@type': 'Organization',
        name: db.releaseInfo.developer,
        url: 'https://www.rockstargames.com',
      },
      genre: ['Action-adventure', 'Open World', 'Crime Simulation'],
      inLanguage: 'it-IT',
      image: `${siteUrl}/og-card.svg`,
      operatingSystem: 'PlayStation 5 OS, Xbox OS',
    },
    {
      '@type': 'WebApplication',
      '@id': `${siteUrl}/#webapp`,
      name: 'Leonida Index - GTA VI 100% Completion Tracker & Storage Calculator',
      url: siteUrl,
      applicationCategory: 'UtilityApplication',
      operatingSystem: 'All Modern Browsers',
      browserRequirements: 'Requires JavaScript. Requires HTML5.',
    },
    {
      '@type': 'ItemList',
      '@id': `${siteUrl}/#trailers`,
      name: 'Archivio Trailer Ufficiali Grand Theft Auto VI',
      itemListElement: db.trailers.map((t, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        item: {
          '@type': 'VideoObject',
          name: t.title,
          description: t.summary,
          uploadDate: `${t.publishDate}T12:00:00Z`,
          duration: `PT${Math.floor(t.durationSeconds / 60)}M${t.durationSeconds % 60}S`,
          thumbnailUrl: `https://i.ytimg.com/vi/${t.youtubeId}/maxresdefault.jpg`,
          embedUrl: `https://www.youtube-nocookie.com/embed/${t.youtubeId}`,
        },
      })),
    },
    {
      '@type': 'FAQPage',
      '@id': `${siteUrl}/#faq`,
      mainEntity: db.releaseInfo.faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: f.answer,
        },
      })),
    },
    {
      '@type': 'BreadcrumbList',
      '@id': `${canonicalUrl}/#breadcrumb`,
      itemListElement: breadcrumbItems,
    },
  ],
};

const currentPath = Astro.url.pathname;
const navItems = [
  { href: resolvePath('/#overview'), label: 'PANORAMICA', i18nKey: 'nav.overview' },
  { href: resolvePath('/#trailer'), label: 'TRAILER', i18nKey: 'nav.trailers' },
  { href: resolvePath('/#news-trivia'), label: 'NOTIZIE', i18nKey: 'nav.news' },
  { href: resolvePath('/#pre-order'), label: 'EDIZIONI', i18nKey: 'nav.editions' },
  { href: resolvePath('/#gallery'), label: 'SCREENSHOT 4K', i18nKey: 'nav.screenshots' },
  { href: resolvePath('/#leonida'), label: 'MAPPA LEONIDA', i18nKey: 'nav.leonida' },
  { href: resolvePath('/tracker'), label: 'TRACKER ESPLORATIVO', i18nKey: 'nav.tracker' },
  { href: resolvePath('/storage-calculator'), label: 'CALCOLATORE SSD', i18nKey: 'nav.storage' },
];
---

<!doctype html>
<html lang="it" data-type="software" data-radius="soft" data-buttons="solid" data-motion="on" class="dark scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#07050d" />
    <meta name="color-scheme" content="dark" />
    <meta name="page-type" content="software" />
    <meta name="site-kind" content="gaming" />

    <!-- Cybersecurity & Defense in Depth Headers -->
    <meta http-equiv="X-Content-Type-Options" content="nosniff" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta http-equiv="Content-Security-Policy" content="default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https://i.ytimg.com https://img.youtube.com; frame-src 'self' https://www.youtube-nocookie.com; connect-src 'self'; font-src 'self' data: https://fonts.gstatic.com; object-src 'none'; base-uri 'self'; upgrade-insecure-requests;" />

    <!-- Google Fonts: Archivo (Bold Display) & Martian Mono (Technical Gaming) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,400..700&family=Martian+Mono:wght@400..600&display=swap" rel="stylesheet" />

    <link rel="icon" type="image/svg+xml" href={resolvePath('/favicon.svg')} />
    <link rel="manifest" href={resolvePath('/site.webmanifest')} />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="GTA 6 Hub" />
    <link rel="canonical" href={canonicalUrl} />

    <!-- Technical SEO & Ranking Signals -->
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content="GTA 6, Grand Theft Auto VI, GTA VI, Rockstar Games, data uscita GTA 6, trailer GTA 6, Lucia e Jason, Vice City, Leonida, PS5, Xbox Series X, screenshot 4K GTA 6, pre-order GTA 6" />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Leonida Index Community" />
    <meta name="generator" content={Astro.generator} />
    <meta name="google-site-verification" content="google116fd0d9acedbcf0" />

    <!-- Core Web Vitals LCP Preloading -->
    <link rel="preload" as="image" href={resolvePath('/images/gtavi-standard-edition.jpg')} fetchpriority="high" />
    <link rel="preload" as="image" href={resolvePath('/images/rockstar-vi-logo.png')} fetchpriority="high" />

    <!-- Open Graph / Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={formattedOgImage} />
    <meta property="og:site_name" content="Leonida Index - GTA 6 Fan Portal" />
    <meta property="og:locale" content="it_IT" />

    <!-- Twitter Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content={canonicalUrl} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={formattedOgImage} />

    <!-- Direct Endpoints Discovery -->
    <link rel="alternate" type="application/rss+xml" title="GTA 6 Leonida Index RSS Feed" href={resolvePath('/rss.xml')} />
    <link rel="help" type="text/plain" href={resolvePath('/llms.txt')} title="Canonical LLM Brief" />
    <link rel="alternate" type="text/plain" href={resolvePath('/llms-full.txt')} title="Full LLM Knowledge Base" />
    <link rel="alternate" type="application/json" href={resolvePath('/api/gta6-facts.json')} title="Verified Facts API" />

    <!-- Resource Preconnects -->
    <link rel="preconnect" href="https://i.ytimg.com" crossorigin />
    <link rel="preconnect" href="https://www.youtube-nocookie.com" />

    <!-- Google Consent Mode v2 Default Script -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        'ad_storage': 'denied',
        'analytics_storage': 'denied',
        'ad_user_data': 'denied',
        'ad_personalization': 'denied'
      });
    </script>

    <!-- Schema.org JSON-LD Sanitized Graph -->
    <script type="application/ld+json" set:html={safeJsonLd(schemaGraph)} />
  </head>
  <body class="bg-black text-gray-100 min-h-screen flex flex-col font-sans antialiased selection:bg-[#fdb813] selection:text-black relative">
    
    <!-- Top Ambient Sunset Flare -->
    <div class="fixed top-0 inset-x-0 h-32 pointer-events-none bg-gradient-to-b from-[#fdb813]/10 via-transparent to-transparent blur-2xl z-0"></div>

    <!-- Main Navigation Header (Rockstar Games Official Style) -->
    <header class="sticky top-0 z-40 w-full bg-black/90 backdrop-blur-2xl border-b border-white/10 shadow-2xl">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-20 flex items-center justify-between gap-4">
        
        <!-- Authentic Brandmark with Rockstar R* Gold Emblem -->
        <a href={resolvePath('/')} class="flex items-center gap-3.5 group select-none">
          <!-- Rockstar R* Star Emblem -->
          <div class="w-10 h-10 rounded-xl bg-[#fdb813] flex items-center justify-center text-black font-black text-sm font-mono shadow-[0_0_15px_rgba(253,184,19,0.5)] group-hover:scale-105 transition-transform duration-300">
            R★
          </div>

          <div class="flex flex-col">
            <div class="flex items-center gap-2">
              <span class="text-xl sm:text-2xl font-black tracking-tight text-white group-hover:text-[#fdb813] transition-colors uppercase font-sans">
                GRAND THEFT AUTO <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">VI</span>
              </span>
            </div>
            <span data-i18n="nav.community_badge" class="text-[9px] uppercase font-mono tracking-widest text-vice-pink font-semibold">
              PORTALE COMMUNITY FAN • DATABASE LEONIDA
            </span>
          </div>
        </a>

        <!-- Desktop Navigation Items -->
        <nav class="hidden lg:flex items-center gap-1 bg-[#121212]/80 p-1.5 rounded-2xl border border-white/10 backdrop-blur-md" aria-label="Navigazione principale">
          {navItems.map((item) => {
            const isActive = currentPath === item.href;
            return (
              <a
                href={item.href}
                class={`px-3 py-1.5 rounded-xl text-xs font-mono font-bold tracking-wider transition-all duration-200 ${
                  isActive
                    ? 'bg-white text-black shadow-lg'
                    : 'text-gray-300 hover:text-white hover:bg-white/10'
                }`}
              >
                <span data-i18n={item.i18nKey}>{item.label}</span>
              </a>
            );
          })}
        </nav>

        <!-- Right Quick Action / Language Switcher & Pre-Order Button -->
        <div class="hidden sm:flex items-center gap-3">
          <LanguageSwitcher />

          <a
            href={resolvePath('/#launch-countdown')}
            class="flex items-center gap-2 px-3 py-1.5 rounded-xl bg-zinc-900 hover:bg-zinc-800 border border-white/10 hover:border-[#fdb813]/40 text-xs font-mono transition-colors"
            title="Visualizza il conto alla rovescia in tempo reale"
          >
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span class="text-gray-300 hover:text-white font-bold">19 NOV 2026</span>
          </a>

          <a
            href={resolvePath('/#pre-order')}
            data-i18n="nav.preorder_btn"
            class="px-5 py-2.5 rounded-xl bg-white hover:bg-[#fdb813] text-black font-black text-xs font-mono tracking-widest uppercase transition-all duration-300 shadow-xl hover:scale-105"
          >
            PRE-ORDINA ORA
          </a>
        </div>

        <!-- Mobile Menu Toggle Button -->
        <button
          id="mobile-nav-toggle"
          type="button"
          class="lg:hidden p-2.5 rounded-xl bg-zinc-900 text-gray-300 hover:text-white border border-white/10 focus:outline-none cursor-pointer"
          aria-label="Apri menu di navigazione"
          aria-expanded="false"
        >
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7"></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Dropdown -->
      <div id="mobile-nav-menu" class="hidden lg:hidden px-4 pt-2 pb-6 bg-black/95 border-b border-white/10 backdrop-blur-2xl">
        <div class="flex flex-col gap-2">
          {navItems.map((item) => (
            <a
              href={item.href}
              class="px-4 py-3 rounded-xl text-xs font-mono font-bold tracking-wider text-gray-300 hover:text-white hover:bg-zinc-900 transition-colors"
            >
              <span data-i18n={item.i18nKey}>{item.label}</span>
            </a>
          ))}
          <div class="pt-3 border-t border-white/10 flex flex-col gap-3">
            <div class="flex items-center justify-between px-2">
              <span class="text-xs font-mono text-gray-400">Lingua / Language:</span>
              <LanguageSwitcher />
            </div>
            <a
              href={resolvePath('/#pre-order')}
              data-i18n="nav.preorder_btn"
              class="w-full text-center px-4 py-3 rounded-xl bg-white text-black text-xs font-bold font-mono tracking-wider shadow-lg"
            >
              PRE-ORDINA ORA
            </a>
          </div>
        </div>
      </div>
    </header>

    <!-- Main Content Container with Subtle Side Palm Glows -->
    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-6 sm:py-10 relative z-10">
      <slot />
    </main>

    <!-- Ultra-Sleek Editorial Footer -->
    <footer class="mt-auto border-t border-white/[0.08] bg-[#07050d] text-gray-400 relative overflow-hidden">
      <!-- Ambient Sunset Mesh at Footer bottom -->
      <div class="absolute bottom-0 inset-x-0 h-48 pointer-events-none bg-gradient-to-t from-vice-pink/10 via-vice-cyan/5 to-transparent blur-3xl z-0"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 relative z-10">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-10 mb-12">
          
          <!-- Col 1: Brand & Identity -->
          <div class="md:col-span-2">
            <div class="flex items-center gap-3 mb-4">
              <div class="w-9 h-9 rounded-xl bg-gradient-to-br from-vice-pink to-vice-cyan p-[1px] shadow-neon-pink">
                <div class="w-full h-full bg-[#0d0a1a] rounded-[11px] flex items-center justify-center font-black text-sm text-transparent bg-clip-text bg-gradient-to-r from-vice-pink to-vice-cyan">
                  VI
                </div>
              </div>
              <span class="text-xl font-black text-white tracking-tight">
                LEONIDA<span class="text-vice-cyan">INDEX</span>
              </span>
            </div>

            <p class="text-xs sm:text-sm text-gray-400 max-w-md leading-relaxed mb-6 font-normal">
              Archivio indipendente e hub di lancio dedicato a <strong>Grand Theft Auto VI</strong> nello Stato di Leonida. Cronologia trailer ufficiali, checklist 100%, telemetria hardware e orari di sblocco mondiali per il <strong>19 Novembre 2026</strong>.
            </p>

            <div class="flex flex-wrap items-center gap-3 text-[11px] font-mono text-gray-400">
              <span class="px-2.5 py-1 rounded-lg bg-surface-100 border border-white/[0.08] text-emerald-400 flex items-center gap-1.5">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                ZERO SERVER RUNTIME
              </span>
              <span class="px-2.5 py-1 rounded-lg bg-surface-100 border border-white/[0.08] text-vice-cyan">
                STRICT CSP &amp; HSTS
              </span>
              <span class="px-2.5 py-1 rounded-lg bg-surface-100 border border-white/[0.08] text-vice-pink">
                GDPR CONSENT MODE V2
              </span>
            </div>
          </div>

          <!-- Col 2: Hub Navigation -->
          <div>
            <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-white mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-pink"></span>
              SEZIONI PORTALE
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm">
              <li><a href={resolvePath('/')} class="hover:text-vice-pink transition-colors">Home &amp; Countdown Ufficiale</a></li>
              <li><a href={resolvePath('/tracker')} class="hover:text-vice-pink transition-colors">Leonida 100% Completion Tracker</a></li>
              <li><a href={resolvePath('/storage-calculator')} class="hover:text-vice-pink transition-colors">Calcolatore Spazio SSD Console</a></li>
              <li><a href={resolvePath('/trailers/trailer-1')} class="hover:text-vice-pink transition-colors">Archivio 7 Trailer e Showcase</a></li>
              <li><a href={resolvePath('/leonida/vice-city')} class="hover:text-vice-pink transition-colors">Mappa e Luoghi di Vice City</a></li>
              <li><a href={resolvePath('/legal')} class="hover:text-vice-pink transition-colors">Note Legali &amp; Disclaimer</a></li>
            </ul>
          </div>

          <!-- Col 3: AI Search & Manifests -->
          <div>
            <h4 class="text-xs font-mono font-bold uppercase tracking-widest text-white mb-4 flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-cyan"></span>
              INGEGNERIA GEO &amp; AI
            </h4>
            <ul class="space-y-2.5 text-xs sm:text-sm font-mono">
              <li>
                <a href={resolvePath('/llms.txt')} target="_blank" class="flex items-center gap-2 text-vice-cyan hover:underline">
                  <span>/llms.txt</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-surface-200 text-gray-300">GEO AI</span>
                </a>
              </li>
              <li>
                <a href={resolvePath('/llms-full.txt')} target="_blank" class="flex items-center gap-2 text-vice-cyan hover:underline">
                  <span>/llms-full.txt</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-surface-200 text-gray-300">FULL KB</span>
                </a>
              </li>
              <li>
                <a href={resolvePath('/api/gta6-facts.json')} target="_blank" class="flex items-center gap-2 text-vice-pink hover:underline">
                  <span>/api/gta6-facts.json</span>
                  <span class="text-[9px] px-1.5 py-0.5 rounded bg-surface-200 text-gray-300">API</span>
                </a>
              </li>
              <li>
                <a href={resolvePath('/robots.txt')} target="_blank" class="text-gray-300 hover:text-white transition-colors">
                  Robots.txt (AI Crawlers)
                </a>
              </li>
              <li>
                <a href={resolvePath('/.well-known/security.txt')} target="_blank" class="text-gray-300 hover:text-white transition-colors">
                  Security.txt (RFC 9116)
                </a>
              </li>
            </ul>
          </div>
        </div>

        <!-- Rating Badge & Rockstar Games Identity -->
        <div class="py-6 border-t border-white/[0.08] flex flex-wrap items-center justify-between gap-6">
          <div class="flex items-center gap-4">
            <!-- PEGI 18 Badge -->
            <div class="w-11 h-13 rounded-lg bg-red-600 border border-white text-white flex flex-col items-center justify-center p-1 shadow-lg select-none">
              <span class="text-base font-black leading-none font-mono">18</span>
              <span class="text-[7px] font-bold tracking-tighter uppercase mt-0.5">PEGI</span>
            </div>
            <div class="text-xs text-gray-400">
              <strong data-i18n="pegi.tag" class="text-white block font-mono text-[11px] uppercase">RATING IN ATTESA DI CONFERMA (18+)</strong>
              <span data-i18n="pegi.desc">Violenza estrema, linguaggio forte, contenuti per soli adulti.</span>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-8 h-8 rounded-lg bg-vice-pink/20 border border-vice-pink/40 flex items-center justify-center text-vice-pink font-black text-xs font-mono shadow-[0_0_10px_rgba(255,0,127,0.3)]">
              VI
            </div>
            <div class="text-right">
              <span data-i18n="footer.community_title" class="text-xs font-black text-white font-mono block">COMMUNITY FAN HUB</span>
              <span data-i18n="footer.community_subtitle" class="text-[10px] text-gray-400 font-mono">NON-OFFICIAL • NON-AFFILIATED</span>
            </div>
          </div>
        </div>

        <!-- Take-Two Interactive & Rockstar Legal Shield -->
        <div class="pt-6 border-t border-white/[0.08] text-[11px] text-gray-400 space-y-2.5 leading-relaxed">
          <p data-i18n="footer.disclaimer">
            DISCLAIMER COMMERCIALE E COPYRIGHT: Leonida Index (gta6leonida.it) è un portale editoriale amatoriale indipendente e non ufficiale per gli appassionati. Non è affiliato, sponsorizzato, approvato né associato in alcun modo a Rockstar Games, Take-Two Interactive Software, Inc., Sony Interactive Entertainment o Microsoft Corporation.
          </p>
          <p data-i18n="footer.copyright_note">
            Grand Theft Auto, GTA VI, GTA 6, Vice City, Leonida e tutti i rispettivi loghi, marchi, asset e nomi di personaggi appartengono esclusivamente a Take-Two Interactive Software, Inc. e Rockstar Games, Inc. L'uso dei contenuti sul portale è svolto a puro scopo informativo, divulgativo e di cronaca nel quadro del diritto di citazione e del Fair Use (art. 70 L. 633/1941).
          </p>
          <div class="flex flex-col sm:flex-row items-center justify-between pt-3 text-gray-400">
            <span data-i18n="footer.copy_notice">© 2026 Leonida Index. Progettato con passione per la community di Vice City.</span>
            <div class="flex items-center gap-4 mt-2 sm:mt-0 font-mono text-[10px]">
              <a href={resolvePath('/legal')} data-i18n="footer.privacy_link" class="hover:text-vice-pink transition-colors">PRIVACY POLICY</a>
              <span>•</span>
              <a href={resolvePath('/legal#affiliate')} data-i18n="footer.affiliate_link" class="hover:text-vice-cyan transition-colors">AFFILIATE DISCLOSURE</a>
            </div>
          </div>
        </div>
      </div>
    </footer>

    <!-- GDPR Privacy Banner -->
    <ConsentBanner />

    <!-- Mobile Nav Script -->
    <script>
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const menu = document.getElementById('mobile-nav-menu');

      if (toggleBtn && menu) {
        toggleBtn.addEventListener('click', () => {
          const isHidden = menu.classList.contains('hidden');
          if (isHidden) {
            menu.classList.remove('hidden');
            toggleBtn.setAttribute('aria-expanded', 'true');
          } else {
            menu.classList.add('hidden');
            toggleBtn.setAttribute('aria-expanded', 'false');
          }
        });

        // Close menu on link click
        menu.querySelectorAll('a').forEach((link) => {
          link.addEventListener('click', () => {
            menu.classList.add('hidden');
            toggleBtn.setAttribute('aria-expanded', 'false');
          });
        });
      }
    </script>

    <!-- Global Bilingual i18n Client Engine -->
    <script>
      import { translations, type Lang } from '../i18n/translations';

      function applyLanguage(lang: Lang) {
        const dict = translations[lang] || translations.it;
        document.documentElement.lang = lang;
        try {
          localStorage.setItem('gta6_site_lang', lang);
        } catch (e) {}

        // Update active states for all switcher buttons (desktop & mobile)
        const itBtns = document.querySelectorAll<HTMLButtonElement>('[data-lang-target="it"]');
        const enBtns = document.querySelectorAll<HTMLButtonElement>('[data-lang-target="en"]');

        if (lang === 'en') {
          enBtns.forEach((btn) => {
            btn.classList.add('bg-vice-pink', 'text-white', 'shadow-sm');
            btn.classList.remove('text-gray-400', 'hover:text-white');
          });
          itBtns.forEach((btn) => {
            btn.classList.remove('bg-vice-pink', 'text-white', 'shadow-sm');
            btn.classList.add('text-gray-400', 'hover:text-white');
          });
        } else {
          itBtns.forEach((btn) => {
            btn.classList.add('bg-vice-pink', 'text-white', 'shadow-sm');
            btn.classList.remove('text-gray-400', 'hover:text-white');
          });
          enBtns.forEach((btn) => {
            btn.classList.remove('bg-vice-pink', 'text-white', 'shadow-sm');
            btn.classList.add('text-gray-400', 'hover:text-white');
          });
        }

        // Update all text nodes marked with data-i18n
        document.querySelectorAll<HTMLElement>('[data-i18n]').forEach((el) => {
          const key = el.getAttribute('data-i18n');
          if (key && dict[key]) {
            el.textContent = dict[key];
          }
        });

        // Update HTML nodes marked with data-i18n-html
        document.querySelectorAll<HTMLElement>('[data-i18n-html]').forEach((el) => {
          const key = el.getAttribute('data-i18n-html');
          if (key && dict[key]) {
            el.innerHTML = dict[key];
          }
        });

        // Update input placeholders marked with data-i18n-placeholder
        document.querySelectorAll<HTMLInputElement | HTMLTextAreaElement>('[data-i18n-placeholder]').forEach((el) => {
          const key = el.getAttribute('data-i18n-placeholder');
          if (key && dict[key]) {
            el.setAttribute('placeholder', dict[key]);
          }
        });
      }

      function initI18n() {
        const urlParams = new URLSearchParams(window.location.search);
        const queryLang = urlParams.get('lang');
        let initialLang: Lang = 'it';

        if (queryLang === 'en' || queryLang === 'it') {
          initialLang = queryLang as Lang;
        } else {
          try {
            const saved = localStorage.getItem('gta6_site_lang');
            if (saved === 'en' || saved === 'it') {
              initialLang = saved as Lang;
            }
          } catch (e) {}
        }

        // Apply initial language
        applyLanguage(initialLang);

        // Bind click events on all language buttons
        document.querySelectorAll<HTMLButtonElement>('[data-lang-target="it"]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            applyLanguage('it');
          });
        });

        document.querySelectorAll<HTMLButtonElement>('[data-lang-target="en"]').forEach((btn) => {
          btn.addEventListener('click', (e) => {
            e.preventDefault();
            applyLanguage('en');
          });
        });
      }

      // Initialize on first script run and on every Astro page transition
      initI18n();
      document.addEventListener('astro:page-load', initI18n);
    </script>
  </body>
</html>
