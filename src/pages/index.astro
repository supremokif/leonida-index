---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaunchStatusHero from '../components/LaunchStatusHero.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import StorageCalculator from '../components/StorageCalculator.astro';
import AdSlot from '../components/AdSlot.astro';
import db from '../data/gta6_db.json';

const featuredTrailers = db.trailers.slice(0, 3);
---

<BaseLayout
  title="Leonida Index - Grand Theft Auto VI: Release Date 19 Nov 2026, Pre-load & Intel"
  description="Il portale definitivo su Grand Theft Auto VI: conto alla rovescia, orari di sblocco rolling, pre-load attivo da 228.5 GB, archivio 7 trailer, mappa di Leonida e tracker 100%."
  canonicalPath="/"
>
  <!-- Main Hero with Neon Countdown & Live Telemetry -->
  <LaunchStatusHero />

  <AdSlot id="home-top-banner" format="leaderboard" />

  <!-- Authentic Leonida Dossier Table (No AI Robotic Phrasing) -->
  <section class="my-14 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.12] shadow-2xl relative overflow-hidden" aria-label="Leonida Dossier">
    <!-- Ambient Dusk Glow -->
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-vice-pink/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="max-w-3xl mb-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[11px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
        <span>ARCHIVIO UFFICIALE ROCKSTAR GAMES // DOSSIER 01</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        TUTTO SU <span class="bg-gradient-to-r from-vice-pink to-vice-cyan bg-clip-text text-transparent">VICE CITY</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-2 font-normal leading-relaxed">
        I fatti ufficiali confermati da Rockstar Games per il lancio del 19 Novembre 2026.
      </p>
    </div>

    <!-- Polished Data Grid Table -->
    <div class="overflow-x-auto rounded-2xl border border-white/[0.1] mb-10 relative z-10 shadow-xl">
      <table class="w-full text-left text-xs sm:text-sm text-gray-200">
        <thead class="bg-[#1b1433] text-[11px] uppercase font-mono font-bold text-vice-cyan tracking-wider border-b border-white/[0.1]">
          <tr>
            <th scope="col" class="py-4 px-5">PARAMETRO</th>
            <th scope="col" class="py-4 px-5">DATO CONFERMATO</th>
            <th scope="col" class="py-4 px-5">NOTE OPERATIVE</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/[0.06] bg-[#0e0a1a]/80 font-medium">
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-pink"></span>
              Data di Uscita Mondiale
            </td>
            <td class="py-4 px-5 text-vice-pink font-mono font-bold text-sm">{db.releaseInfo.releaseDateHuman}</td>
            <td class="py-4 px-5 text-xs text-gray-400">Mezzanotte locale rolling launch (00:00)</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Stato Pre-load Digitale
            </td>
            <td class="py-4 px-5 text-emerald-400 font-mono font-bold text-sm">{db.releaseInfo.preloadDateHuman} (Attivo)</td>
            <td class="py-4 px-5 text-xs text-gray-400">Disponibile su PlayStation Store e Xbox Live</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-cyan"></span>
              Piattaforme al Lancio
            </td>
            <td class="py-4 px-5 text-white font-mono">{db.releaseInfo.platforms.join(', ')}</td>
            <td class="py-4 px-5 text-xs text-gray-400">Versione PC Windows pianificata per il 2027</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-gold"></span>
              Spazio Necessario su SSD
            </td>
            <td class="py-4 px-5 text-vice-gold font-mono font-bold">PS5: {db.releaseInfo.downloadSizePS5} | Xbox: {db.releaseInfo.downloadSizeXbox}</td>
            <td class="py-4 px-5 text-xs text-gray-400">Consigliati almeno 260 GB liberi per la decompressione</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
              Ambientazione &amp; Mappa
            </td>
            <td class="py-4 px-5 text-white">{db.releaseInfo.setting}</td>
            <td class="py-4 px-5 text-xs text-gray-400">Oltre 2.5x l'estensione di GTA V con oltre 1.200 interni</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-pink"></span>
              Inno Ufficiale di Lancio
            </td>
            <td class="py-4 px-5 text-vice-cyan font-mono font-bold">"Flower in a Hurricane"</td>
            <td class="py-4 px-5 text-xs text-gray-400">Justice ft. Tame Impala, SZA &amp; King Gizzard</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- Editorial Highlight Columns -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10">
      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-pink/40 transition-colors">
        <div class="text-xs font-mono font-bold text-vice-pink uppercase tracking-widest mb-2">01 // IL PRE-LOAD</div>
        <h3 class="text-lg font-bold text-white mb-2">228.5 GB Già Scaricabili</h3>
        <p class="text-xs text-gray-300 leading-relaxed font-normal">
          Chi possiede il pre-order digitale può scaricare il gioco completo in anticipo e iniziare a giocare esattamente allo scoccare della mezzanotte del 19 Novembre.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-orange/40 transition-colors">
        <div class="text-xs font-mono font-bold text-vice-orange uppercase tracking-widest mb-2">02 // LA MAPPA</div>
        <h3 class="text-lg font-bold text-white mb-2">Leonida Senza Confini</h3>
        <p class="text-xs text-gray-300 leading-relaxed font-normal">
          Da Ocean Beach ai grattacieli di Downtown, fino alle paludi delle Grassrivers e alle barriere coralline delle Keys, con transizioni fluide senza caricamenti.
        </p>
      </div>

      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-cyan/40 transition-colors">
        <div class="text-xs font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">03 // HARDWARE</div>
        <h3 class="text-lg font-bold text-white mb-2">4K 60FPS con PSSR</h3>
        <p class="text-xs text-gray-300 leading-relaxed font-normal">
          Il motore RAGE 9 sfrutta il Ray Tracing volumetrico per luci e pozzanghere notturne, con supporto alla risoluzione dinamica 4K e feedback aptico DualSense.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Storage Diagnostic Island -->
  <StorageCalculator />

  <!-- Video Showcase Section -->
  <section class="my-14">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-2">
          ARCHIVIO MULTIMEDIALE UFFICIALE
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight uppercase">
          TRAILER E DEEP DIVE DI GIOCO
        </h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-1">
          Player video privacy-first in modalità youtube-nocookie.com (Zero Cookie di terze parti all'avvio).
        </p>
      </div>
      <a
        href="/trailers/trailer-1"
        class="inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-surface-100 hover:bg-surface-200 border border-white/[0.1] text-xs font-mono font-bold text-vice-cyan hover:text-white transition-all duration-200"
      >
        <span>VEDI TUTTI I 7 VIDEO</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 sm:gap-8">
      {featuredTrailers.map((trailer) => (
        <div class="flex flex-col rounded-3xl bg-[#0e0a1a] border border-white/[0.1] overflow-hidden shadow-xl hover:border-vice-pink/50 transition-all duration-300">
          <LiteYouTube videoId={trailer.youtubeId} title={trailer.title} duration={trailer.duration} soundtrack={trailer.soundtrack.title} />
          <div class="p-6 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-gray-400 mb-2">
                <span>{trailer.publishDateHuman}</span>
                <span class="text-vice-pink font-bold">#{trailer.number}</span>
              </div>
              <h3 class="text-base font-bold text-white mb-2 line-clamp-1">{trailer.title}</h3>
              <p class="text-xs text-gray-300 line-clamp-2 mb-4 leading-relaxed font-normal">{trailer.summary}</p>
            </div>
            <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono">
              <span class="text-gray-400 truncate max-w-[180px] flex items-center gap-1.5">
                <svg class="w-3.5 h-3.5 text-vice-pink shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19V6l12-3v13M9 19c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zm12 0c0 1.105-1.343 2-3 2s-3-.895-3-2 1.343-2 3-2 3 .895 3 2zM9 10l12-3"/></svg>
                {trailer.soundtrack.title}
              </span>
              <a href={`/trailers/${trailer.slug}`} class="text-vice-cyan font-bold hover:underline">ANALISI ➔</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- 6 Leonida Regions Showcase -->
  <section class="my-14 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.12] shadow-2xl relative overflow-hidden">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">
          CARTOGRAFIA DELLO STATO
        </div>
        <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight uppercase">
          LE 6 REGIONI DI LEONIDA
        </h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-1">Punti d'interesse, fazioni criminali e fauna autoctona.</p>
      </div>
      <a href="/tracker" class="inline-flex items-center gap-2 text-xs font-mono font-bold text-vice-pink hover:underline">
        <span>TRACKER 100% COLLEZIONABILI</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {db.locations.map((region) => (
        <a
          href={`/leonida/${region.slug}`}
          class="group p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-cyan/60 hover:shadow-neon-cyan transition-all duration-300 flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-[11px] font-mono text-vice-cyan mb-2">
              <span>{region.category}</span>
              <span>{region.subLocations.length} Luoghi</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-vice-cyan transition-colors mb-2">
              {region.name}
            </h3>
            <p class="text-xs text-gray-300 line-clamp-3 leading-relaxed mb-5 font-normal">
              {region.description}
            </p>
          </div>
          <div class="pt-3 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono">
            <span class="text-gray-400">{region.collectibles.length} Collezionabili</span>
            <span class="text-vice-pink font-bold group-hover:translate-x-1 transition-transform">SCHEDA REGIONALE ➔</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Protagonists Dossier Section -->
  <section class="my-14">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-2">
        DOSSIER PROTAGONISTI
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight uppercase">
        LUCIA E JASON
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2">
        La coppia criminale al centro della narrazione di GTA VI: schede e abilità tattiche.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {db.protagonists.map((char) => (
        <div class="p-7 sm:p-10 rounded-[2.5rem] bg-[#120d24] border border-white/[0.1] shadow-2xl flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-10 -top-10 w-40 h-40 bg-vice-pink/10 rounded-full blur-3xl pointer-events-none"></div>

          <div>
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-mono font-bold text-vice-pink uppercase tracking-widest">{char.alias}</span>
              <span class="px-2.5 py-0.5 rounded-full bg-[#1b1433] border border-white/[0.1] text-[10px] font-mono text-gray-300">
                PROTAGONISTA GIOCABILE
              </span>
            </div>
            <h3 class="text-3xl font-black text-white mb-1.5">{char.name}</h3>
            <p class="text-xs font-mono text-vice-cyan font-semibold mb-4">{char.role}</p>

            <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6 font-normal">
              {char.background}
            </p>

            <div class="mb-6">
              <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-white mb-2.5">ABILITÀ SPECIALI:</h4>
              <ul class="space-y-2 text-xs text-gray-300 font-normal">
                {char.specialAbilities.map((ab) => (
                  <li class="flex items-start gap-2.5 leading-relaxed">
                    <span class="text-emerald-400 font-bold">✓</span>
                    <span>{ab}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-white/[0.08] text-xs font-mono text-gray-400 flex items-center justify-between">
            <span>STATO: <strong class="text-emerald-400">{char.status}</strong></span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Hardware Deals Affiliate Section -->
  <section class="my-14 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-vice-cyan/30 shadow-neon-cyan relative">
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">
        HARDWARE &amp; ARCHIVIAZIONE
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight uppercase">
        PREPARA LA TUA CONSOLE PER <span class="text-vice-cyan">LEONIDA</span>
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2 font-normal">
        I migliori componenti di memoria certificati e le ricariche Store per scaricare i 228.5 GB di GTA VI senza intoppi.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {db.hardwareDeals.map((item) => (
        <AffiliateBox
          id={item.id}
          title={item.title}
          category={item.category}
          targetConsole={item.targetConsole}
          badge={item.badge}
          price={item.price}
          originalPrice={item.originalPrice}
          affiliateUrl={item.affiliateUrl}
          rating={item.rating}
          reviewsCount={item.reviewsCount}
          features={item.features}
          storageCapacityGb={item.storageCapacityGb}
        />
      ))}
    </div>
  </section>

  <!-- FAQ Section -->
  <section class="my-14 max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-2">
        DOMANDE FREQUENTI
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight uppercase">DOMANDE E RISPOSTE SU GTA VI</h2>
    </div>

    <div class="space-y-4">
      {db.releaseInfo.faq.map((item) => (
        <details class="group rounded-3xl bg-[#120d24] border border-white/[0.08] p-6 transition-all duration-300 open:border-vice-pink/50 open:bg-[#181130]">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base sm:text-lg text-white list-none select-none">
            <span>{item.question}</span>
            <span class="w-8 h-8 rounded-xl bg-[#1f173d] flex items-center justify-center text-vice-pink group-open:rotate-180 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-white/[0.06] text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
