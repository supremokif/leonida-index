---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaunchStatusHero from '../components/LaunchStatusHero.astro';
import RockstarVideoSelector from '../components/RockstarVideoSelector.astro';
import LatestNewsAndTrivia from '../components/LatestNewsAndTrivia.astro';
import RockstarPillars from '../components/RockstarPillars.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import db from '../data/gta6_db.json';

// Regional photography mapping for Leonida
const regionPhotos: Record<string, { image: string; highlight: string }> = {
  'vice-city': {
    image: '/images/vice-city-downtown.jpg',
    highlight: 'Downtown Skylines & Art Deco Ocean Beach',
  },
  'leonida-keys': {
    image: '/images/leonida-keys.jpg',
    highlight: 'Overseas Highway, Reefs & Coral Waters',
  },
  'grassrivers': {
    image: '/images/grassrivers.jpg',
    highlight: 'Swamps, Mangroves & Alligator Ecosystem',
  },
  'port-gellhorn': {
    image: '/images/port-gellhorn.jpg',
    highlight: 'Deep-Water Shipping Docks & Coastal Roads',
  },
  'ambrosia': {
    image: '/images/action-supercar.jpg',
    highlight: 'Speedways, Lowriders & Backroads',
  },
  'mount-kalaga': {
    image: '/images/vice-beach-day.jpg',
    highlight: 'National Nature Reserve & Forest Trails',
  },
};
---

<BaseLayout
  title="Grand Theft Auto VI - Sito Ufficiale Rockstar Games Hub"
  description="Il portale ufficiale su Grand Theft Auto VI: screenshot 4K ufficiali, trailer, edizioni Ultimate e Standard, State of Leonida, protagonisti Lucia & Jason e pre-order."
  canonicalPath="/"
>
  <div id="overview"></div>

  <!-- 1. Rockstar Official Hero with Fullscreen Key Art, Official VI Logo & Live Countdown -->
  <LaunchStatusHero />

  <!-- 2. Official Rockstar Video Archive & Trailers -->
  <RockstarVideoSelector />

  <!-- 3. Latest Verified News & Confirmed Real Curiosities -->
  <LatestNewsAndTrivia />

  <!-- 4. Official 4 Pillars, Story Synopsis, Editions, Warehouse Merch, Newswire & Propaganda -->
  <RockstarPillars />

  <!-- 5. The Launch Gallery - 4K Screenshot Gallery & Interactive Lightbox -->
  <ScreenshotGallery />

  <!-- 5. People & Places: The World of Leonida Photographic Travelogue -->
  <section id="leonida" class="my-20 scroll-mt-24 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Lo Stato di Leonida">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-white/10">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[11px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-vice-cyan animate-pulse"></span>
          <span>PEOPLE &amp; PLACES // STATO DI LEONIDA</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
          ONLY IN <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">LEONIDA</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-300 mt-2 max-w-2xl font-normal leading-relaxed">
          Vice City, USA. Dai boulevard al neon di Ocean Beach alle paludi selvagge delle Grassrivers: esplora le regioni che compongono lo Stato di Leonida.
        </p>
      </div>

      <a
        href="/leonida/vice-city"
        class="inline-flex items-center gap-2 text-xs font-mono font-bold text-amber-400 hover:text-white transition-colors"
      >
        <span>DETTAGLI REGIONI E FOTOGRAFIA</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <!-- 6 Photographic Region Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {db.locations.map((region) => {
        const photoInfo = regionPhotos[region.slug] || {
          image: '/images/vice-ocean-drive.jpg',
          highlight: 'Punti d\'interesse confermati',
        };

        return (
          <a
            href={`/leonida/${region.slug}`}
            class="group flex flex-col rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/10 hover:border-amber-400/60 shadow-2xl transition-all duration-500 hover:-translate-y-1.5"
          >
            <!-- Card Photo Header -->
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#151026]">
              <img
                src={photoInfo.image}
                alt={`Regione ${region.name} GTA VI`}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent"></div>
              
              <!-- Region Category Tag -->
              <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/15 text-[10px] font-mono font-bold text-vice-cyan uppercase">
                {region.category}
              </div>

              <!-- GPS Badge -->
              <div class="absolute bottom-3 right-3 text-[10px] font-mono text-white/80 bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm">
                GPS: {region.coordinates.lat.toFixed(2)}°N
              </div>
            </div>

            <!-- Card Content Body -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-mono font-bold text-amber-400 uppercase tracking-widest block mb-1">
                  {photoInfo.highlight}
                </span>
                <h3 class="text-xl font-black text-white group-hover:text-amber-400 transition-colors mb-2 uppercase">
                  {region.name}
                </h3>
                <p class="text-xs text-gray-300 leading-relaxed line-clamp-3 font-normal mb-6">
                  {region.description}
                </p>
              </div>

              <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono">
                <span class="text-gray-400">{region.subLocations.length} Aree Distinte</span>
                <span class="text-amber-400 font-bold group-hover:translate-x-1 transition-transform">
                  ESPLORA ➔
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- 6. Meet Lucia & Jason (Protagonists Photographic Dossier) -->
  <section id="characters" class="my-20 scroll-mt-24 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Protagonisti Lucia e Jason">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[11px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-vice-pink animate-pulse"></span>
        <span>DOSSIER PERSONAGGI // ROCKSTAR GAMES</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        LUCIA E JASON
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-2 font-normal leading-relaxed">
        I due protagonisti al centro della narrazione di Grand Theft Auto VI. Una coppia costretta a fare squadra per sopravvivere nello Stato di Leonida.
      </p>
    </div>

    <!-- Protagonists Split Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      
      <!-- Lucia Card -->
      <div class="flex flex-col sm:flex-row rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/10 hover:border-vice-pink/50 shadow-2xl transition-all duration-300">
        <!-- Photo Section -->
        <div class="sm:w-1/2 relative aspect-[3/4] sm:aspect-auto overflow-hidden bg-[#151026]">
          <img
            src="/images/lucia-profile.jpg"
            alt="Lucia - Protagonista GTA VI"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-transparent via-transparent to-[#0d0a1a]/90"></div>
          <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/80 border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase">
            PROTAGONISTA
          </div>
        </div>

        <!-- Info Section -->
        <div class="sm:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono font-bold text-vice-pink uppercase tracking-widest block mb-1">
              VICE CITY, USA
            </span>
            <h3 class="text-3xl font-black text-white mb-1.5 uppercase">LUCIA</h3>
            <span class="text-xs font-mono text-vice-cyan font-semibold block mb-4">Protagonista Ufficiale</span>

            <p class="text-xs text-gray-300 leading-relaxed font-normal mb-5">
              Lucia ha sempre saputo che il destino gioca a sfavore. Ma quando un colpo facile va storto, si ritrova con Jason sul lato più oscuro del luogo più soleggiato d'America.
            </p>

            <blockquote class="p-3.5 rounded-xl bg-[#140f26] border-l-2 border-vice-pink text-xs italic text-gray-200 font-mono mb-5">
              "L'unico modo per uscirne è restare uniti. Facendo squadra. Ti fidi di me? — Fiducia."
            </blockquote>
          </div>

          <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-gray-400">
            <span>RUOLO: <strong class="text-emerald-400">PROTAGONISTA GIOCABILE</strong></span>
            <span class="text-vice-pink font-bold">R★ OFFICIAL</span>
          </div>
        </div>
      </div>

      <!-- Jason Card -->
      <div class="flex flex-col sm:flex-row rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/10 hover:border-amber-400/50 shadow-2xl transition-all duration-300">
        <!-- Photo Section -->
        <div class="sm:w-1/2 relative aspect-[3/4] sm:aspect-auto overflow-hidden bg-[#151026]">
          <img
            src="/images/jason-profile.jpg"
            alt="Jason - Protagonista GTA VI"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-transparent via-transparent to-[#0d0a1a]/90"></div>
          <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/80 border border-amber-400/40 text-[10px] font-mono font-bold text-amber-400 uppercase">
            PROTAGONISTA
          </div>
        </div>

        <!-- Info Section -->
        <div class="sm:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest block mb-1">
              VICE CITY, USA
            </span>
            <h3 class="text-3xl font-black text-white mb-1.5 uppercase">JASON</h3>
            <span class="text-xs font-mono text-vice-cyan font-semibold block mb-4">Protagonista Ufficiale</span>

            <p class="text-xs text-gray-300 leading-relaxed font-normal mb-5">
              Al fianco di Lucia in una spirale di rapine e pericoli crescenti attraverso la contea e le isole di Leonida, costretto a fidarsi ciecamente della sua compagna.
            </p>

            <blockquote class="p-3.5 rounded-xl bg-[#140f26] border-l-2 border-amber-400 text-xs italic text-gray-200 font-mono mb-5">
              "Fiducia. È l'unica cosa che ci tiene vivi."
            </blockquote>
          </div>

          <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-gray-400">
            <span>RUOLO: <strong class="text-emerald-400">PROTAGONISTA GIOCABILE</strong></span>
            <span class="text-amber-400 font-bold">R★ OFFICIAL</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- 7. Official Rockstar Dossier & Facts Table -->
  <section class="my-20 px-4 sm:px-6 max-w-7xl mx-auto" aria-label="Dati Ufficiali Rockstar">
    <div class="p-8 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/10 shadow-2xl relative">
      <div class="max-w-3xl mb-8">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[11px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
          SCHEDA TECNICA UFFICIALE ROCKSTAR GAMES
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
          SPECIFICHE CONFERMATE
        </h2>
        <p class="text-sm sm:text-base text-gray-300 mt-2 font-normal leading-relaxed">
          I parametri tecnici e le informazioni ufficiali diffuse da Take-Two Interactive e Rockstar Games.
        </p>
      </div>

      <!-- Data Table -->
      <div class="overflow-x-auto rounded-2xl border border-white/10 shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm text-gray-200">
          <thead class="bg-[#1b1433] text-[11px] uppercase font-mono font-bold text-amber-400 tracking-wider border-b border-white/10">
            <tr>
              <th scope="col" class="py-4 px-5">PARAMETRO</th>
              <th scope="col" class="py-4 px-5">DATO UFFICIALE</th>
              <th scope="col" class="py-4 px-5">DETTAGLI CONFERMATI</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.06] bg-[#0e0a1a]/80 font-medium">
            <tr class="hover:bg-white/[0.04] transition-colors">
              <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
                Data di Uscita Globale
              </td>
              <td class="py-4 px-5 text-amber-400 font-mono font-bold text-sm">{db.releaseInfo.releaseDateHuman}</td>
              <td class="py-4 px-5 text-xs text-gray-400 font-normal">Lancio globale su console</td>
            </tr>
            <tr class="hover:bg-white/[0.04] transition-colors">
              <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
                Piattaforme di Lancio
              </td>
              <td class="py-4 px-5 text-white font-mono">{db.releaseInfo.platforms.join(', ')}</td>
              <td class="py-4 px-5 text-xs text-gray-400 font-normal">Esclusiva console PlayStation 5 e Xbox Series X|S</td>
            </tr>
            <tr class="hover:bg-white/[0.04] transition-colors">
              <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-vice-cyan"></span>
                Motore Grafico
              </td>
              <td class="py-4 px-5 text-vice-cyan font-mono font-bold">{db.releaseInfo.engine}</td>
              <td class="py-4 px-5 text-xs text-gray-400 font-normal">Sviluppato internamente da Rockstar Games</td>
            </tr>
            <tr class="hover:bg-white/[0.04] transition-colors">
              <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-vice-pink"></span>
                Ambientazione
              </td>
              <td class="py-4 px-5 text-white">{db.releaseInfo.setting}</td>
              <td class="py-4 px-5 text-xs text-gray-400 font-normal">Vice City e le vaste aree dello Stato di Leonida</td>
            </tr>
            <tr class="hover:bg-white/[0.04] transition-colors">
              <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
                Colonna Sonora Trailer 1
              </td>
              <td class="py-4 px-5 text-vice-cyan font-mono font-bold">"Love Is a Long Road"</td>
              <td class="py-4 px-5 text-xs text-gray-400 font-normal">Tom Petty (Album: Full Moon Fever, 1989)</td>
            </tr>
            <tr class="hover:bg-white/[0.04] transition-colors">
              <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
                <span class="w-1.5 h-1.5 rounded-full bg-zinc-400"></span>
                Dimensione Download
              </td>
              <td class="py-4 px-5 text-gray-300 font-mono">TBA</td>
              <td class="py-4 px-5 text-xs text-gray-400 font-normal">In attesa di annuncio ufficiale da parte di Rockstar Games</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 8. FAQ Section Rockstar Style -->
  <section id="faq" class="my-20 scroll-mt-24 px-4 sm:px-6 max-w-4xl mx-auto" aria-label="Domande Frequenti">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-amber-400/40 text-[10px] font-mono font-bold text-amber-400 uppercase tracking-widest mb-2">
        SUPPORTO &amp; FAQ UFFICIALI
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">DOMANDE FREQUENTI</h2>
    </div>

    <div class="space-y-4">
      {db.releaseInfo.faq.map((item) => (
        <details class="group rounded-3xl bg-[#0d0a1a] border border-white/10 p-6 transition-all duration-300 open:border-amber-400/50 open:bg-[#151026]">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base sm:text-lg text-white list-none select-none">
            <span>{item.question}</span>
            <span class="w-8 h-8 rounded-xl bg-[#1f173d] flex items-center justify-center text-amber-400 group-open:rotate-180 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-white/[0.08] text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
