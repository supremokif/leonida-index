---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaunchStatusHero from '../components/LaunchStatusHero.astro';
import ScreenshotGallery from '../components/ScreenshotGallery.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import AdSlot from '../components/AdSlot.astro';
import db from '../data/gta6_db.json';

const featuredTrailers = db.trailers.slice(0, 3);

// Regional photography mapping
const regionPhotos: Record<string, { image: string; highlight: string }> = {
  'vice-city': {
    image: '/images/vice-city-downtown.jpg',
    highlight: 'Downtown Skylines & Art Deco Ocean Beach',
  },
  'leonida-keys': {
    image: '/images/leonida-keys.jpg',
    highlight: 'Overseas Highway, Reefs & Coral Waters',
  },
  'grassrivers': {
    image: '/images/grassrivers.jpg',
    highlight: 'Swamps, Mangroves & Alligator Ecosystem',
  },
  'port-gellhorn': {
    image: '/images/port-gellhorn.jpg',
    highlight: 'Deep-Water Shipping Docks & Industrial Strips',
  },
  'ambrosia': {
    image: '/images/action-supercar.jpg',
    highlight: 'Biscayne Speedway, Lowriders & Backroads',
  },
  'mount-kalaga': {
    image: '/images/vice-beach-day.jpg',
    highlight: 'National Nature Reserve & Forest Trails',
  },
};

// Official Game Editions
const officialEditions = [
  {
    id: 'standard-edition',
    name: 'Standard Edition',
    badge: 'EDIZIONE BASE',
    price: '€79.99',
    platforms: 'PS5 • PS5 Pro • Xbox Series X|S',
    description: 'Il gioco completo Grand Theft Auto VI per console current-gen con accesso al day-one e tutti i contenuti della campagna principale.',
    features: [
      'Copia completa di Grand Theft Auto VI',
      'Pacchetto Pre-Order: bonus veicolo esclusivo Vice Custom',
      'Accesso garantito al Pre-load digitale 228.5 GB',
      'Modalità storia completa con Lucia e Jason',
    ],
    accent: 'border-white/[0.12]',
    badgeBg: 'bg-white/10 text-white',
    buttonBg: 'bg-surface-100 hover:bg-surface-200 text-white border border-white/[0.15]',
  },
  {
    id: 'deluxe-steelbook',
    name: 'Special Steelbook Edition',
    badge: 'PIÙ POPOLARE',
    price: '€99.99',
    platforms: 'Edizione Fisica da Collezione',
    description: 'Custodia in metallo Steelbook con artwork esclusivo di Vice City e mappa fisica topografica di Leonida stampata su tessuto.',
    features: [
      'Custodia Steelbook serigrafata con finitura opaca',
      'Mappa geografica ufficiale di Leonida in tessuto',
      'Bonus digitale: $1.000.000 in-game currency',
      'Pacchetto armi esclusive Vice Heat Weapons Pack',
      'Spilla da collezione in metallo smaltato R★',
    ],
    accent: 'border-amber-400/60 shadow-[0_0_30px_rgba(253,184,19,0.25)]',
    badgeBg: 'bg-amber-400 text-black font-black',
    buttonBg: 'bg-amber-400 hover:bg-amber-300 text-black font-black shadow-lg',
  },
  {
    id: 'collectors-treasure-box',
    name: "Collector's Treasure Box",
    badge: 'EDIZIONE LIMITATA',
    price: '€199.99',
    platforms: 'Tiratura Limitata e Numerata',
    description: 'Il cofanetto definitivo numerato per veri collezionisti: statua in resina di Lucia e Jason, artbook con copertina rigida e litografie artistiche.',
    features: [
      'Statua in resina alta 30cm di Lucia & Jason con base illuminata',
      'Hardcover Artbook "The Art of Leonida" (120 pagine patinate)',
      'Set di 5 litografie d\'autore numerate e timbrate Rockstar Games',
      'Mazzo di carte da poker "Club Vice" con sigillo dorato',
      'Steelbook esclusiva + tutti i contenuti digitali della Deluxe',
    ],
    accent: 'border-vice-pink/60 shadow-neon-pink',
    badgeBg: 'bg-gradient-to-r from-vice-pink to-vice-orange text-white font-black',
    buttonBg: 'bg-gradient-to-r from-vice-pink to-vice-orange text-white font-black shadow-neon-pink',
  },
];
---

<BaseLayout
  title="Grand Theft Auto VI - Sito Ufficiale Rockstar Games Hub | Leonida Index"
  description="Il portale visivo definitivo su Grand Theft Auto VI: screenshot 4K ufficiali, conto alla rovescia al 19 Novembre 2026, mappa di Leonida, trailer, protagonisti Lucia & Jason e pre-order edizioni."
  canonicalPath="/"
>
  <!-- Main Hero Rockstar Style with Countdown -->
  <LaunchStatusHero />

  <AdSlot id="home-top-banner" format="leaderboard" />

  <!-- 4K Screenshot Gallery (Richiedeva Più Foto Stile Rockstar Games) -->
  <ScreenshotGallery />

  <!-- The World of Leonida Photographic Travelogue -->
  <section id="leonida" class="my-16 scroll-mt-24" aria-label="Lo Stato di Leonida">
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 pb-6 border-b border-white/[0.1]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[11px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-3">
          <span class="w-2 h-2 rounded-full bg-vice-cyan animate-pulse"></span>
          <span>CARTOGRAFIA E AMBIENTAZIONE // STATO DI LEONIDA</span>
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
          ESPLORA <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">LE 6 REGIONI</span>
        </h2>
        <p class="text-sm sm:text-base text-gray-300 mt-2 max-w-2xl font-normal leading-relaxed">
          Dai boulevard al neon di Vice City alle paludi torbide delle Grassrivers: ogni regione offre ecosistemi vivi, criminalità autoctona e una densità di interni mai vista prima.
        </p>
      </div>

      <a
        href="/tracker"
        class="inline-flex items-center gap-2 text-xs font-mono font-bold text-amber-400 hover:text-white transition-colors"
      >
        <span>COLLEZIONABILI E MISTERI (TRACKER 100%)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <!-- 6 Photographic Region Cards -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {db.locations.map((region) => {
        const photoInfo = regionPhotos[region.slug] || {
          image: '/images/vice-ocean-drive.jpg',
          highlight: 'Punti d\'interesse confermati',
        };

        return (
          <a
            href={`/leonida/${region.slug}`}
            class="group flex flex-col rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/[0.1] hover:border-amber-400/60 shadow-2xl transition-all duration-500 hover:-translate-y-1.5"
          >
            <!-- Card Photo Header -->
            <div class="relative w-full aspect-[16/10] overflow-hidden bg-[#151026]">
              <img
                src={photoInfo.image}
                alt={`Regione ${region.name} GTA VI`}
                loading="lazy"
                decoding="async"
                class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-[#0d0a1a] via-transparent to-transparent"></div>
              
              <!-- Region Category Tag -->
              <div class="absolute top-3 left-3 px-3 py-1 rounded-full bg-black/80 backdrop-blur-md border border-white/[0.15] text-[10px] font-mono font-bold text-vice-cyan uppercase">
                {region.category}
              </div>

              <!-- GPS Badge -->
              <div class="absolute bottom-3 right-3 text-[10px] font-mono text-white/80 bg-black/60 px-2 py-0.5 rounded backdrop-blur-sm">
                GPS: {region.coordinates.lat.toFixed(2)}°N
              </div>
            </div>

            <!-- Card Content Body -->
            <div class="p-6 flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-mono font-bold text-amber-400 uppercase tracking-widest block mb-1">
                  {photoInfo.highlight}
                </span>
                <h3 class="text-xl font-black text-white group-hover:text-amber-400 transition-colors mb-2 uppercase">
                  {region.name}
                </h3>
                <p class="text-xs text-gray-300 leading-relaxed line-clamp-3 font-normal mb-6">
                  {region.description}
                </p>
              </div>

              <div class="pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono">
                <span class="text-gray-400">{region.subLocations.length} Luoghi Conclusi</span>
                <span class="text-amber-400 font-bold group-hover:translate-x-1 transition-transform">
                  GUIDA REGIONALE ➔
                </span>
              </div>
            </div>
          </a>
        );
      })}
    </div>
  </section>

  <!-- Meet Lucia & Jason (Protagonists Photographic Dossier) -->
  <section id="characters" class="my-16 scroll-mt-24" aria-label="Protagonisti Lucia e Jason">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[11px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-vice-pink animate-pulse"></span>
        <span>DOSSIER PERSONAGGI ROCKSTAR GAMES</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        LUCIA E JASON
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-2 font-normal leading-relaxed">
        La coppia criminale al centro della narrazione di GTA VI. Due destini legati da rapine ad alto rischio, tradimenti e fiducia nello Stato di Leonida.
      </p>
    </div>

    <!-- Protagonists Split Showcase -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
      
      <!-- Lucia Card -->
      <div class="flex flex-col sm:flex-row rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/[0.12] hover:border-vice-pink/50 shadow-2xl transition-all duration-300">
        <!-- Photo Section -->
        <div class="sm:w-1/2 relative aspect-[3/4] sm:aspect-auto overflow-hidden bg-[#151026]">
          <img
            src="/images/lucia-profile.jpg"
            alt="Lucia - Protagonista GTA VI"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-transparent via-transparent to-[#0d0a1a]/90"></div>
          <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/80 border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase">
            PROTAGONISTA FEMMINILE
          </div>
        </div>

        <!-- Info Section -->
        <div class="sm:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono font-bold text-vice-pink uppercase tracking-widest block mb-1">
              "LA REGINA DELLE RAPINE"
            </span>
            <h3 class="text-3xl font-black text-white mb-1.5 uppercase">LUCIA</h3>
            <span class="text-xs font-mono text-vice-cyan font-semibold block mb-4">Mente Tattica &amp; Negoziazione</span>

            <p class="text-xs text-gray-300 leading-relaxed font-normal mb-5">
              Cresciuta nei sobborghi di Vice City, Lucia è determinata, carismatica e fredda nei momenti di pressione. Dopo un periodo nella prigione di Leonida, pianifica colpi sempre più ambiziosi.
            </p>

            <blockquote class="p-3.5 rounded-xl bg-[#140f26] border-l-2 border-vice-pink text-xs italic text-gray-200 font-mono mb-5">
              "L'unico modo per uscirne vivi è restare uniti. Ti fidi di me?"
            </blockquote>

            <div class="space-y-1.5 text-xs text-gray-300 font-normal">
              <div class="font-mono font-bold text-white text-[11px] uppercase mb-1">ABILITÀ CONFERMATE:</div>
              <div class="flex items-center gap-2 text-gray-300">
                <span class="text-emerald-400 font-bold">✓</span> Scasso rapido casseforti &amp; serrature
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <span class="text-emerald-400 font-bold">✓</span> Fuga tattica e pianificazione vie d'uscita
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-gray-400">
            <span>STATO: <strong class="text-emerald-400">OPERATIVA</strong></span>
            <span class="text-vice-pink font-bold">LEONIDA ARCHIVES</span>
          </div>
        </div>
      </div>

      <!-- Jason Card -->
      <div class="flex flex-col sm:flex-row rounded-3xl overflow-hidden bg-[#0d0a1a] border border-white/[0.12] hover:border-amber-400/50 shadow-2xl transition-all duration-300">
        <!-- Photo Section -->
        <div class="sm:w-1/2 relative aspect-[3/4] sm:aspect-auto overflow-hidden bg-[#151026]">
          <img
            src="/images/jason-profile.jpg"
            alt="Jason - Protagonista GTA VI"
            loading="lazy"
            decoding="async"
            class="w-full h-full object-cover object-top hover:scale-105 transition-transform duration-700"
          />
          <div class="absolute inset-0 bg-gradient-to-t sm:bg-gradient-to-r from-transparent via-transparent to-[#0d0a1a]/90"></div>
          <div class="absolute top-4 left-4 px-3 py-1 rounded-full bg-black/80 border border-amber-400/40 text-[10px] font-mono font-bold text-amber-400 uppercase">
            PROTAGONISTA MASCHILE
          </div>
        </div>

        <!-- Info Section -->
        <div class="sm:w-1/2 p-6 sm:p-8 flex flex-col justify-between">
          <div>
            <span class="text-xs font-mono font-bold text-amber-400 uppercase tracking-widest block mb-1">
              "L'ESECUTORE BALISTICO"
            </span>
            <h3 class="text-3xl font-black text-white mb-1.5 uppercase">JASON</h3>
            <span class="text-xs font-mono text-vice-cyan font-semibold block mb-4">Pilota &amp; Armi Pesanti</span>

            <p class="text-xs text-gray-300 leading-relaxed font-normal mb-5">
              Veterano delle corse illegali e del contrabbando marittimo nelle Keys, Jason è un esperto nel combattimento corpo a corpo e nella gestione di veicoli pesanti e imbarcazioni.
            </p>

            <blockquote class="p-3.5 rounded-xl bg-[#140f26] border-l-2 border-amber-400 text-xs italic text-gray-200 font-mono mb-5">
              "Fiducia. È l'unica cosa che ci tiene vivi laggiù."
            </blockquote>

            <div class="space-y-1.5 text-xs text-gray-300 font-normal">
              <div class="font-mono font-bold text-white text-[11px] uppercase mb-1">ABILITÀ CONFERMATE:</div>
              <div class="flex items-center gap-2 text-gray-300">
                <span class="text-emerald-400 font-bold">✓</span> Precisione balistica &amp; tiro in movimento
              </div>
              <div class="flex items-center gap-2 text-gray-300">
                <span class="text-emerald-400 font-bold">✓</span> Guida acrobatica supercar e natanti veloci
              </div>
            </div>
          </div>

          <div class="mt-6 pt-4 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-gray-400">
            <span>STATO: <strong class="text-emerald-400">OPERATIVO</strong></span>
            <span class="text-amber-400 font-bold">LEONIDA ARCHIVES</span>
          </div>
        </div>
      </div>

    </div>
  </section>

  <!-- Official Videos & Trailers Archive -->
  <section id="trailers" class="my-16 scroll-mt-24" aria-label="Trailer Ufficiali">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8 pb-6 border-b border-white/[0.1]">
      <div>
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-amber-400/40 text-[10px] font-mono font-bold text-amber-400 uppercase tracking-widest mb-2">
          ROCKSTAR GAMES VIDEO ARCHIVE
        </div>
        <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
          TRAILER UFFICIALI &amp; GAMEPLAY
        </h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-1">
          Player video in modalità youtube-nocookie.com (Zero tracciamento preventivo).
        </p>
      </div>

      <a
        href="/trailers/trailer-1"
        class="inline-flex items-center gap-2 px-5 py-2.5 rounded-xl bg-white text-black text-xs font-mono font-bold uppercase tracking-wider hover:bg-amber-400 transition-colors shadow-lg"
      >
        <span>VEDI TUTTI I 7 VIDEO</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <!-- Featured Trailer Main Player -->
    <div class="mb-10 max-w-5xl mx-auto">
      <LiteYouTube
        videoId="QdBZY2fkU-0"
        title="Grand Theft Auto VI Trailer 1"
        duration="1:31"
        soundtrack="Love Is a Long Road — Tom Petty"
      />
    </div>

    <!-- Other Trailer Stills Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredTrailers.map((trailer) => (
        <a
          href={`/trailers/${trailer.slug}`}
          class="group flex flex-col rounded-3xl bg-[#0e0a1a] border border-white/[0.1] hover:border-amber-400/50 shadow-xl overflow-hidden transition-all duration-300"
        >
          <div class="relative w-full aspect-video bg-[#151026] overflow-hidden">
            <img
              src={`https://i.ytimg.com/vi/${trailer.youtubeId === 'OFFICIAL_ROCKSTAR_NEWSWIRE' ? 'QdBZY2fkU-0' : trailer.youtubeId}/maxresdefault.jpg`}
              alt={trailer.title}
              loading="lazy"
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
            />
            <div class="absolute inset-0 bg-black/30 group-hover:bg-transparent transition-colors"></div>
            <div class="absolute bottom-3 right-3 px-2 py-0.5 rounded bg-black/80 text-[10px] font-mono text-white">
              {trailer.duration}
            </div>
          </div>
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs font-mono text-gray-400 mb-1.5">
                <span>{trailer.publishDateHuman}</span>
                <span class="text-amber-400 font-bold">#{trailer.number}</span>
              </div>
              <h3 class="text-base font-bold text-white group-hover:text-amber-400 transition-colors line-clamp-1 mb-2">
                {trailer.title}
              </h3>
              <p class="text-xs text-gray-300 line-clamp-2 leading-relaxed font-normal">
                {trailer.summary}
              </p>
            </div>
            <div class="mt-4 pt-3 border-t border-white/[0.08] flex items-center justify-between text-xs font-mono text-gray-400">
              <span class="truncate max-w-[180px]">🎵 {trailer.soundtrack.title}</span>
              <span class="text-vice-cyan font-bold">ANALISI ➔</span>
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Official Game Editions & Pre-Order (Sostituisce i test SSD hardware) -->
  <section id="editions" class="my-16 scroll-mt-24 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.12] shadow-2xl relative" aria-label="Edizioni Ufficiali di Gioco">
    <div class="text-center max-w-3xl mx-auto mb-12">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-amber-400/40 text-[11px] font-mono font-bold text-amber-400 uppercase tracking-widest mb-3">
        <span class="w-2 h-2 rounded-full bg-amber-400 animate-pulse"></span>
        <span>PRE-ORDER APERTO // USCITA: 19 NOVEMBRE 2026</span>
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        SCEGLI LA TUA <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">EDIZIONE</span>
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-2 font-normal leading-relaxed">
        Prenota Grand Theft Auto VI su PlayStation 5 e Xbox Series X|S. Tutti i pre-ordini garantiscono l'accesso immediato al pre-load digitale e a contenuti in-game esclusivi.
      </p>
    </div>

    <!-- Editions Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 max-w-6xl mx-auto">
      {officialEditions.map((ed) => (
        <div class={`flex flex-col justify-between p-8 rounded-3xl bg-[#0d0a1a] border ${ed.accent} shadow-2xl relative group`}>
          <div>
            <div class="flex items-center justify-between gap-2 mb-4">
              <span class="text-xs font-mono font-bold text-gray-400 uppercase tracking-wider">{ed.platforms}</span>
              <span class={`px-3 py-1 rounded-full text-[10px] font-mono uppercase tracking-widest ${ed.badgeBg}`}>
                {ed.badge}
              </span>
            </div>

            <h3 class="text-2xl font-black text-white mb-2 uppercase">{ed.name}</h3>
            <div class="text-3xl font-black font-mono text-white mb-4">{ed.price}</div>
            
            <p class="text-xs text-gray-300 leading-relaxed font-normal mb-6 pb-6 border-b border-white/[0.08]">
              {ed.description}
            </p>

            <div class="space-y-3 mb-8">
              <span class="text-[11px] font-mono font-bold text-white uppercase tracking-wider block">CONTENUTI INCLUSI:</span>
              <ul class="space-y-2.5 text-xs text-gray-300">
                {ed.features.map((feat) => (
                  <li class="flex items-start gap-2.5 leading-relaxed font-normal">
                    <span class="text-emerald-400 font-bold shrink-0 mt-0.5">✓</span>
                    <span>{feat}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <a
            href="https://www.rockstargames.com/VI"
            target="_blank"
            rel="noopener noreferrer"
            class={`w-full py-3.5 rounded-xl text-center text-xs font-mono font-bold tracking-wider uppercase transition-all duration-300 ${ed.buttonBg}`}
          >
            PRE-ORDINA ORA ➔
          </a>
        </div>
      ))}
    </div>
  </section>

  <!-- Official Rockstar Dossier & Facts Table -->
  <section class="my-16 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.12] shadow-2xl relative" aria-label="Dati Ufficiali Rockstar">
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[11px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
        SCHEDA TECNICA UFFICIALE ROCKSTAR GAMES
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">
        SPECIFICHE DEL GIOCO
      </h2>
      <p class="text-sm sm:text-base text-gray-300 mt-2 font-normal leading-relaxed">
        I parametri tecnici confermati da Take-Two Interactive e Rockstar North per il lancio.
      </p>
    </div>

    <!-- Data Table -->
    <div class="overflow-x-auto rounded-2xl border border-white/[0.1] shadow-xl">
      <table class="w-full text-left text-xs sm:text-sm text-gray-200">
        <thead class="bg-[#1b1433] text-[11px] uppercase font-mono font-bold text-amber-400 tracking-wider border-b border-white/[0.1]">
          <tr>
            <th scope="col" class="py-4 px-5">PARAMETRO</th>
            <th scope="col" class="py-4 px-5">DATO CONFERMATO</th>
            <th scope="col" class="py-4 px-5">DETTAGLI TECNICI</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-white/[0.06] bg-[#0e0a1a]/80 font-medium">
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span>
              Data di Uscita Mondiale
            </td>
            <td class="py-4 px-5 text-amber-400 font-mono font-bold text-sm">{db.releaseInfo.releaseDateHuman}</td>
            <td class="py-4 px-5 text-xs text-gray-400 font-normal">Mezzanotte locale rolling launch (00:00)</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span>
              Piattaforme di Lancio
            </td>
            <td class="py-4 px-5 text-white font-mono">{db.releaseInfo.platforms.join(', ')}</td>
            <td class="py-4 px-5 text-xs text-gray-400 font-normal">Versione PC Windows prevista successivamente</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-cyan"></span>
              Motore Grafico
            </td>
            <td class="py-4 px-5 text-vice-cyan font-mono font-bold">RAGE 9 Engine</td>
            <td class="py-4 px-5 text-xs text-gray-400 font-normal">Ray Tracing volumetrico, fisica fluida avanzata e PSSR</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-vice-pink"></span>
              Ambientazione &amp; Mappa
            </td>
            <td class="py-4 px-5 text-white">{db.releaseInfo.setting}</td>
            <td class="py-4 px-5 text-xs text-gray-400 font-normal">Oltre 2.5x l'estensione di GTA V con oltre 1.200 interni</td>
          </tr>
          <tr class="hover:bg-white/[0.04] transition-colors">
            <td class="py-4 px-5 font-bold text-white flex items-center gap-2">
              <span class="w-1.5 h-1.5 rounded-full bg-purple-400"></span>
              Brano Inno Ufficiale
            </td>
            <td class="py-4 px-5 text-vice-cyan font-mono font-bold">"Flower in a Hurricane"</td>
            <td class="py-4 px-5 text-xs text-gray-400 font-normal">Justice ft. Tame Impala, SZA &amp; King Gizzard</td>
          </tr>
        </tbody>
      </table>
    </div>
  </section>

  <!-- FAQ Section Rockstar Style -->
  <section class="my-16 max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-amber-400/40 text-[10px] font-mono font-bold text-amber-400 uppercase tracking-widest mb-2">
        SUPPORTO &amp; DOMANDE FREQUENTI
      </div>
      <h2 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase">DOMANDE FREQUENTI SU GTA VI</h2>
    </div>

    <div class="space-y-4">
      {db.releaseInfo.faq.map((item) => (
        <details class="group rounded-3xl bg-[#120d24] border border-white/[0.08] p-6 transition-all duration-300 open:border-amber-400/50 open:bg-[#181130]">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base sm:text-lg text-white list-none select-none">
            <span>{item.question}</span>
            <span class="w-8 h-8 rounded-xl bg-[#1f173d] flex items-center justify-center text-amber-400 group-open:rotate-180 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-white/[0.06] text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
