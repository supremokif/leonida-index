---
import BaseLayout from '../layouts/BaseLayout.astro';
import LaunchStatusHero from '../components/LaunchStatusHero.astro';
import LiteYouTube from '../components/LiteYouTube.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import StorageCalculator from '../components/StorageCalculator.astro';
import AdSlot from '../components/AdSlot.astro';
import db from '../data/gta6_db.json';

const featuredTrailers = db.trailers.slice(0, 3);
---

<BaseLayout
  title="Leonida Index - GTA VI Database Ufficiale, Countdown 19 Nov 2026 & Pre-load"
  description="Il portale definitivo su Grand Theft Auto VI: conto alla rovescia, orari di sblocco rolling, pre-load attivo da 228.5 GB, archivio 7 trailer, mappa di Leonida e tracker 100%."
  canonicalPath="/"
>
  <!-- Hero Section with Live Countdown & Auto-Switch -->
  <LaunchStatusHero />

  <!-- Leaderboard Ad Slot (CLS-Safe) -->
  <AdSlot id="home-top-banner" format="leaderboard" />

  <!-- Answer-First Executive Summary Section -->
  <section class="my-12 p-6 sm:p-10 rounded-3xl bg-surface-50 border border-surface-300 shadow-xl" aria-label="Quick Facts">
    <div class="max-w-3xl mb-8">
      <div class="text-xs font-bold text-miami-cyan uppercase tracking-widest mb-1 font-mono">Answer-First Intelligence</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">
        Cosa Sappiamo Ufficialmente su Grand Theft Auto VI
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2">
        Sintesi fattuale priva di speculazioni basata sui comunicati ufficiali di Rockstar Games per giocatori, motori di ricerca e modelli LLM (ChatGPT, Claude, Gemini, Perplexity).
      </p>
    </div>

    <!-- Structured Data Table (LLM Friendly) -->
    <div class="overflow-x-auto rounded-xl border border-surface-200 mb-8">
      <table class="w-full text-left text-xs sm:text-sm text-gray-300">
        <thead class="bg-surface-200 text-xs uppercase font-bold text-white tracking-wider font-mono">
          <tr>
            <th scope="col" class="py-3 px-4">Parametro Ufficiale</th>
            <th scope="col" class="py-3 px-4">Dato Verificato da Rockstar Games</th>
            <th scope="col" class="py-3 px-4">Note Operative di Lancio</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-surface-200 bg-surface-100/60 font-medium">
          <tr class="hover:bg-surface-200/50">
            <td class="py-3 px-4 font-bold text-white">Data di Uscita Globale</td>
            <td class="py-3 px-4 text-miami-pink font-semibold">{db.releaseInfo.releaseDateHuman}</td>
            <td class="py-3 px-4 text-xs text-gray-400">Mezzanotte locale rolling launch (00:00)</td>
          </tr>
          <tr class="hover:bg-surface-200/50">
            <td class="py-3 px-4 font-bold text-white">Stato Pre-load Digitale</td>
            <td class="py-3 px-4 text-emerald-400 font-semibold">{db.releaseInfo.preloadDateHuman} (Attivo)</td>
            <td class="py-3 px-4 text-xs text-gray-400">Disponibile su PlayStation Store e Xbox Live</td>
          </tr>
          <tr class="hover:bg-surface-200/50">
            <td class="py-3 px-4 font-bold text-white">Piattaforme di Lancio</td>
            <td class="py-3 px-4 text-white">{db.releaseInfo.platforms.join(', ')}</td>
            <td class="py-3 px-4 text-xs text-gray-400">Versione PC Windows pianificata per il 2027</td>
          </tr>
          <tr class="hover:bg-surface-200/50">
            <td class="py-3 px-4 font-bold text-white">Spazio Necessario su Disco</td>
            <td class="py-3 px-4 text-amber-400 font-semibold">PS5: {db.releaseInfo.downloadSizePS5} | Xbox: {db.releaseInfo.downloadSizeXbox}</td>
            <td class="py-3 px-4 text-xs text-gray-400">Consigliato SSD NVMe M.2 ad alte prestazioni</td>
          </tr>
          <tr class="hover:bg-surface-200/50">
            <td class="py-3 px-4 font-bold text-white">Ambientazione Principale</td>
            <td class="py-3 px-4 text-white">{db.releaseInfo.setting}</td>
            <td class="py-3 px-4 text-xs text-gray-400">6 regioni geografiche con oltre 1.200 interni</td>
          </tr>
          <tr class="hover:bg-surface-200/50">
            <td class="py-3 px-4 font-bold text-white">Protagonisti Giocabili</td>
            <td class="py-3 px-4 text-white">{db.protagonists.map(p => p.name).join(' e ')}</td>
            <td class="py-3 px-4 text-xs text-gray-400">Sodalizio criminale a due vie ispirato a Bonnie &amp; Clyde</td>
          </tr>
          <tr class="hover:bg-surface-200/50">
            <td class="py-3 px-4 font-bold text-white">Inno del Launch Trailer</td>
            <td class="py-3 px-4 text-miami-cyan font-semibold">"Flower in a Hurricane"</td>
            <td class="py-3 px-4 text-xs text-gray-400">Justice ft. Tame Impala, SZA &amp; King Gizzard</td>
          </tr>
        </tbody>
      </table>
    </div>

    <!-- 3 Quick Pillar Cards -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="p-5 rounded-2xl bg-surface-100 border border-surface-200">
        <div class="w-10 h-10 rounded-xl bg-miami-pink/20 text-miami-pink flex items-center justify-center font-black mb-3 font-mono">
          01
        </div>
        <h3 class="text-base font-bold text-white mb-2">Pre-Load Già Disponibile</h3>
        <p class="text-xs text-gray-300 leading-relaxed">
          Tutti i giocatori che hanno effettuato il pre-order digitale su console possono già scaricare i 228.5 GB di dati per iniziare a giocare all'istante allo scoccare della mezzanotte.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-100 border border-surface-200">
        <div class="w-10 h-10 rounded-xl bg-miami-orange/20 text-miami-orange flex items-center justify-center font-black mb-3 font-mono">
          02
        </div>
        <h3 class="text-base font-bold text-white mb-2">Leonida 2.5x più Grande</h3>
        <p class="text-xs text-gray-300 leading-relaxed">
          La mappa più vasta e dettagliata mai creata da Rockstar: spiagge affollate con IA neurale, paludi infestate da predatori e oltre 1.200 interni senza alcuna schermata di caricamento.
        </p>
      </div>

      <div class="p-5 rounded-2xl bg-surface-100 border border-surface-200">
        <div class="w-10 h-10 rounded-xl bg-miami-cyan/20 text-miami-cyan flex items-center justify-center font-black mb-3 font-mono">
          03
        </div>
        <h3 class="text-base font-bold text-white mb-2">Grafica RAGE 9 &amp; PS5 Pro</h3>
        <p class="text-xs text-gray-300 leading-relaxed">
          Global Illumination in Ray Tracing in tempo reale, simulazione idrodinamica avanzata per le onde dell'oceano e supporto PSSR a 60 FPS in 4K su PlayStation 5 Pro.
        </p>
      </div>
    </div>
  </section>

  <!-- Interactive Storage Calculator Micro-Tool -->
  <StorageCalculator />

  <!-- Official Video Showcase Section -->
  <section class="my-14">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs font-bold text-miami-pink uppercase tracking-widest mb-1 font-mono">Archivio Ufficiale Rockstar</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Trailer e Showcase Ufficiali</h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-1">Player protetto in modalità youtube-nocookie.com (Zero Cookie di terze parti all'avvio).</p>
      </div>
      <a
        href="/trailers/trailer-1"
        class="inline-flex items-center gap-2 text-xs font-bold text-miami-cyan hover:text-white transition-colors"
      >
        <span>Vedi tutti i 7 video ufficiali</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {featuredTrailers.map((trailer) => (
        <div class="flex flex-col rounded-2xl bg-surface-50 border border-surface-200 overflow-hidden shadow-lg hover:border-miami-pink/40 transition-colors">
          <LiteYouTube videoId={trailer.youtubeId} title={trailer.title} duration={trailer.duration} soundtrack={trailer.soundtrack.title} />
          <div class="p-5 flex-1 flex flex-col justify-between">
            <div>
              <div class="flex items-center justify-between text-xs text-gray-400 mb-2">
                <span>{trailer.publishDateHuman}</span>
                <span class="text-miami-pink font-semibold">Video #{trailer.number}</span>
              </div>
              <h3 class="text-base font-bold text-white mb-2 line-clamp-1">{trailer.title}</h3>
              <p class="text-xs text-gray-300 line-clamp-2 mb-3 leading-relaxed">{trailer.summary}</p>
            </div>
            <div class="pt-3 border-t border-surface-200 flex items-center justify-between text-xs">
              <span class="text-gray-400 truncate max-w-[180px]">🎵 {trailer.soundtrack.title}</span>
              <a href={`/trailers/${trailer.slug}`} class="text-miami-cyan font-semibold hover:underline">Analisi Frame →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Leonida Regions Overview -->
  <section class="my-14 p-6 sm:p-10 rounded-3xl bg-surface-50 border border-surface-300 shadow-xl">
    <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
      <div>
        <div class="text-xs font-bold text-miami-cyan uppercase tracking-widest mb-1 font-mono">Geografia &amp; Lore</div>
        <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Le 6 Regioni dello Stato di Leonida</h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-1">Esplora i dettagli geografici, le fazioni e i punti di interesse confermati.</p>
      </div>
      <a href="/tracker" class="inline-flex items-center gap-2 text-xs font-bold text-miami-pink hover:text-white transition-colors">
        <span>Apri Tracker 100% Leonida</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {db.locations.map((region) => (
        <a
          href={`/leonida/${region.slug}`}
          class="group p-5 rounded-2xl bg-surface-100 border border-surface-200 hover:border-miami-cyan/60 hover:shadow-neon-cyan transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between text-xs text-miami-cyan font-mono mb-2">
              <span>{region.category}</span>
              <span>{region.subLocations.length} Luoghi</span>
            </div>
            <h3 class="text-lg font-bold text-white group-hover:text-miami-cyan transition-colors mb-2">
              {region.name}
            </h3>
            <p class="text-xs text-gray-300 line-clamp-3 leading-relaxed mb-4">
              {region.description}
            </p>
          </div>
          <div class="pt-3 border-t border-surface-200 flex items-center justify-between text-xs">
            <span class="text-gray-400">{region.collectibles.length} Collezionabili</span>
            <span class="text-miami-pink font-semibold group-hover:translate-x-1 transition-transform">Guida Regione →</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Protagonists Dossier Section -->
  <section class="my-14">
    <div class="text-center max-w-2xl mx-auto mb-10">
      <div class="text-xs font-bold text-miami-pink uppercase tracking-widest mb-1 font-mono">Dossier Personaggi</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Lucia e Jason: La Coppia Criminale</h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2">
        I due protagonisti giocabili di Grand Theft Auto VI: abilità speciali e background narrativo.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      {db.protagonists.map((char) => (
        <div class="p-6 sm:p-8 rounded-3xl bg-surface-50 border border-surface-300 shadow-xl flex flex-col justify-between relative overflow-hidden">
          <div class="absolute -right-8 -top-8 w-32 h-32 bg-miami-pink/10 rounded-full blur-2xl pointer-events-none"></div>

          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-xs font-bold text-miami-pink uppercase font-mono">{char.alias}</span>
              <span class="px-2.5 py-0.5 rounded-full bg-surface-200 border border-surface-300 text-[11px] text-gray-300">
                Protagonista Giocabile
              </span>
            </div>
            <h3 class="text-2xl font-black text-white mb-2">{char.name}</h3>
            <p class="text-xs text-miami-cyan font-medium mb-4">{char.role}</p>

            <p class="text-xs sm:text-sm text-gray-300 leading-relaxed mb-6">
              {char.background}
            </p>

            <!-- Abilities -->
            <div class="mb-6">
              <h4 class="text-xs font-bold uppercase tracking-wider text-white mb-2">Abilità Speciali Confermate:</h4>
              <ul class="space-y-2 text-xs text-gray-300">
                {char.specialAbilities.map((ab) => (
                  <li class="flex items-start gap-2">
                    <svg class="w-4 h-4 text-emerald-400 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
                    <span>{ab}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="pt-4 border-t border-surface-200 text-xs text-gray-400 flex items-center justify-between">
            <span>Stato: <strong class="text-emerald-400">{char.status}</strong></span>
          </div>
        </div>
      ))}
    </div>
  </section>

  <!-- Hardware Deals Affiliate Section -->
  <section class="my-14 p-6 sm:p-10 rounded-3xl bg-gradient-to-b from-surface-100 to-surface-50 border border-miami-cyan/30 shadow-neon-cyan relative">
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-200 border border-miami-cyan/40 text-xs font-bold text-miami-cyan uppercase mb-3">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
        <span>Affiliate Hardware &amp; Pre-Order Hub</span>
      </div>
      <h2 class="text-2xl sm:text-4xl font-black text-white tracking-tight">
        Prepara la tua Console per <span class="text-miami-cyan">Leonida</span>
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2">
        I migliori accessori hardware e codici prepagati per garantire spazio sufficiente al pre-load di GTA VI (228.5 GB).
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {db.hardwareDeals.map((item) => (
        <AffiliateBox
          id={item.id}
          title={item.title}
          category={item.category}
          targetConsole={item.targetConsole}
          badge={item.badge}
          price={item.price}
          originalPrice={item.originalPrice}
          affiliateUrl={item.affiliateUrl}
          rating={item.rating}
          reviewsCount={item.reviewsCount}
          features={item.features}
          storageCapacityGb={item.storageCapacityGb}
        />
      ))}
    </div>

    <div class="mt-8 text-center text-[11px] text-gray-400">
      * I link ai prodotti contengono affiliazioni commerciali tracciate in sicurezza tramite tag <code>rel="sponsored noopener noreferrer"</code>. Acquistando supporti il portale indipendente senza alcun sovrapprezzo.
    </div>
  </section>

  <!-- FAQ Section for AI Search & Users -->
  <section class="my-14 max-w-4xl mx-auto">
    <div class="text-center mb-10">
      <div class="text-xs font-bold text-miami-cyan uppercase tracking-widest mb-1 font-mono">FAQ &amp; Assistenti AI</div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-white">Domande Frequenti su GTA 6</h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2">
        Domande e risposte strutturate con schema FAQPage per la Generative Engine Optimization (GEO).
      </p>
    </div>

    <div class="space-y-4">
      {db.releaseInfo.faq.map((item) => (
        <details class="group rounded-2xl bg-surface-50 border border-surface-200 p-5 transition-colors open:border-miami-pink/40 open:bg-surface-100/90">
          <summary class="flex items-center justify-between cursor-pointer font-bold text-base sm:text-lg text-white list-none select-none">
            <span>{item.question}</span>
            <span class="w-7 h-7 rounded-lg bg-surface-200 flex items-center justify-center text-miami-pink group-open:rotate-180 transition-transform">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </span>
          </summary>
          <div class="mt-4 pt-4 border-t border-surface-200/60 text-xs sm:text-sm text-gray-300 leading-relaxed">
            {item.answer}
          </div>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
