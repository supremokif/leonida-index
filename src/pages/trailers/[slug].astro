---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LiteYouTube from '../../components/LiteYouTube.astro';
import AdSlot from '../../components/AdSlot.astro';
import AffiliateBox from '../../components/AffiliateBox.astro';
import db from '../../data/gta6_db.json';
import type { Trailer } from '../../types/gta6';
import { resolvePath } from '../../utils/paths';

export async function getStaticPaths() {
  return db.trailers.map((trailer) => ({
    params: { slug: trailer.slug },
    props: { trailer },
  }));
}

interface Props {
  trailer: Trailer;
}

const { trailer } = Astro.props;

const currentIndex = db.trailers.findIndex((t) => t.slug === trailer.slug);
const prevTrailer = currentIndex > 0 ? db.trailers[currentIndex - 1] : null;
const nextTrailer = currentIndex < db.trailers.length - 1 ? db.trailers[currentIndex + 1] : null;

const featuredDeal = db.hardwareDeals[0];
---

<BaseLayout
  title={`${trailer.title} - Analisi Frame & Trascrizione Ufficiale | Leonida Index`}
  description={`Guarda ${trailer.title} di GTA VI in alta definizione. Analisi fotogramma per fotogramma, colonna sonora (${trailer.soundtrack.title}), veicoli avvistati e trascrizione dialoghi.`}
  canonicalPath={`/trailers/${trailer.slug}`}
  breadcrumbs={[
    { name: 'Archivio Trailer', url: '/trailers/trailer-1' },
    { name: `Video #${trailer.number}`, url: `/trailers/${trailer.slug}` },
  ]}
>
  <div class="max-w-5xl mx-auto my-6 sm:my-10">
    <!-- Top Metadata Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <div class="flex items-center gap-3">
        <span class="px-3.5 py-1.5 rounded-full bg-gradient-to-r from-vice-pink to-vice-orange text-white text-xs font-mono font-bold uppercase tracking-wider shadow-neon-pink">
          VIDEO #{trailer.number} DI 7
        </span>
        <span class="text-xs font-mono text-gray-400">
          DATA: <strong class="text-white">{trailer.publishDateHuman}</strong>
        </span>
      </div>
      <div class="flex items-center gap-3 text-xs font-mono text-gray-400">
        <span>DURATA: <strong class="text-vice-cyan">{trailer.duration}</strong></span>
        <span>•</span>
        <span>ENGINE: <strong class="text-white">RAGE 9</strong></span>
      </div>
    </div>

    <!-- Title -->
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase mb-4 leading-tight">
      {trailer.title}
    </h1>

    <p class="text-sm sm:text-base text-gray-300 mb-8 leading-relaxed font-normal">
      {trailer.summary}
    </p>

    <!-- Lite YouTube Player Facade -->
    <div class="mb-10">
      <LiteYouTube
        videoId={trailer.youtubeId}
        title={trailer.title}
        duration={trailer.duration}
        soundtrack={trailer.soundtrack.title}
      />
    </div>

    <!-- Official Soundtrack Banner -->
    <div class="p-6 rounded-3xl bg-gradient-to-r from-[#1b1433] via-[#140f26] to-[#0e0a1a] border border-white/[0.12] mb-10 flex flex-col sm:flex-row sm:items-center justify-between gap-4 shadow-xl">
      <div>
        <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-vice-cyan block mb-1">
          COLONNA SONORA UFFICIALE
        </span>
        <h3 class="text-base sm:text-lg font-black text-white">
          "{trailer.soundtrack.title}" — <span class="text-vice-pink font-semibold">{trailer.soundtrack.artist}</span>
        </h3>
        <p class="text-xs font-mono text-gray-400 mt-1">{trailer.soundtrack.notes}</p>
      </div>
      <a
        href="https://www.youtube.com/results?search_query=GTA+VI+soundtrack"
        target="_blank"
        rel="noopener noreferrer nofollow"
        class="shrink-0 px-4 py-2.5 rounded-xl bg-[#231b42] hover:bg-[#2d2354] text-white text-xs font-mono font-bold tracking-wider uppercase border border-white/[0.1] hover:border-vice-cyan transition-all"
      >
        ASCOLTA SU YOUTUBE ↗
      </a>
    </div>

    <AdSlot id={`trailer-${trailer.slug}-slot`} format="responsive" />

    <!-- Frame-by-Frame Breakdown Table -->
    <section class="my-10 p-6 sm:p-10 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.12] shadow-2xl relative overflow-hidden" aria-label="Analisi Fotogrammi">
      <div class="mb-6">
        <span class="text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest block mb-1">TELEMETRIA SCENA PER SCENA</span>
        <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
          ANALISI DETTAGLIATA DEI FOTOGRAMMI
        </h2>
        <p class="text-xs sm:text-sm text-gray-300 mt-1 font-normal">Dettagli di gameplay, transizioni tra interni ed esterni e tecnologia RAGE 9.</p>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/[0.1] mb-6 shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm text-gray-200">
          <thead class="bg-[#1b1433] text-[11px] uppercase font-mono font-bold text-vice-cyan tracking-wider border-b border-white/[0.1]">
            <tr>
              <th scope="col" class="py-3.5 px-4 w-28">TIMESTAMP</th>
              <th scope="col" class="py-3.5 px-4 w-60">SCENA CHIAVE</th>
              <th scope="col" class="py-3.5 px-4">ANALISI TECNICA &amp; LORE</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.06] bg-[#0e0a1a]/80 font-medium">
            {trailer.frameAnalysis.map((frame) => (
              <tr class="hover:bg-white/[0.04] transition-colors">
                <td class="py-3.5 px-4 font-mono font-bold text-vice-pink text-sm">{frame.timestamp}</td>
                <td class="py-3.5 px-4 font-bold text-white">{frame.label}</td>
                <td class="py-3.5 px-4 text-xs text-gray-300 leading-relaxed font-normal">{frame.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Weapons and Vehicles Spotted -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      <div class="p-7 rounded-3xl bg-[#120d24] border border-white/[0.1] shadow-xl">
        <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-vice-cyan mb-3.5 flex items-center gap-2">
          <span>VEICOLI IDENTIFICATI ({trailer.vehiclesSpotted.length})</span>
        </h3>
        <div class="flex flex-wrap gap-2">
          {trailer.vehiclesSpotted.map((veh) => (
            <span class="px-3 py-1.5 rounded-xl bg-[#1c1438] border border-white/[0.08] text-xs font-mono text-gray-200">
              {veh}
            </span>
          ))}
        </div>
      </div>

      <div class="p-7 rounded-3xl bg-[#120d24] border border-white/[0.1] shadow-xl">
        <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-vice-pink mb-3.5 flex items-center gap-2">
          <span>ARMI ED EQUIPAGGIAMENTO ({trailer.weaponsSpotted.length})</span>
        </h3>
        <div class="flex flex-wrap gap-2">
          {trailer.weaponsSpotted.map((wep) => (
            <span class="px-3 py-1.5 rounded-xl bg-[#1c1438] border border-white/[0.08] text-xs font-mono text-gray-200">
              {wep}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Verbatim Dialogue Transcript -->
    <section class="my-10 p-7 sm:p-10 rounded-3xl bg-gradient-to-r from-[#170f2e] to-[#0e0a1a] border border-white/[0.12] shadow-2xl relative" aria-label="Trascrizione Dialoghi">
      <div class="mb-4">
        <span class="text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest block mb-1">ARCHIVIO TESTUALE ORIGINALE</span>
        <h2 class="text-xl sm:text-2xl font-black text-white uppercase tracking-tight">
          TRASCRIZIONE INTEGRALE DIALOGHI
        </h2>
      </div>
      <blockquote class="p-6 rounded-2xl bg-[#0a0714]/80 border-l-4 border-vice-pink text-xs sm:text-sm text-gray-200 leading-relaxed font-mono italic shadow-inner">
        "{trailer.transcript}"
      </blockquote>
    </section>

    <!-- Related Hardware Recommendation -->
    <div class="my-12">
      <div class="mb-4">
        <span class="text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest block mb-1">HARDWARE RACCOMANDATO</span>
        <h3 class="text-xl font-black text-white uppercase tracking-tight">PREPARA LA TUA CONSOLE AL LANCIO</h3>
      </div>
      <AffiliateBox
        id={featuredDeal.id}
        title={featuredDeal.title}
        category={featuredDeal.category}
        targetConsole={featuredDeal.targetConsole}
        badge={featuredDeal.badge}
        price={featuredDeal.price}
        originalPrice={featuredDeal.originalPrice}
        affiliateUrl={featuredDeal.affiliateUrl}
        rating={featuredDeal.rating}
        reviewsCount={featuredDeal.reviewsCount}
        features={featuredDeal.features}
        storageCapacityGb={featuredDeal.storageCapacityGb}
      />
    </div>

    <!-- Navigation between Trailers -->
    <div class="pt-8 border-t border-white/[0.1] flex items-center justify-between gap-4 font-mono text-xs">
      {prevTrailer ? (
        <a
          href={resolvePath(`/trailers/${prevTrailer.slug}`)}
          class="flex items-center gap-2.5 font-bold text-gray-300 hover:text-vice-pink transition-colors px-4 py-3 rounded-xl bg-surface-100 border border-white/[0.08]"
        >
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
          <span class="line-clamp-1">PRED: #{prevTrailer.number} {prevTrailer.title}</span>
        </a>
      ) : (
        <div class="text-gray-400">INIZIO ARCHIVIO</div>
      )}

      {nextTrailer ? (
        <a
          href={resolvePath(`/trailers/${nextTrailer.slug}`)}
          class="flex items-center gap-2.5 font-bold text-gray-300 hover:text-vice-cyan transition-colors px-4 py-3 rounded-xl bg-surface-100 border border-white/[0.08]"
        >
          <span class="line-clamp-1">SUCC: #{nextTrailer.number} {nextTrailer.title}</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </a>
      ) : (
        <a href={resolvePath('/tracker')} class="text-vice-pink font-bold hover:underline">
          TUTTI I 7 VIDEO CONSULTATI • VAI AL TRACKER ➔
        </a>
      )}
    </div>
  </div>
</BaseLayout>
