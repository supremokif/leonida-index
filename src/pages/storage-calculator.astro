---
import BaseLayout from '../layouts/BaseLayout.astro';
import StorageCalculator from '../components/StorageCalculator.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import AdSlot from '../components/AdSlot.astro';
import db from '../data/gta6_db.json';

const ssdDeals = db.hardwareDeals.filter(
  (d) => d.category === 'SSD PS5' || d.category === 'Storage Xbox' || d.category === 'Ricarica Store'
);
---

<BaseLayout
  title="Calcolatore Spazio SSD GTA 6: Il tuo disco è pronto per il Pre-load? | Leonida Index"
  description="Verifica se la memoria della tua PS5 o Xbox Series X|S è sufficiente per i 228.5 GB del pre-load di GTA VI. Guida all'espansione SSD M.2 con dissipatore e offerte verificate."
  canonicalPath="/storage-calculator"
  breadcrumbs={[{ name: 'Calcolatore Spazio SSD Console', url: '/storage-calculator' }]}
>
  <div class="max-w-4xl mx-auto text-center my-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-200 border border-miami-cyan/40 text-xs font-bold text-miami-cyan uppercase mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Pre-load Ufficiale Attivo dal 10 Novembre (228.5 GB)</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase mb-3">
      VERIFICA ARCHIVIAZIONE <span class="bg-gradient-to-r from-miami-pink via-miami-orange to-miami-cyan bg-clip-text text-transparent">CONSOLE SSD</span>
    </h1>
    <p class="text-xs sm:text-base text-gray-300 max-w-2xl mx-auto leading-relaxed">
      Il pacchetto di installazione di Grand Theft Auto VI è il più pesante mai distribuito su console. Calcola se hai abbastanza giga liberi o se devi installare un disco aggiuntivo.
    </p>
  </div>

  <AdSlot id="storage-top-banner" format="leaderboard" />

  <!-- Interactive Storage Calculator Island -->
  <StorageCalculator />

  <!-- Technical Installation Guide Section -->
  <section class="max-w-4xl mx-auto my-12 p-6 sm:p-10 rounded-3xl bg-surface-50 border border-surface-300 shadow-xl">
    <div class="mb-8">
      <span class="text-xs font-bold text-miami-cyan uppercase font-mono">Guida Tecnica Ufficiale</span>
      <h2 class="text-2xl font-bold text-white mt-1">
        Come Installare un SSD M.2 su PlayStation 5 per GTA VI
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-2">
        Specifiche richieste da Sony Interactive Entertainment per garantire tempi di caricamento istantanei a Leonida.
      </p>
    </div>

    <div class="space-y-4 text-xs sm:text-sm text-gray-300 leading-relaxed">
      <div class="p-4 rounded-xl bg-surface-100 border border-surface-200 flex items-start gap-4">
        <span class="w-8 h-8 rounded-lg bg-miami-pink text-white flex items-center justify-center font-black font-mono shrink-0">1</span>
        <div>
          <h3 class="font-bold text-white mb-1">Requisiti di Velocità e Dissipatore</h3>
          <p>
            L'SSD M.2 deve essere di tipo PCIe Gen4 x4 con velocità di lettura sequenziale raccomandata di almeno 5.500 MB/s (modelli come WD_BLACK SN850X raggiungono 7.300 MB/s). È obbligatorio un dissipatore di calore in alluminio preinstallato con spessore non superiore a 11,25 mm.
          </p>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-surface-100 border border-surface-200 flex items-start gap-4">
        <span class="w-8 h-8 rounded-lg bg-miami-cyan text-background flex items-center justify-center font-black font-mono shrink-0">2</span>
        <div>
          <h3 class="font-bold text-white mb-1">Procedura di Inserimento (3 Minuti)</h3>
          <p>
            Spegni la console, stacca tutti i cavi e rimuovi la cover laterale con il logo PlayStation rivolto verso il basso. Svita la copertura metallica dello slot di espansione con un cacciavite a croce, inserisci l'SSD con un'inclinazione di circa 30 gradi fino al click, bloccalo con la vite in dotazione e richiudi.
          </p>
        </div>
      </div>

      <div class="p-4 rounded-xl bg-surface-100 border border-surface-200 flex items-start gap-4">
        <span class="w-8 h-8 rounded-lg bg-miami-orange text-white flex items-center justify-center font-black font-mono shrink-0">3</span>
        <div>
          <h3 class="font-bold text-white mb-1">Espansione su Xbox Series X|S</h3>
          <p>
            Su console Xbox non occorre aprire la scocca: basta inserire la Seagate Storage Expansion Card direttamente nello slot dedicato 'Storage Expansion' situato sul retro della console. La formattazione è automatica in 5 secondi.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hardware Deals Grid -->
  <section class="max-w-5xl mx-auto my-12">
    <div class="text-center mb-8">
      <h2 class="text-2xl font-bold text-white">Upgrade Consigliati per il Lancio del 19 Novembre</h2>
      <p class="text-xs text-gray-400 mt-1">Dispositivi compatibili al 100% testati per i requisiti I/O di GTA VI.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {ssdDeals.map((deal) => (
        <AffiliateBox
          id={deal.id}
          title={deal.title}
          category={deal.category}
          targetConsole={deal.targetConsole}
          badge={deal.badge}
          price={deal.price}
          originalPrice={deal.originalPrice}
          affiliateUrl={deal.affiliateUrl}
          rating={deal.rating}
          reviewsCount={deal.reviewsCount}
          features={deal.features}
          storageCapacityGb={deal.storageCapacityGb}
        />
      ))}
    </div>
  </section>
</BaseLayout>
