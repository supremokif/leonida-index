---
import BaseLayout from '../layouts/BaseLayout.astro';
import StorageCalculator from '../components/StorageCalculator.astro';
import AffiliateBox from '../components/AffiliateBox.astro';
import AdSlot from '../components/AdSlot.astro';
import db from '../data/gta6_db.json';

const ssdDeals = db.hardwareDeals.filter(
  (d) => d.category === 'SSD PS5' || d.category === 'Storage Xbox' || d.category === 'Ricarica Store'
);
---

<BaseLayout
  title="Calcolatore Spazio SSD GTA 6: Il tuo disco è pronto per il Pre-load? | Leonida Index"
  description="Diagnostica hardware per PlayStation 5 e Xbox Series X|S: verifica lo spazio libero della tua console in previsione del lancio di GTA VI."
  canonicalPath="/storage-calculator"
  breadcrumbs={[{ name: 'Diagnostica Spazio SSD Console', url: '/storage-calculator' }]}
>
  <div class="max-w-4xl mx-auto text-center my-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[11px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>DIAGNOSTICA HARDWARE // REQUISITI CONSOLE NEXT-GEN</span>
    </div>
    <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight uppercase mb-4 leading-none">
      DIAGNOSTICA ARCHIVIAZIONE <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">SSD CONSOLE</span>
    </h1>
    <p class="text-xs sm:text-base text-gray-300 max-w-2xl mx-auto leading-relaxed font-normal">
      Grand Theft Auto VI è il titolo più imponente mai distribuito su console. Calcola l'impatto sul tuo drive interno ed evita blocchi dell'installazione al momento del lancio.
    </p>
  </div>

  <AdSlot id="storage-top-banner" format="leaderboard" />

  <!-- Interactive Storage Calculator Island -->
  <StorageCalculator />

  <!-- Technical Installation Guide Section -->
  <section class="max-w-5xl mx-auto my-14 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.1] shadow-2xl relative overflow-hidden">
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-vice-pink/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="mb-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">
        SPECIFICHE TECNICHE HARDWARE
      </div>
      <h2 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight">
        GUIDA ALL'INSTALLAZIONE SSD M.2 PER GTA VI
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-1 font-normal">
        Requisiti certificati da Sony Interactive Entertainment per assicurare streaming degli asset a 0 millisecondi di latenza a Leonida.
      </p>
    </div>

    <div class="space-y-4 relative z-10 text-xs sm:text-sm text-gray-300 leading-relaxed font-normal">
      <!-- Step 1 -->
      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-pink/50 transition-colors flex flex-col sm:flex-row items-start gap-4">
        <div class="px-3 py-1.5 rounded-xl bg-vice-pink text-white font-mono font-black text-xs shrink-0 tracking-wider">
          STEP 01
        </div>
        <div>
          <h3 class="font-bold text-white text-base mb-1.5">Velocità PCIe Gen4 e Dissipatore Termico Obbligatorio</h3>
          <p class="text-gray-300 leading-relaxed">
            L'SSD M.2 deve supportare lo standard PCIe 4.0 x4 con velocità di lettura sequenziale pari o superiore a 5.500 MB/s (unità come WD_BLACK SN850X raggiungono 7.300 MB/s). È fondamentale disporre di un heatsink in alluminio con altezza totale non superiore a 11,25 mm per dissipare il carico termico del motore RAGE 9.
          </p>
        </div>
      </div>

      <!-- Step 2 -->
      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-cyan/50 transition-colors flex flex-col sm:flex-row items-start gap-4">
        <div class="px-3 py-1.5 rounded-xl bg-vice-cyan text-[#07050d] font-mono font-black text-xs shrink-0 tracking-wider">
          STEP 02
        </div>
        <div>
          <h3 class="font-bold text-white text-base mb-1.5">Alloggiamento nello Slot Espansione PS5 (3 Minuti)</h3>
          <p class="text-gray-300 leading-relaxed">
            Spegni la console e stacca i cavi di alimentazione. Rimuovi la paratia inferiore con il logo rivolto verso il basso, svita lo sportellino in metallo con un cacciavite Phillips, inserisci il disco M.2 con un'angolatura di 30° fino all'aggancio, fissa la vite sul distanziatore a 80mm e richiudi la scocca.
          </p>
        </div>
      </div>

      <!-- Step 3 -->
      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-orange/50 transition-colors flex flex-col sm:flex-row items-start gap-4">
        <div class="px-3 py-1.5 rounded-xl bg-vice-orange text-white font-mono font-black text-xs shrink-0 tracking-wider">
          STEP 03
        </div>
        <div>
          <h3 class="font-bold text-white text-base mb-1.5">Plug &amp; Play su Xbox Series X|S</h3>
          <p class="text-gray-300 leading-relaxed">
            Per i giocatori Xbox non è necessario smontare nulla: basta inserire la scheda di espansione Seagate Storage Expansion Card nello slot dedicato posizionato sul retro della console. La sincronizzazione con l'architettura Xbox Velocity è istantanea.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Hardware Deals Grid -->
  <section class="max-w-5xl mx-auto my-14">
    <div class="max-w-3xl mb-8">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">
        HARDWARE TESTATO E CERTIFICATO
      </div>
      <h2 class="text-3xl sm:text-4xl font-black text-white tracking-tight uppercase">
        UPGRADE CONSIGLIATI PER IL PRE-LOAD
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-1 font-normal">
        Dispositivi I/O conformi al 100% per supportare la densità di texture e streaming di Vice City.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {ssdDeals.map((deal) => (
        <AffiliateBox
          id={deal.id}
          title={deal.title}
          category={deal.category}
          targetConsole={deal.targetConsole}
          badge={deal.badge}
          price={deal.price}
          originalPrice={deal.originalPrice}
          affiliateUrl={deal.affiliateUrl}
          rating={deal.rating}
          reviewsCount={deal.reviewsCount}
          features={deal.features}
          storageCapacityGb={deal.storageCapacityGb}
        />
      ))}
    </div>
  </section>
</BaseLayout>
