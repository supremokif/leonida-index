---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompletionTracker from '../components/CompletionTracker.astro';
import AdSlot from '../components/AdSlot.astro';
import db from '../data/gta6_db.json';

const totalCollectibles = db.locations.reduce((acc, r) => acc + r.collectibles.length, 0);
---

<BaseLayout
  title="Dossier Esplorativo & Punti di Interesse di Leonida | Leonida Index"
  description="Dossier interattivo dei punti di interesse, veicoli e ambientazioni confermati nel Trailer 1 di Grand Theft Auto VI nelle regioni dello Stato di Leonida."
  canonicalPath="/tracker"
  breadcrumbs={[{ name: 'Tracker Esplorativo Leonida', url: '/tracker' }]}
>
  <!-- Page Header -->
  <div class="max-w-4xl mx-auto text-center my-8">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[11px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
      <span>DOSSIER VERIFICATO ALLA FONTE // {totalCollectibles} ELEMENTI DOCUMENTATI</span>
    </div>
    <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight uppercase mb-4 leading-none">
      TRACKER PUNTI DI INTERESSE <span class="bg-gradient-to-r from-vice-pink via-vice-orange to-vice-cyan bg-clip-text text-transparent">LEONIDA</span>
    </h1>
    <p class="text-xs sm:text-base text-gray-300 max-w-2xl mx-auto leading-relaxed font-normal">
      Traccia in tempo reale gli scorci urbani, le autostrade oceaniche e le paludi dello Stato di Leonida documentati nel Trailer 1 ufficiale di Rockstar Games.
    </p>
  </div>

  <AdSlot id="tracker-top-banner" format="leaderboard" />

  <!-- Completion Tracker Interactive Island -->
  <CompletionTracker />

  <!-- Informative Guide on Lore and Exploration in GTA VI -->
  <section class="max-w-5xl mx-auto my-14 p-6 sm:p-12 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.1] shadow-2xl relative overflow-hidden">
    <div class="absolute -right-20 -top-20 w-80 h-80 bg-vice-cyan/15 rounded-full blur-[100px] pointer-events-none"></div>

    <div class="mb-8 relative z-10">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">
        FONTI UFFICIALI &amp; TRASPARENZA COMMUNITY
      </div>
      <h2 class="text-2xl sm:text-4xl font-black text-white uppercase tracking-tight">
        COME FUNZIONA IL DOSSIER ESPLORATIVO DI LEONIDA
      </h2>
      <p class="text-xs sm:text-sm text-gray-300 mt-1 font-normal">
        I criteri di completamento e la lista trofei definitivi saranno resi noti da Rockstar Games all'uscita del gioco.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 relative z-10 text-xs sm:text-sm text-gray-300 leading-relaxed">
      <!-- Card 1 -->
      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-cyan/50 transition-colors">
        <div class="flex items-center justify-between mb-3 text-xs font-mono font-bold text-vice-cyan uppercase tracking-wider">
          <span>PILASTRO 01</span>
          <span class="w-2 h-2 rounded-full bg-vice-cyan"></span>
        </div>
        <h3 class="font-bold text-white text-base mb-2">Campagna di Lucia e Jason</h3>
        <p class="font-normal text-xs text-gray-300 leading-relaxed">
          La narrazione di coppia è il motore di Grand Theft Auto VI: rapine a mano armata, inseguimenti e un patto di fiducia reciproca nello Stato di Leonida.
        </p>
      </div>

      <!-- Card 2 -->
      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-pink/50 transition-colors">
        <div class="flex items-center justify-between mb-3 text-xs font-mono font-bold text-vice-pink uppercase tracking-wider">
          <span>PILASTRO 02</span>
          <span class="w-2 h-2 rounded-full bg-vice-pink"></span>
        </div>
        <h3 class="font-bold text-white text-base mb-2">Cartografia Dello Stato di Leonida</h3>
        <p class="font-normal text-xs text-gray-300 leading-relaxed">
          Dalle strade illuminate dai neon di Vice Beach alle paludi di Grassrivers e agli snodi di Port Gellhorn: un mondo aperto vivo e interconnesso.
        </p>
      </div>

      <!-- Card 3 -->
      <div class="p-6 rounded-3xl bg-[#140f26]/80 border border-white/[0.08] hover:border-vice-orange/50 transition-colors">
        <div class="flex items-center justify-between mb-3 text-xs font-mono font-bold text-vice-orange uppercase tracking-wider">
          <span>PILASTRO 03</span>
          <span class="w-2 h-2 rounded-full bg-vice-orange"></span>
        </div>
        <h3 class="font-bold text-white text-base mb-2">Elementi Documentati alla Fonte</h3>
        <p class="font-normal text-xs text-gray-300 leading-relaxed">
          Tutti i {totalCollectibles} punti del tracker derivano direttamente dall'analisi delle inquadrature, veicoli e location visibili nel Trailer 1 ufficiale.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
