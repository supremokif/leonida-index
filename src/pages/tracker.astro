---
import BaseLayout from '../layouts/BaseLayout.astro';
import CompletionTracker from '../components/CompletionTracker.astro';
import AdSlot from '../components/AdSlot.astro';
import db from '../data/gta6_db.json';

const totalCollectibles = db.locations.reduce((acc, r) => acc + r.collectibles.length, 0);
---

<BaseLayout
  title="GTA VI 100% Completion Tracker - Checklist Ufficiale Leonida | Leonida Index"
  description="Traccia il tuo progresso al 100% in Grand Theft Auto VI: checklist interattiva per collezionabili, casseforti, stazioni radio e misteri nelle 6 regioni di Leonida con salvataggio locale."
  canonicalPath="/tracker"
  breadcrumbs={[{ name: '100% Tracker Leonida', url: '/tracker' }]}
>
  <!-- Page Header -->
  <div class="max-w-4xl mx-auto text-center my-6">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-surface-200 border border-miami-pink/40 text-xs font-bold text-miami-pink uppercase mb-3">
      <span class="w-2 h-2 rounded-full bg-emerald-400"></span>
      <span>Aggiornato con tutti i collezionabili confermati</span>
    </div>
    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase mb-3">
      CHECKLIST COMPLETAMENTO <span class="bg-gradient-to-r from-miami-pink via-miami-orange to-miami-cyan bg-clip-text text-transparent">100%</span>
    </h1>
    <p class="text-xs sm:text-base text-gray-300 max-w-2xl mx-auto leading-relaxed">
      Usa questo strumento per tenere traccia di ogni singolo segreto, manufatto raro, rapina secondaria e missione per sbloccare il trofeo Platino di GTA VI.
    </p>
  </div>

  <AdSlot id="tracker-top-banner" format="leaderboard" />

  <!-- Completion Tracker Interactive Island -->
  <CompletionTracker />

  <!-- Educational Guide on 100% Completion in GTA VI -->
  <section class="max-w-5xl mx-auto my-12 p-6 sm:p-10 rounded-3xl bg-surface-50 border border-surface-300 shadow-xl">
    <h2 class="text-xl sm:text-2xl font-bold text-white mb-4">
      Come Funziona il Trofeo 100% in Grand Theft Auto VI
    </h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm text-gray-300 leading-relaxed">
      <div class="p-4 rounded-xl bg-surface-100 border border-surface-200">
        <h3 class="font-bold text-miami-cyan text-sm mb-2">1. Missioni Principali &amp; Rapine</h3>
        <p>
          Completamento delle missioni di coppia con Lucia e Jason, con punteggio oro opzionale basato su precisione di tiro, tempo limite e danno minimo subito.
        </p>
      </div>
      <div class="p-4 rounded-xl bg-surface-100 border border-surface-200">
        <h3 class="font-bold text-miami-pink text-sm mb-2">2. Esplorazione delle 6 Regioni</h3>
        <p>
          Rimozione della 'fog of war' sulla mappa satellitare di Vice City, delle paludi Grassrivers, dell'arcipelago delle Keys e delle vette di Mount Kalaga.
        </p>
      </div>
      <div class="p-4 rounded-xl bg-surface-100 border border-surface-200">
        <h3 class="font-bold text-miami-orange text-sm mb-2">3. Collezionabili &amp; Attività</h3>
        <p>
          Raccolta di tutti i {totalCollectibles} reperti speciali confermati, inclusi reperti storici coloniali, cassette di sicurezza e radio contraband cassette.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
