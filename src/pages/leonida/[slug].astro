---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import db from '../../data/gta6_db.json';
import type { LocationRegion } from '../../types/gta6';

export async function getStaticPaths() {
  return db.locations.map((region) => ({
    params: { slug: region.slug },
    props: { region },
  }));
}

interface Props {
  region: LocationRegion;
}

const { region } = Astro.props;

// Other regions for internal linking
const otherRegions = db.locations.filter((r) => r.slug !== region.slug);
---

<BaseLayout
  title={`${region.name} - Mappa, Luoghi & Collezionabili GTA VI | Leonida Index`}
  description={`Guida ufficiale alla regione ${region.name} in Grand Theft Auto VI. Luoghi confermati, fazioni criminali, veicoli nativi, fauna e ${region.collectibles.length} collezionabili per il trofeo 100%.`}
  canonicalPath={`/leonida/${region.slug}`}
  breadcrumbs={[
    { name: 'Mappa Leonida', url: '/leonida/vice-city' },
    { name: region.name, url: `/leonida/${region.slug}` },
  ]}
>
  <div class="max-w-5xl mx-auto my-6">
    <!-- Top Metadata Header -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-4">
      <div class="flex items-center gap-2">
        <span class="px-3 py-1 rounded-full bg-surface-200 border border-miami-cyan/40 text-xs font-bold text-miami-cyan font-mono">
          {region.category}
        </span>
        <span class="text-xs font-mono text-gray-400">
          Coordinate: <strong class="text-white">{region.coordinates.lat.toFixed(4)}° N, {Math.abs(region.coordinates.lng).toFixed(4)}° W</strong>
        </span>
      </div>
      <a href="/tracker" class="text-xs font-bold text-miami-pink hover:underline">
        Spunta nel Tracker 100% ({region.collectibles.length} Oggetti) →
      </a>
    </div>

    <h1 class="text-3xl sm:text-5xl font-black text-white tracking-tight uppercase mb-4 leading-tight">
      {region.name}
    </h1>

    <p class="text-sm sm:text-base text-gray-300 mb-6 leading-relaxed">
      {region.description}
    </p>

    <!-- Atmosphere / Environmental Ambience -->
    <div class="p-5 rounded-2xl bg-surface-50 border border-surface-200 mb-8">
      <span class="text-[11px] font-bold uppercase tracking-wider text-miami-pink font-mono block mb-1">
        Atmosfera &amp; Ambientazione Sonora
      </span>
      <p class="text-xs sm:text-sm text-gray-200 leading-relaxed italic">
        "{region.atmosphere}"
      </p>
    </div>

    <AdSlot id={`leonida-${region.slug}-slot`} format="leaderboard" />

    <!-- Sub-Locations Table -->
    <section class="my-10 p-6 sm:p-8 rounded-3xl bg-surface-50 border border-surface-300 shadow-xl" aria-label="Luoghi di Interesse">
      <div class="mb-6">
        <span class="text-xs font-bold text-miami-cyan uppercase font-mono">Punti di Interesse Confermati</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white mt-1">
          Luoghi Esplorabili a {region.name} ({region.subLocations.length})
        </h2>
      </div>

      <div class="overflow-x-auto rounded-xl border border-surface-200">
        <table class="w-full text-left text-xs sm:text-sm text-gray-300">
          <thead class="bg-surface-200 text-xs uppercase font-bold text-white tracking-wider font-mono">
            <tr>
              <th scope="col" class="py-3 px-4 w-60">Nome Luogo</th>
              <th scope="col" class="py-3 px-4 w-44">Tipologia</th>
              <th scope="col" class="py-3 px-4">Descrizione e Attività Connesse</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-surface-200 bg-surface-100/60 font-medium">
            {region.subLocations.map((sub) => (
              <tr class="hover:bg-surface-200/50">
                <td class="py-3 px-4 font-bold text-white">{sub.name}</td>
                <td class="py-3 px-4 text-xs font-mono text-miami-cyan">{sub.type}</td>
                <td class="py-3 px-4 text-xs text-gray-300 leading-relaxed">{sub.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Factions & Law Enforcement Presence -->
    <section class="my-10">
      <div class="mb-6">
        <span class="text-xs font-bold text-miami-pink uppercase font-mono">Controllo Territoriale</span>
        <h2 class="text-xl sm:text-2xl font-bold text-white mt-1">Fazioni e Forze dell'Ordine</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {region.factions.map((faction) => {
          let badgeColor = 'text-emerald-400 border-emerald-500 bg-emerald-950/60';
          if (faction.threatLevel === 'Media') badgeColor = 'text-amber-400 border-amber-500 bg-amber-950/60';
          if (faction.threatLevel === 'Alta') badgeColor = 'text-orange-400 border-orange-500 bg-orange-950/60';
          if (faction.threatLevel === 'Estrema') badgeColor = 'text-red-400 border-red-500 bg-red-950/60';

          return (
            <div class="p-5 rounded-2xl bg-surface-50 border border-surface-200 flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[10px] font-mono font-bold px-2 py-0.5 rounded-full border ${badgeColor}`}>
                    Pericolo: {faction.threatLevel}
                  </span>
                </div>
                <h3 class="text-base font-bold text-white mb-2">{faction.name}</h3>
                <p class="text-xs text-gray-300 leading-relaxed mb-4">{faction.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Collectibles Checklist for this Region -->
    <section class="my-10 p-6 sm:p-8 rounded-3xl bg-surface-50 border border-surface-300 shadow-xl">
      <div class="flex items-center justify-between mb-6">
        <div>
          <span class="text-xs font-bold text-miami-cyan uppercase font-mono">Checklist 100% Regionale</span>
          <h2 class="text-xl sm:text-2xl font-bold text-white mt-1">
            Collezionabili e Trofei a {region.name}
          </h2>
        </div>
        <a
          href="/tracker"
          class="px-4 py-2 rounded-xl bg-gradient-to-r from-miami-pink to-miami-orange text-white text-xs font-bold shadow-neon-pink"
        >
          Apri Checklist Completa
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {region.collectibles.map((col) => (
          <div class="p-4 rounded-xl bg-surface-100 border border-surface-200 flex items-start gap-3">
            <span class="w-6 h-6 rounded-md bg-surface-200 border border-surface-300 flex items-center justify-center text-miami-pink font-bold text-xs shrink-0 mt-0.5">
              ★
            </span>
            <div>
              <div class="flex items-center gap-2">
                <h3 class="text-sm font-bold text-white">{col.name}</h3>
                <span class="text-[10px] px-2 py-0.5 rounded bg-surface-200 text-miami-cyan font-mono">{col.type}</span>
              </div>
              <p class="text-xs text-emerald-400 mt-1">Ricompensa: <span class="text-gray-300">{col.reward}</span></p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Vehicles and Wildlife Lists -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-10">
      <div class="p-6 rounded-2xl bg-surface-50 border border-surface-200">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">
          🚗 Veicoli Tipici della Regione ({region.vehiclesPresent.length})
        </h3>
        <div class="flex flex-wrap gap-2">
          {region.vehiclesPresent.map((veh) => (
            <span class="px-3 py-1 rounded-lg bg-surface-100 border border-surface-300 text-xs text-gray-200 font-medium">
              {veh}
            </span>
          ))}
        </div>
      </div>

      <div class="p-6 rounded-2xl bg-surface-50 border border-surface-200">
        <h3 class="text-sm font-bold uppercase tracking-wider text-white mb-3">
          🐊 Fauna Selvatica Autoctona ({region.wildlife.length})
        </h3>
        <div class="flex flex-wrap gap-2">
          {region.wildlife.map((beast) => (
            <span class="px-3 py-1 rounded-lg bg-surface-100 border border-surface-300 text-xs text-gray-200 font-medium">
              {beast}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Other Regions Internal Links -->
    <div class="pt-8 border-t border-surface-300">
      <h3 class="text-xs font-bold uppercase tracking-wider text-gray-400 mb-4 font-mono">
        Altre Regioni dello Stato di Leonida
      </h3>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        {otherRegions.map((other) => (
          <a
            href={`/leonida/${other.slug}`}
            class="p-3 rounded-xl bg-surface-100 hover:bg-surface-200 border border-surface-200 text-center transition-colors"
          >
            <span class="text-xs font-bold text-white block line-clamp-1">{other.name.split('&')[0].trim()}</span>
            <span class="text-[10px] text-gray-400">{other.category}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
