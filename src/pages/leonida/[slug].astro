---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AdSlot from '../../components/AdSlot.astro';
import db from '../../data/gta6_db.json';
import type { LocationRegion } from '../../types/gta6';
import { resolvePath } from '../../utils/paths';

export async function getStaticPaths() {
  return db.locations.map((region) => ({
    params: { slug: region.slug },
    props: { region },
  }));
}

interface Props {
  region: LocationRegion;
}

const { region } = Astro.props;

// Other regions for internal linking
const otherRegions = db.locations.filter((r) => r.slug !== region.slug);

const regionImages: Record<string, string> = {
  'vice-city': '/images/vice-city-downtown.jpg',
  'leonida-keys': '/images/leonida-keys.jpg',
  'grassrivers': '/images/grassrivers.jpg',
  'port-gellhorn': '/images/port-gellhorn.jpg',
  'ambrosia': '/images/grotti-cheetah.jpg',
};
const heroPhoto = regionImages[region.slug] || '/images/vice-ocean-drive.jpg';
---

<BaseLayout
  title={`${region.name} - Mappa, Luoghi & Punti di Interesse GTA VI | Leonida Index`}
  description={`Dossier e cartografia di ${region.name} in Grand Theft Auto VI: ambientazioni, corpi di polizia, veicoli e ${region.collectibles.length} punti di interesse documentati nel Trailer 1.`}
  canonicalPath={`/leonida/${region.slug}`}
  breadcrumbs={[
    { name: 'Cartografia Leonida', url: '/leonida/vice-city' },
    { name: region.name, url: `/leonida/${region.slug}` },
  ]}
>
  <div class="max-w-5xl mx-auto my-8">
    <!-- Top Telemetry Bar -->
    <div class="flex flex-wrap items-center justify-between gap-4 mb-6 pb-4 border-b border-white/[0.08]">
      <div class="flex items-center gap-3">
        <span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#1b1433] border border-amber-400/40 text-[11px] font-mono font-bold text-amber-400 uppercase tracking-wider">
          <span class="w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse"></span>
          {region.category}
        </span>
        <span class="text-xs font-mono text-gray-400">
          GPS: <strong class="text-white">{region.coordinates.lat.toFixed(4)}° N, {Math.abs(region.coordinates.lng).toFixed(4)}° W</strong>
        </span>
      </div>
      <a
        href={resolvePath('/tracker')}
        class="inline-flex items-center gap-2 text-xs font-mono font-bold text-amber-400 hover:text-white transition-colors"
      >
        <span>CHECKLIST REGIONALE ({region.collectibles.length} TARGET)</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/></svg>
      </a>
    </div>

    <!-- Hero Title Block with Real Photographic Backdrop -->
    <div class="relative mb-10 rounded-[2.5rem] bg-[#07050d] border border-white/[0.12] shadow-2xl overflow-hidden min-h-[380px] flex flex-col justify-end p-8 sm:p-14">
      <!-- Full Bleed Photo Background -->
      <div class="absolute inset-0 z-0">
        <img
          src={resolvePath(heroPhoto)}
          alt={region.name}
          class="w-full h-full object-cover opacity-45 scale-105 hover:scale-100 transition-transform duration-1000"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#07050d] via-[#07050d]/80 to-transparent"></div>
      </div>

      <div class="relative z-10 max-w-3xl">
        <div class="text-[11px] font-mono font-bold text-amber-400 uppercase tracking-widest mb-3">
          LEONIDA CARTOGRAPHY // SECTOR: {region.slug.toUpperCase()}
        </div>
        <h1 class="text-4xl sm:text-6xl font-black text-white tracking-tight uppercase mb-4 leading-none drop-shadow-xl">
          {region.name}
        </h1>
        <p class="text-sm sm:text-base text-gray-200 leading-relaxed font-normal drop-shadow">
          {region.description}
        </p>

        <!-- Radio Atmosphere Audio Log Wiretap -->
        <div class="mt-6 p-4 rounded-2xl bg-[#090614]/90 border border-white/[0.1] backdrop-blur-md flex items-start gap-3.5">
          <div class="w-8 h-8 rounded-xl bg-amber-400/20 border border-amber-400/40 flex items-center justify-center text-amber-400 shrink-0 mt-0.5">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
          </div>
          <div>
            <span class="text-[10px] font-mono font-bold uppercase tracking-widest text-amber-400 block mb-0.5">
              INTERCETTAZIONE AMBIENTALE // RADIO &amp; SOUNDSCAPE
            </span>
            <p class="text-xs text-gray-300 italic leading-relaxed">
              "{region.atmosphere}"
            </p>
          </div>
        </div>
      </div>
    </div>

    <AdSlot id={`leonida-${region.slug}-slot`} format="leaderboard" />

    <!-- Sub-Locations Interactive Table -->
    <section class="my-12 p-6 sm:p-10 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.1] shadow-2xl relative" aria-label="Luoghi di Interesse">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">
            PUNTI DI INTERESSE CONFERMATI
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            ZONE ESPLORABILI A {region.name} ({region.subLocations.length})
          </h2>
        </div>
        <span class="text-xs font-mono text-gray-400">Dettagli e ambientazioni documentati nel Trailer 1</span>
      </div>

      <div class="overflow-x-auto rounded-2xl border border-white/[0.1] shadow-xl">
        <table class="w-full text-left text-xs sm:text-sm text-gray-200">
          <thead class="bg-[#1b1433] text-[11px] uppercase font-mono font-bold text-vice-cyan tracking-wider border-b border-white/[0.1]">
            <tr>
              <th scope="col" class="py-3.5 px-4 sm:px-6 w-56">NOME LUOGO</th>
              <th scope="col" class="py-3.5 px-4 w-36">TIPOLOGIA</th>
              <th scope="col" class="py-3.5 px-4 sm:px-6">ATTIVITÀ &amp; SPECIFICHE</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-white/[0.06] bg-[#0e0a1a]/80 font-medium">
            {region.subLocations.map((sub) => (
              <tr class="hover:bg-white/[0.04] transition-colors">
                <td class="py-3.5 px-4 sm:px-6 font-bold text-white flex items-center gap-2">
                  <span class="w-1.5 h-1.5 rounded-full bg-vice-cyan"></span>
                  {sub.name}
                </td>
                <td class="py-3.5 px-4 text-xs font-mono text-vice-pink">{sub.type}</td>
                <td class="py-3.5 px-4 sm:px-6 text-xs text-gray-300 leading-relaxed font-normal">{sub.description}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>

    <!-- Factions & Law Enforcement Presence -->
    <section class="my-12">
      <div class="mb-6">
        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-pink/40 text-[10px] font-mono font-bold text-vice-pink uppercase tracking-widest mb-2">
          CONTROLLO CRIMINALE &amp; FORZE DELL'ORDINE
        </div>
        <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">FAZIONI E LIVELLI DI MINACCIA</h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {region.factions.map((faction) => {
          let badgeBorder = 'border-emerald-500/50 bg-emerald-950/40 text-emerald-400';
          if (faction.threatLevel === 'Media') badgeBorder = 'border-amber-500/50 bg-amber-950/40 text-amber-400';
          if (faction.threatLevel === 'Alta') badgeBorder = 'border-orange-500/50 bg-orange-950/40 text-orange-400';
          if (faction.threatLevel === 'Estrema') badgeBorder = 'border-red-500/50 bg-red-950/40 text-red-400';

          return (
            <div class="p-6 rounded-3xl bg-[#120d24] border border-white/[0.1] hover:border-vice-pink/40 transition-colors flex flex-col justify-between">
              <div>
                <div class="flex items-center justify-between gap-2 mb-3">
                  <span class={`text-[10px] font-mono font-bold px-2.5 py-0.5 rounded-full border ${badgeBorder}`}>
                    MINACCIA: {faction.threatLevel.toUpperCase()}
                  </span>
                  <span class="text-[10px] font-mono text-gray-500">INTEL CONFIDENTIAL</span>
                </div>
                <h3 class="text-base font-bold text-white mb-2">{faction.name}</h3>
                <p class="text-xs text-gray-300 leading-relaxed font-normal mb-4">{faction.description}</p>
              </div>
            </div>
          );
        })}
      </div>
    </section>

    <!-- Collectibles Checklist for this Region -->
    <section class="my-12 p-6 sm:p-10 rounded-[2.5rem] bg-gradient-to-b from-[#151026] via-[#0d0a1a] to-[#07050d] border border-white/[0.1] shadow-2xl">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 mb-6">
        <div>
          <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-[#1b1433] border border-vice-cyan/40 text-[10px] font-mono font-bold text-vice-cyan uppercase tracking-widest mb-2">
            TARGET PER IL TROFEO PLATINO
          </div>
          <h2 class="text-2xl sm:text-3xl font-black text-white uppercase tracking-tight">
            COLLEZIONABILI A {region.name} ({region.collectibles.length})
          </h2>
        </div>
        <a
          href={resolvePath('/tracker')}
          class="inline-flex items-center justify-center px-5 py-2.5 rounded-xl bg-gradient-to-r from-vice-pink to-vice-orange text-white text-xs font-mono font-bold shadow-neon-pink hover:scale-105 transition-transform"
        >
          APRI TRACKER GLOBALE 100%
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {region.collectibles.map((col) => (
          <div class="p-4 rounded-2xl bg-[#0e0a1a] border border-white/[0.08] hover:border-vice-pink/40 transition-colors flex items-start gap-3.5">
            <span class="w-7 h-7 rounded-lg bg-[#1b1433] border border-vice-pink/40 flex items-center justify-center text-vice-pink font-bold text-xs shrink-0 mt-0.5">
              ★
            </span>
            <div class="flex-1">
              <div class="flex items-center justify-between gap-2">
                <h3 class="text-sm font-bold text-white">{col.name}</h3>
                <span class="text-[10px] px-2 py-0.5 rounded-md bg-[#181130] text-vice-cyan font-mono border border-white/[0.08]">
                  {col.type}
                </span>
              </div>
              <p class="text-xs text-emerald-400 mt-1 font-mono">
                Stato: <span class="text-gray-300 font-sans">{col.reward}</span>
              </p>
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- Vehicles and Wildlife Lists (Zero Emoji AI Cliché, Sleek High-End Layout) -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 my-12">
      <!-- Vehicles -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[#120d24] border border-white/[0.1]">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-xl bg-vice-cyan/20 border border-vice-cyan/40 flex items-center justify-center text-vice-cyan shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-white">
              VEICOLI CARATTERISTICI ({region.vehiclesPresent.length})
            </h3>
            <span class="text-[10px] font-mono text-gray-400">Modelli documentati nel Trailer 1</span>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          {region.vehiclesPresent.map((veh) => (
            <span class="px-3 py-1.5 rounded-xl bg-[#0e0a1a] border border-white/[0.08] text-xs text-gray-200 font-mono hover:border-vice-cyan/40 transition-colors">
              {veh}
            </span>
          ))}
        </div>
      </div>

      <!-- Wildlife -->
      <div class="p-6 sm:p-8 rounded-3xl bg-[#120d24] border border-white/[0.1]">
        <div class="flex items-center gap-3 mb-4">
          <div class="w-8 h-8 rounded-xl bg-vice-orange/20 border border-vice-orange/40 flex items-center justify-center text-vice-orange shrink-0">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064"/></svg>
          </div>
          <div>
            <h3 class="text-sm font-bold uppercase tracking-wider text-white">
              FAUNA SELVATICA AUTOCTONA ({region.wildlife.length})
            </h3>
            <span class="text-[10px] font-mono text-gray-400">Ecosistema e predatori documentati</span>
          </div>
        </div>
        <div class="flex flex-wrap gap-2">
          {region.wildlife.map((beast) => (
            <span class="px-3 py-1.5 rounded-xl bg-[#0e0a1a] border border-white/[0.08] text-xs text-gray-200 font-mono hover:border-vice-orange/40 transition-colors">
              {beast}
            </span>
          ))}
        </div>
      </div>
    </div>

    <!-- Other Regions Navigation Radar -->
    <div class="pt-8 border-t border-white/[0.08]">
      <div class="flex items-center justify-between mb-4">
        <h3 class="text-xs font-mono font-bold uppercase tracking-widest text-gray-400">
          SETTORI ADIACENTI DELLO STATO DI LEONIDA
        </h3>
        <span class="text-[11px] font-mono text-vice-cyan">SELEZIONA DESTINAZIONE</span>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
        {otherRegions.map((other) => (
          <a
            href={resolvePath(`/leonida/${other.slug}`)}
            class="p-4 rounded-2xl bg-[#0e0a1a] hover:bg-[#181130] border border-white/[0.08] hover:border-vice-cyan/50 text-center transition-all duration-200 group"
          >
            <span class="text-xs font-bold text-white block truncate group-hover:text-vice-cyan transition-colors">{other.name.split('&')[0].trim()}</span>
            <span class="text-[10px] font-mono text-gray-400 mt-0.5 block">{other.category}</span>
          </a>
        ))}
      </div>
    </div>
  </div>
</BaseLayout>
